/*
 * [S87] IFB Core cluster (Institut Français de Bioinformatique) — slurm.
 * Translated from nf-core/configs conf/ifb_core.config. nf-core-only
 * knobs (config_profile_*, igenomes_ignore) are dropped.
 *
 * Run with e.g. `-profile ifb_core,singularity` (the profile implies
 * slurm). Pass --slurm_account on the CLI / in -c site.config if needed.
 */

params {
    // Largest node IFB Core offers.
    max_cpus   = 56
    max_memory = 252.GB
    max_time   = 720.h
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // Route by wall-time: short jobs to `fast`, longer jobs to `long`.
    queue = { task.time <= 24.h ? 'fast' : 'long' }
}

singularity {
    autoMounts = true
    runOptions = '-B /shared'
}
apptainer {
    autoMounts = true
    runOptions = '-B /shared'
}
