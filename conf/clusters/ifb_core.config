/*
 * [S87] IFB Core cluster (Institut Français de Bioinformatique) — slurm.
 * Values confirmed on the cluster (scontrol/sacctmgr/module, 2026-06-22).
 * The nf-core/configs entry was badly stale (56 cpu / 252 GB); the CPU
 * partitions actually scale to 256-core, ~2 TiB nodes:
 *   - fast (default): MaxTime 1 d; nodes from 56c/256 GB up to 256c/~2 TiB
 *   - long          : MaxTime 30 d; same node pool
 *   - bigmem        : MaxTime 60 d, but its nodes are also ~2 TiB, so it
 *                     offers no extra memory over fast/long — not routed
 *                     to here (it also needs a separate QoS).
 *
 * Run with e.g. `-profile ifb_core,singularity` (the profile implies
 * slurm). singularity and apptainer are both on PATH; tool modules
 * (VSEARCH, swarm, Cutadapt, mumu) are also present, so
 * `-profile ifb_core,modules` works too. Partitions are AllowAccounts=ALL,
 * so --slurm_account is optional (pass your project, e.g. eukbank, for
 * accounting).
 */

params {
    // Ceiling = the largest CPU node (256 cores, ~2 TiB; 2051741 MB usable,
    // stay just under it). max_time = the `long` partition limit (30 d);
    // our tiers never approach it but it allows the queue selector to
    // route a long job there.
    max_cpus   = 256
    max_memory = 2000.GB
    max_time   = 720.h
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // Route by wall-time: short jobs to `fast` (1 d limit), longer jobs to
    // `long` (30 d). The big-memory nodes live in both, so memory needs no
    // separate partition.
    queue = { task.time <= 24.h ? 'fast' : 'long' }
}

singularity {
    autoMounts = true
    runOptions = '-B /shared'
}
apptainer {
    autoMounts = true
    runOptions = '-B /shared'
}
