/*
 * [S87] Genotoul (INRAE, Toulouse) — slurm.
 * Translated from nf-core/configs conf/genotoul.config, with the recent
 * site policy change folded in (see the wall-time note below). nf-core-only
 * knobs (config_profile_*, igenomes_ignore, save_reference) are dropped.
 *
 * Run with e.g. `-profile genotoul,singularity` (the profile implies
 * slurm). Pass --slurm_account on the CLI / in -c site.config if needed.
 */

params {
    // Largest node Genotoul offers.
    max_cpus   = 48
    max_memory = 3500.GB
    max_time   = 30.d

    // Genotoul reduced the *default* per-job wall-time from 96 h to 2 h
    // (to stop SLURM reserving resources for jobs that never use them).
    // This pipeline is unaffected: conf/slurm.config sets an explicit
    // `time` directive on every process tier, so Nextflow always submits
    // with `--time=<requested>` and never inherits the 2 h default. The
    // queue selector below keeps jobs on the default `workq` partition as
    // long as they request <= 96 h (our tiers top out well under that even
    // after retry escalation); only an explicit > 96 h request would route
    // to `unlimitq`.
    //
    // The site also asks pipeline users to cap concurrent submissions so
    // one run does not exhaust its CPU quota and block the queue. Default
    // to a gentler 50 in-flight jobs here (override with --slurm_queue_size).
    slurm_queue_size = 50
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    queue = { task.time <= 96.h ? 'workq' : 'unlimitq' }
}

executor {
    // Re-bind from the param set above (picks up 50, or a CLI override).
    queueSize = params.slurm_queue_size
}

singularity {
    autoMounts = true
    runOptions = '-B /work -B /save -B /bank -B /home -B /usr/local/bioinfo'
}
apptainer {
    autoMounts = true
    runOptions = '-B /work -B /save -B /bank -B /home -B /usr/local/bioinfo'
}
