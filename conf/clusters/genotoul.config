/*
 * [S87] Genotoul (INRAE, Toulouse) — slurm.
 * Values confirmed on the cluster (scontrol/sacctmgr/module, 2026-06-22).
 * Relevant partitions (all on the same node pool bigmem01,n[001-038]):
 *   - workq    (default): 128 cores, ~2 TiB/node (2063437 MB), MaxTime 4 d,
 *               DefaultTime 2 h. The single bigmem01 node (~4 TiB,
 *               4127818 MB) is part of workq, so big-memory jobs need no
 *               separate partition — just request the memory.
 *   - unlimitq: same nodes, MaxTime 90 d (for the rare > 4 d job).
 *
 * Containers: Genotoul provides apptainer and singularity as MODULES
 * (containers/Apptainer/1.4.1, containers/singularity/CE-4.3.1) rather
 * than on the default PATH. The engine-aware beforeScript below loads the
 * matching module so Nextflow can launch the Wave-built image, so the
 * usual container command works:
 *     -profile genotoul,apptainer    (or ,singularity)
 * `-profile genotoul,conda` / `-profile genotoul,modules` also work (the
 * profile implies slurm regardless). Tool modules present: VSEARCH/2.29.3,
 * swarm/3.1.3, Cutadapt/5.0 — but NO mumu module, so for `,modules` mumu
 * must come from elsewhere; a container (mumu is in environment.yml) or
 * conda avoids that.
 */

params {
    // Ceiling = the bigmem01 node (~4 TiB, 4127818 MB; reachable via
    // workq). Regular nodes are ~2 TiB. 128 cores per node.
    max_cpus   = 128
    max_memory = 4000.GB
    // workq MaxTime is 4 d; our heaviest tier tops out at ~24 h after
    // retries, so everything stays on workq. (A genuinely > 4 d job would
    // need --max_time raised, which the queue selector then routes to
    // unlimitq.)
    max_time   = 96.h

    // Genotoul reduced the *default* per-job wall-time to 2 h (confirmed:
    // workq DefaultTime=02:00:00) to stop SLURM reserving resources for
    // jobs that never use them. This pipeline is unaffected:
    // conf/slurm.config sets an explicit `time` on every process tier, so
    // Nextflow always submits `--time=<requested>` and never inherits the
    // 2 h default.
    //
    // The site also asks pipeline users to cap concurrent submissions so
    // one run does not exhaust its quota and block the queue. Default to a
    // gentler 50 in-flight jobs here (override with --slurm_queue_size).
    slurm_queue_size = 50
    // Submit the per-sample fan-out as slurm job arrays (the pattern the
    // Genotoul admins recommend, sbatch --array ... %N) — batches up to 50
    // ready tasks per submission instead of one sbatch each. Override or
    // disable with --slurm_array_size (null = one job per task).
    slurm_array_size = 50
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // Route by wall-time: <= 4 d stays on the default workq, longer jobs
    // go to unlimitq (90 d).
    queue = { task.time <= 96.h ? 'workq' : 'unlimitq' }

    // Re-bind the job-array size from the param set above (picks up 50, or
    // a CLI --slurm_array_size override): conf/slurm.config already read
    // params.slurm_array_size at its own parse time, before this profile
    // set the genotoul default.
    array = params.slurm_array_size

    // Load the container engine's module (when one is in use) so its
    // binary is on PATH for the host-side container launch. No-op for
    // conda / modules / bare runs.
    beforeScript = {
        if (workflow.containerEngine == 'apptainer') {
            'module load containers/Apptainer/1.4.1'
        } else if (workflow.containerEngine == 'singularity') {
            'module load containers/singularity/CE-4.3.1'
        } else {
            null
        }
    }
}

executor {
    // Re-bind from the param set above (picks up 50, or a CLI override).
    queueSize = params.slurm_queue_size
}

// Engine binds use DOTTED assignment, never a `singularity { }` block — a
// block here silently disables the engine on Nextflow 25.10.x (see
// conf/clusters/_template.config). [S87]
singularity.autoMounts = true
singularity.runOptions = '-B /work -B /save'
// Build the Wave .sif once and reuse it; point at your own /work area:
// singularity.cacheDir = '/work/<me>/nf-metabarcoding/singularity_cache'
apptainer.autoMounts = true
apptainer.runOptions = '-B /work -B /save'
// apptainer.cacheDir = '/work/<me>/nf-metabarcoding/apptainer_cache'
