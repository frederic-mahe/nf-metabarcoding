/*
 * [S87] Saga (Sigma2 / NRIS, Norway) — slurm.
 * Values confirmed on the cluster (sinfo/scontrol/sacctmgr/module,
 * 2026-06-23). Partitions (all AllowAccounts=ALL, AllowQos=ALL):
 *   - normal (default): MaxTime 7 d; nodes 40 or 52 cores, 182784 MB
 *                       (~178 GiB) each.
 *   - bigmem          : MaxTime 14 d; two flavours — 28x 40-core/370688 MB
 *                       (~362 GiB) and 8x 64-core/3093723 MB (~3021 GiB,
 *                       ~2.95 TiB). slurm picks one large enough for the
 *                       request.
 *   - hugemem         : MaxTime 14 d; a SINGLE node (hugemem-8-1),
 *                       64 cores, 6184960 MB (6040 GiB, ~5.9 TiB).
 * (GPU partitions accel/a100 and the preemptible `optimist` are ignored —
 * this pipeline has no GPU steps and must not be preempted.) The earlier
 * doc-derived draft was off: normal nodes are ~178 GiB not 192, and there
 * is one hugemem node (~5.9 TiB) not two at 6 TiB. Confirm with a smoke
 * run before a large production job — partition policies change.
 *
 * Run with e.g. `-profile saga,singularity` (the profile implies slurm).
 * Both engines are on PATH (/usr/bin/singularity, /usr/bin/apptainer), so
 * `,singularity` and `,apptainer` both work. Tool modules are present
 * (VSEARCH, swarm, cutadapt) but there is NO mumu module, so for
 * `-profile saga,modules` mumu must come from elsewhere — a container
 * (mumu is in environment.yml) or conda avoids that gap.
 *
 * Saga REQUIRES a project account (format nnXXXXk, e.g. nn9999k) —
 * confirmed: an account-less `srun` is rejected with "Account
 * specification required, but not provided". It is per-user, so it is NOT
 * hardcoded here: pass it at launch and conf/slurm.config turns it into
 * --account for you:
 *     -profile saga,singularity --slurm_account nn9999k
 */

params {
    // Ceiling = the largest node Saga offers: the single hugemem node
    // (64 cores, 6184960 MB = 6040 GiB). Set max_memory just under that so
    // a maximally-clamped request can still schedule. Nextflow's GB/TB are
    // binary (GiB/TiB), which matches how slurm reports node memory. Note
    // normal nodes have only 40-52 cores, so keep --threads <= 40 unless a
    // step is heavy enough to route to bigmem/hugemem (64 cores).
    max_cpus   = 64
    max_memory = 6000.GB
    // normal = 7 d; bigmem/hugemem = 14 d. Our heaviest tier tops out at
    // ~24 h even after retry escalation, so the 7 d default-partition
    // limit is never approached — clamp there.
    max_time   = 7.d
    // Default the per-sample fan-out to slurm job arrays ([S07]); batches
    // ready tasks into one `sbatch --array`. Override/disable with
    // --slurm_array_size.
    slurm_array_size = 50
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // Saga selects the memory tier by *partition name* (not --mem), so
    // route on task.memory against the real node sizes: normal nodes hold
    // ~178 GiB (182784 MB), so anything above ~170 GB needs bigmem; bigmem
    // tops out at ~3021 GiB (3093723 MB), so anything above ~2900 GB needs
    // hugemem (6040 GiB). Thresholds sit under each cap to leave OS
    // headroom and so a routed task actually fits.
    queue = {
        if (task.memory > 2900.GB) {
            'hugemem'
        } else if (task.memory > 170.GB) {
            'bigmem'
        } else {
            'normal'
        }
    }

    // Re-bind from the param above (conf/slurm.config read slurm_array_size
    // before this profile set the default).
    array = params.slurm_array_size

    // Per-job scratch on the parallel filesystem ($SCRATCH =
    // /cluster/work/jobs/$SLURM_JOB_ID, auto-created and auto-deleted).
    // Keeps task temp I/O off the shared project area. ($LOCALSCRATCH
    // would be node-local but needs an explicit --gres=localscratch
    // request — the GRES column confirms localscratch on the nodes — so
    // $SCRATCH is the portable default.) Doc-derived: the srun probe that
    // would echo $SCRATCH needs an account, which the cluster requires, so
    // this was not empirically confirmed — verify in the smoke run.
    scratch = '$SCRATCH'
}

singularity {
    autoMounts = true
    // home / work / projects all live under /cluster — a single beegfs
    // mount (confirmed via findmnt; the /cluster/backup/* nfs4 mounts are
    // just backups), so one bind exposes inputs, references and the work
    // dir to the container.
    runOptions = '-B /cluster'
    // Build the Wave .sif once and reuse it across nodes. Point this at a
    // PERSISTENT project area (/cluster/projects/<nnXXXXk>/...): $USERWORK
    // (/cluster/work/users/$USER) is auto-purged after 21-42 days.
    // cacheDir = '/cluster/projects/nnXXXXk/nf-metabarcoding/singularity_cache'
}
apptainer {
    autoMounts = true
    runOptions = '-B /cluster'
    // cacheDir = '/cluster/projects/nnXXXXk/nf-metabarcoding/apptainer_cache'
}
