/*
 * [S87] Saga (Sigma2 / NRIS, Norway) — slurm.
 *
 * ╔══════════════════════════════════════════════════════════════════╗
 * ║ BEST-EFFORT DRAFT — every value marked `TODO confirm` below is     ║
 * ║ from general NRIS knowledge, NOT verified against the live         ║
 * ║ cluster. Confirm each against https://documentation.sigma2.no/     ║
 * ║ (or with the discovery commands in the README) before relying on   ║
 * ║ this profile for production runs.                                  ║
 * ╚══════════════════════════════════════════════════════════════════╝
 *
 * Run with e.g. `-profile saga,singularity` (the profile implies slurm).
 *
 * Saga REQUIRES a project account (format nnXXXXk, e.g. nn9999k). It is
 * NOT hardcoded here (it is per-user): pass it on the CLI or in a
 * -c site.config and conf/slurm.config turns it into --account for you:
 *     -profile saga,singularity --slurm_account nn9999k
 */

params {
    // Ceiling = the largest (big-memory) node. TODO confirm: Saga's
    // hugemem nodes (~3 TB); standard `normal` nodes are ~40 cores /
    // ~186 GiB. Set cpus to the largest core count a single node offers.
    max_cpus   = 40      // TODO confirm (normal = 40; some nodes differ)
    max_memory = 3000.GB // TODO confirm (hugemem ~3 TB)
    max_time   = 168.h   // TODO confirm (normal/bigmem max wall-time, ~7 d)
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // TODO confirm the partition names and the memory cutoff. Saga's
    // usual partitions: `normal` (default), `bigmem`, `accel` (GPU,
    // unused here), `optimist` (preemptible). Route big-memory tasks to
    // `bigmem`, everything else to `normal`.
    queue = { task.memory > 186.GB ? 'bigmem' : 'normal' }

    // Account routing is left to conf/slurm.config (--account=<slurm_account>);
    // Saga needs --slurm_account nnXXXXk at launch (see header).

    // TODO confirm: per-job node-local scratch. NRIS exposes a local
    // scratch path inside an allocation; using it keeps heavy temp I/O
    // off the shared filesystem. Uncomment once confirmed:
    // scratch = '$LOCALSCRATCH'
}

singularity {
    autoMounts = true
    // TODO confirm the site bind mounts + a shared image cache on
    // /cluster so the Wave-built .sif is built once and reused:
    // runOptions = '-B /cluster'
    // cacheDir   = '/cluster/work/users/<me>/nf-metabarcoding/singularity_cache'
}
apptainer {
    autoMounts = true
    // runOptions = '-B /cluster'
    // cacheDir   = '/cluster/work/users/<me>/nf-metabarcoding/apptainer_cache'
}
