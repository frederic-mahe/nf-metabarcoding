/*
 * [S87] Saga (Sigma2 / NRIS, Norway) — slurm.
 * Hardware and scheduler values from the official docs:
 *   https://documentation.sigma2.no/hpc_machines/saga.html
 *   https://documentation.sigma2.no/jobs/choosing_job_types.html
 *   https://documentation.sigma2.no/files_storage/clusters.html
 * (read 2026-06-22). Confirm with a smoke run before a large production
 * job — partition policies change.
 *
 * Run with e.g. `-profile saga,singularity` (the profile implies slurm).
 *
 * Saga REQUIRES a project account (format nnXXXXk, e.g. nn9999k). It is
 * per-user, so it is NOT hardcoded here: pass it at launch and
 * conf/slurm.config turns it into --account for you:
 *     -profile saga,singularity --slurm_account nn9999k
 */

params {
    // Ceiling = the largest node Saga offers: the hugemem nodes
    // (2x, 64 cores, 6 TiB). Nextflow's GB/TB are binary (GiB/TiB), which
    // matches how Saga reports node memory. Note normal nodes have only
    // 40-52 cores, so keep --threads <= 40 unless a step is heavy enough
    // to route to bigmem/hugemem (64 cores).
    max_cpus   = 64
    max_memory = 6.TB
    // normal = 7 d; bigmem/hugemem = 14 d. Our heaviest tier tops out at
    // ~24 h even after retry escalation, so the 7 d default-partition
    // limit is never approached — clamp there.
    max_time   = 7.d
    // Default the per-sample fan-out to slurm job arrays ([S07]); batches
    // ready tasks into one `sbatch --array`. Override/disable with
    // --slurm_array_size.
    slurm_array_size = 50
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // Saga selects the memory tier by *partition name* (not --mem), so
    // route on task.memory: standard nodes are 192 GiB (request <= 180 GB
    // to leave OS headroom -> normal), 3 TiB -> bigmem, 6 TiB -> hugemem.
    queue = {
        if (task.memory > 3.TB) {
            'hugemem'
        } else if (task.memory > 180.GB) {
            'bigmem'
        } else {
            'normal'
        }
    }

    // Re-bind from the param above (conf/slurm.config read slurm_array_size
    // before this profile set the default).
    array = params.slurm_array_size

    // Per-job scratch on the parallel filesystem ($SCRATCH =
    // /cluster/work/jobs/$SLURM_JOB_ID, auto-created and auto-deleted).
    // Keeps task temp I/O off the shared project area. ($LOCALSCRATCH
    // would be node-local but needs an explicit --gres=localscratch
    // request, so $SCRATCH is the portable default.)
    scratch = '$SCRATCH'
}

singularity {
    autoMounts = true
    // All of home / work / projects live under /cluster, so one bind
    // exposes inputs, references and the work dir to the container.
    runOptions = '-B /cluster'
    // Build the Wave .sif once and reuse it across nodes. Point this at a
    // PERSISTENT project area (/cluster/projects/<nnXXXXk>/...): $USERWORK
    // (/cluster/work/users/$USER) is auto-purged after 21-42 days.
    // cacheDir = '/cluster/projects/nnXXXXk/nf-metabarcoding/singularity_cache'
}
apptainer {
    autoMounts = true
    runOptions = '-B /cluster'
    // cacheDir = '/cluster/projects/nnXXXXk/nf-metabarcoding/apptainer_cache'
}
