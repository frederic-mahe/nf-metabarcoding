/*
 * [S87] Institutional cluster profile TEMPLATE.
 *
 * Copy this file to conf/clusters/<name>.config, fill in the values for
 * your site, then register it as a profile in nextflow.config:
 *
 *     profiles {
 *         <name> {
 *             includeConfig 'conf/slurm.config'            // [S07] executor + tiers
 *             includeConfig 'conf/clusters/<name>.config'  // this file's overrides
 *         }
 *     }
 *
 * A cluster profile *implies* slurm (it includes conf/slurm.config), so a
 * user runs e.g. `-profile <name>,singularity` — they never list `slurm`.
 *
 * Only override what is genuinely site-specific. The resource *tiers*
 * (per-process cpus/memory/time, the dataset/reference scaling, the retry
 * escalation) all live in conf/slurm.config and are reused as-is; a
 * cluster file just retargets the executor at the site (partitions,
 * accounts, the node-size ceiling, container bind mounts and cache).
 *
 * Do NOT copy nf-core-isms here (igenomes_base, config_profile_*,
 * save_reference, schema_ignore_params): this pipeline does not use them.
 */

params {
    // resourceLimits ceiling — set to the LARGEST node the site offers, so
    // the per-retry escalation in conf/slurm.config is clamped to what
    // actually exists instead of looping to failure ([S07]). Units follow
    // the existing slurm profile: unquoted Nextflow MemoryUnit / Duration.
    max_cpus   = 16
    max_memory = 128.GB
    max_time   = 240.h
}

process {
    // Rebuild the ceiling from the params just set above (evaluated in
    // file order, so it picks up this file's values rather than the
    // slurm.config defaults).
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // Partition / queue selection. conf/slurm.config leaves this at
    // params.slurm_queue (null). Most sites route by task size — pick the
    // partition from task.memory and/or task.time. Example:
    // queue = { task.memory <= 250.GB ? (task.time <= 24.h ? 'fast' : 'long') : 'bigmem' }

    // Account / extra sbatch flags. conf/slurm.config already builds
    // `--account=${params.slurm_account}` (+ params.slurm_clusterOptions)
    // for you, so override this ONLY when the site derives the account
    // from the job's size/time (see conf/clusters/meso.config). Otherwise
    // leave it out and pass --slurm_account on the CLI / in -c site.config.
}

// Container engine plumbing. The engine itself (enabled + Wave + conda) is
// turned on by the dependency profile the user adds, e.g.
// `-profile <name>,singularity`; here we only add the site's bind mounts
// and a shared image cache so the Wave-built .sif is built once and
// reused across compute nodes.
// singularity {
//     autoMounts = true
//     runOptions = '-B /shared'
//     cacheDir   = '/shared/.../singularity_cache'
// }
// apptainer {
//     autoMounts = true
//     runOptions = '-B /shared'
//     cacheDir   = '/shared/.../apptainer_cache'
// }
