/*
 * [S87] ABiMS (Station Biologique de Roscoff) — slurm.
 * Values confirmed on the cluster (scontrol/sacctmgr/module, 2026-06-22).
 * The nf-core/configs entry was stale (200 cpu / 750 GB, and a 250 GB
 * bigmem cutoff). Real partitions (all AllowAccounts=ALL):
 *   - fast (default): MaxTime 1 d; big nodes 512 cores / ~1.5 TiB
 *                     (1500000 MB)
 *   - long          : MaxTime 30 d; same big nodes
 *   - bigmem        : MaxTime 60 d; ~2 TiB nodes (2064000 MB, 128 cores) —
 *                     genuinely more memory than fast/long, so memory-heavy
 *                     tasks ARE routed here.
 *
 * Run with e.g. `-profile abims,singularity` (the profile implies slurm).
 * singularity and apptainer are both on PATH; tool modules (VSEARCH,
 * swarm, Cutadapt, mumu) are also present, so `-profile abims,modules`
 * works too. Although the partitions are AllowAccounts=ALL, every job
 * must be charged to a project, so this profile REQUIRES --slurm_account
 * ([S92], require_slurm_account below): pass your project, e.g.
 * `--slurm_account jedi_meta`. A run without it aborts at startup rather
 * than letting every sbatch be rejected mid-run.
 */

params {
    // Ceiling: the bigmem node holds the most memory (~2 TiB; 2064000 MB,
    // stay under it) while fast/long nodes hold the most cores (512). The
    // single global ceiling takes the max of each. NB bigmem nodes have
    // only 128 cores, so keep --threads <= 128 if a step is large enough
    // to route there.
    max_cpus   = 512
    max_memory = 2000.GB
    // long partition limit (30 d); our tiers never approach it.
    max_time   = 720.h
    // Default the per-sample fan-out to slurm job arrays ([S07]); batches
    // ready tasks into one `sbatch --array`. Override/disable with
    // --slurm_array_size.
    slurm_array_size = 50
    // [S92]: ABiMS charges every job to a project, so require --slurm_account
    // (the entry workflow aborts at startup when it is unset).
    require_slurm_account = true
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // fast/long nodes top out at ~1.5 TiB, so a task needing more only
    // fits on bigmem (~2 TiB); route at 1400 GB to leave headroom.
    // Otherwise pick fast (<= 1 d) vs long by wall-time.
    queue = { task.memory > 1400.GB ? 'bigmem' : (task.time <= 24.h ? 'fast' : 'long') }

    // Re-bind from the param above (conf/slurm.config read slurm_array_size
    // before this profile set the default).
    array = params.slurm_array_size
}

// Engine binds use DOTTED assignment, never a `singularity { }` block — a
// block here silently disables the engine on Nextflow 25.10.x (see
// conf/clusters/_template.config). [S87]
singularity.autoMounts = true
// /shared is the main shared tree (home/projects/software/bank). If
// your data or work dir live elsewhere (e.g. /scratch2, /projet/...),
// add those roots too.
singularity.runOptions = '-B /shared'
// Build the Wave .sif once and reuse it; point at a WRITABLE area you
// own (/shared/software is admin-managed):
// singularity.cacheDir = '/shared/projects/<proj>/nf-metabarcoding/singularity_cache'
apptainer.autoMounts = true
apptainer.runOptions = '-B /shared'
// apptainer.cacheDir = '/shared/projects/<proj>/nf-metabarcoding/apptainer_cache'
