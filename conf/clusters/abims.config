/*
 * [S87] ABiMS (Station Biologique de Roscoff) — slurm.
 * Translated from nf-core/configs conf/abims.config (the site values:
 * partition routing, node ceiling, /shared bind + image cache). The
 * nf-core-only knobs (config_profile_*, igenomes_ignore) are dropped.
 *
 * Run with e.g. `-profile abims,singularity` (the profile implies slurm).
 * Pass --slurm_account on the CLI / in -c site.config if your project
 * needs one; conf/slurm.config turns it into --account automatically.
 */

params {
    // Largest node ABiMS offers (the `bigmem` partition).
    max_cpus   = 200
    max_memory = 750.GB
    max_time   = 30.d
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // Route by size: small/short -> fast, small/long -> long, big -> bigmem.
    queue = { task.memory <= 250.GB ? (task.time <= 24.h ? 'fast' : 'long') : 'bigmem' }
}

singularity {
    autoMounts = true
    runOptions = '-B /shared:/shared'
    cacheDir   = '/shared/software/singularity/images/nf-metabarcoding'
}
apptainer {
    autoMounts = true
    runOptions = '-B /shared:/shared'
    cacheDir   = '/shared/software/singularity/images/nf-metabarcoding'
}
