/*
 * [S87] meso (CIRAD HPC) — slurm.
 * Authored from the site's resource description. CIRAD's allocation:
 *   - standard nodes: 186 reservable cores + 1.5 TB RAM each
 *     (partition `cpu-dedicated`)
 *   - 2 big-memory nodes: 4 TB RAM each, 132 cores total
 *     (partition `bigmem-cirad-dedicated`)
 *   - 1 GPU node (2x A100 80 GB) — unused by this pipeline (no GPU steps)
 *
 * meso is unusual: the *account* depends on both the partition and the
 * job's wall-time. The clusterOptions closure below derives partition and
 * account from task.memory / task.time, so a user does NOT pass
 * --slurm_account here — it is computed per task. (--slurm_clusterOptions
 * is still appended for any extra site flags.)
 *
 * Run with e.g. `-profile meso,singularity` (the profile implies slurm).
 */

params {
    // Ceiling = the big-memory node (4 TB). cpus from the standard node
    // (186); our tasks only ever request params.threads, well under either
    // node's core count, so the cpu cap never routes anything.
    max_cpus   = 186
    max_memory = 4.TB
    // The site states no explicit wall-time maximum (only the 1 h / 48 h
    // account tiers below). 168 h (7 d) is a safe ceiling — our heaviest
    // tier tops out at 24 h after retries. TODO: confirm the real maximum
    // with the meso admins.
    max_time   = 168.h
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // > 1.5 TB only fits on the big-memory partition; everything else runs
    // on the standard `cpu-dedicated` partition.
    queue = { task.memory > 1536.GB ? 'bigmem-cirad-dedicated' : 'cpu-dedicated' }

    // Account follows partition + wall-time:
    //   bigmem            -> dedicated-bigmem@cirad
    //   standard, <= 1 h  -> dedicated-cpu@cirad
    //   standard, <= 48 h -> dedicated-cpu@cirad-normal   (>1 h)
    //   standard, > 48 h  -> dedicated-cpu@cirad-long
    // (Boundaries at exactly 1 h / 48 h are assigned to the lower tier.)
    clusterOptions = {
        def account
        if (task.memory > 1536.GB) {
            account = 'dedicated-bigmem@cirad'
        } else if (task.time <= 1.h) {
            account = 'dedicated-cpu@cirad'
        } else if (task.time <= 48.h) {
            account = 'dedicated-cpu@cirad-normal'
        } else {
            account = 'dedicated-cpu@cirad-long'
        }
        [ "--account=${account}", params.slurm_clusterOptions ?: null ].findAll().join(' ') ?: null
    }
}

singularity {
    autoMounts = true
    // TODO: confirm the site bind mounts / shared image cache with the
    // meso admins (e.g. -B /scratch, cacheDir on shared storage).
    // runOptions = '-B /scratch'
    // cacheDir   = '/scratch/.../singularity_cache'
}
apptainer {
    autoMounts = true
    // runOptions = '-B /scratch'
    // cacheDir   = '/scratch/.../apptainer_cache'
}
