/*
 * [S87] meso (CIRAD HPC) — slurm.
 * Values confirmed on the cluster (scontrol/sacctmgr, 2026-06-22). The
 * CIRAD-dedicated allocation:
 *   - cpu-dedicated         : 43 nodes, 192 cores, ~1.4 TiB RAM each
 *                             (1469941 MB); accounts dedicated-cpu@cirad*
 *   - bigmem-cirad-dedicated:  2 nodes,  72 cores, ~3.8 TiB RAM each
 *                             (3921387 MB); account dedicated-bigmem@cirad
 *   - gpu-cirad-dedicated   : unused by this pipeline (no GPU steps)
 *
 * meso is unusual: the *account* depends on both the partition and the
 * job's wall-time (the account MaxWall enforces the tiers — cirad = 1 h,
 * -normal = 2 d, -long = 120 d). The clusterOptions closure derives
 * partition and account from task.memory / task.time, so a user does NOT
 * pass --slurm_account here — it is computed per task.
 * (--slurm_clusterOptions is still appended for any extra site flags.)
 *
 * Run with e.g. `-profile meso,singularity` (the profile implies slurm).
 */

params {
    // Ceiling = the big-memory node: ~3.8 TiB usable (node RAM is
    // 3921387 MB; stay just under it). cpus from the standard node (186
    // reservable of 192). NB the bigmem nodes have only 72 cores, so keep
    // --threads <= 66 if a heavy step is large enough to route there; our
    // tasks request params.threads (default 4), well under either node.
    max_cpus   = 186
    max_memory = 3800.GB
    // Partition MaxTime is 90 d (DefaultTime 7 d), but the per-account
    // MaxWall is what actually bites (1 h / 48 h / 120 d, see below). Our
    // heaviest tier tops out at ~24 h after retries, so clamp at 7 d.
    max_time   = 168.h
    // Default the per-sample fan-out to slurm job arrays ([S07]); batches
    // ready tasks into one `sbatch --array`. Override/disable with
    // --slurm_array_size.
    slurm_array_size = 50
}

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    // The standard node holds ~1.4 TiB usable (1469941 MB); anything that
    // needs more only fits on the big-memory partition. Route at 1400 GB
    // to leave the standard node a little headroom.
    queue = { task.memory > 1400.GB ? 'bigmem-cirad-dedicated' : 'cpu-dedicated' }

    // Re-bind from the param above (conf/slurm.config read slurm_array_size
    // before this profile set the default).
    array = params.slurm_array_size

    // Account follows partition + wall-time (matches the account MaxWalls):
    //   bigmem            -> dedicated-bigmem@cirad
    //   standard, <= 1 h  -> dedicated-cpu@cirad          (MaxWall 1 h)
    //   standard, <= 48 h -> dedicated-cpu@cirad-normal   (>1 h; MaxWall 2 d)
    //   standard, > 48 h  -> dedicated-cpu@cirad-long     (MaxWall 120 d)
    // (Boundaries at exactly 1 h / 48 h are assigned to the lower tier.)
    clusterOptions = {
        def account
        if (task.memory > 1400.GB) {
            account = 'dedicated-bigmem@cirad'
        } else if (task.time <= 1.h) {
            account = 'dedicated-cpu@cirad'
        } else if (task.time <= 48.h) {
            account = 'dedicated-cpu@cirad-normal'
        } else {
            account = 'dedicated-cpu@cirad-long'
        }
        [ "--account=${account}", params.slurm_clusterOptions ?: null ].findAll().join(' ') ?: null
    }
}

// Engine binds use DOTTED assignment, never a `singularity { }` block — a
// block here silently disables the engine on Nextflow 25.10.x (see
// conf/clusters/_template.config). [S87]
singularity.autoMounts = true
// /scratch is the shared (wekafs) filesystem — bind it so inputs,
// references and the work dir are visible in the container.
singularity.runOptions = '-B /scratch'
// Build the Wave .sif once and reuse it across nodes; point this at
// your own shared-scratch area:
// singularity.cacheDir = '/scratch/<me>/nf-metabarcoding/singularity_cache'
apptainer.autoMounts = true
apptainer.runOptions = '-B /scratch'
// apptainer.cacheDir = '/scratch/<me>/nf-metabarcoding/apptainer_cache'
