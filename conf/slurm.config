/*
 * [S07] slurm executor profile — extracted verbatim from the inline
 * `slurm {}` profile that used to live in nextflow.config, so that the
 * institutional cluster profiles (conf/clusters/<name>.config) can reuse
 * the very same resource tiers via `includeConfig` instead of each
 * cluster re-declaring them. nextflow.config's `slurm` profile is now a
 * one-line `includeConfig 'conf/slurm.config'`, and every cluster
 * profile includes this file first, then layers its site overrides on
 * top. Behaviour for `-profile slurm` is unchanged (the config resolves
 * identically — guarded by tests/check-slurm-config.sh).
 *
 * The body below is reproduced with its original indentation so the
 * resolved `nextflow config -profile slurm` output stays byte-identical.
 */

        params.slurm_queue        = null   // sbatch -p / --partition
        params.slurm_account      = null   // sbatch -A / --account
        // [S75]: extra sbatch options appended verbatim to every job's
        // submit line (QoS, constraints, reservations, ...) — combined
        // with --account in the clusterOptions closure below. The single
        // knob a site needs for cluster-specific submission flags it
        // can't express through --slurm_account/--slurm_queue. Set it in
        // a `-c site.config` (see conf/site.config.example) or on the CLI.
        params.slurm_clusterOptions = null
        params.slurm_queue_size   = 100    // max concurrent sbatch jobs
        // [S07]: opt-in slurm job arrays. When set to N (> 1), Nextflow
        // batches up to N ready tasks of a process into a single
        // `sbatch --array` submission instead of one sbatch per task —
        // far less scheduler load for the per-sample fan-out (Part A),
        // and the pattern HPC admins ask for at scale. null (default) =
        // one job per task, unchanged behaviour. Set with --slurm_array_size
        // or via a cluster profile (genotoul defaults it to 50).
        params.slurm_array_size   = null
        // Approximate input dataset size in GB. The clustering /
        // chimera / mumu / table steps scale their RAM off this: most
        // need ~1x, swarm fastidious global clustering needs ~3x (the
        // single most memory-hungry step). Leave null to use the fixed
        // fallbacks noted on each tier, then escalated on retry.
        params.dataset_size_gb    = null
        // Approximate reference-database size in GB. The taxonomic
        // assignment steps (vsearch --usearch_global / --sintax) load
        // the reference into RAM and build a k-mer index that inflates
        // it several-fold, so they scale off this rather than the
        // dataset size. The ~4x factor below covers that inflation.
        params.reference_size_gb  = null

        // [S07]: resource ceiling. The per-tier memory/time below
        // escalate with task.attempt on retry (e.g. global_clustering
        // asks 64.GB * attempt). Without a cap, a step on a too-small
        // partition keeps requesting more than any node offers and
        // loops to failure instead of failing fast. resourceLimits
        // (native Nextflow >= 24.04) clamps every request to the
        // largest node a site offers. Override per-site with
        // --max_cpus / --max_memory / --max_time (memory/time as
        // quoted Nextflow units, e.g. --max_memory '256.GB').
        params.max_cpus   = 16
        params.max_memory = 128.GB
        params.max_time   = 240.h

        process {
            executor       = 'slurm'
            queue          = params.slurm_queue
            // [S07]: submit as job arrays when --slurm_array_size is set
            // (null -> directive omitted, one job per task). Evaluated
            // here so a CLI --slurm_array_size takes effect; cluster
            // profiles that want a default re-bind this after including
            // conf/slurm.config (see conf/clusters/genotoul.config).
            array          = params.slurm_array_size
            // [S75]: combine the optional --account with any site-supplied
            // extra options (params.slurm_clusterOptions: QoS, constraints,
            // reservations). Either, both, or neither may be set; the
            // closure yields null when neither is, so the directive is
            // omitted entirely.
            clusterOptions = {
                [ params.slurm_account ? "--account=${params.slurm_account}" : null,
                  params.slurm_clusterOptions ?: null
                ].findAll().join(' ') ?: null
            }
            resourceLimits = [
                cpus  : params.max_cpus,
                memory: params.max_memory,
                time  : params.max_time
            ]

            // Default tier: single-threaded glue — bash/awk and the
            // python helpers, the single-threaded mumu binary, and the
            // single-threaded vsearch passes (--fastq_join, --fastq_filter,
            // --fastx_uniques, --fastx_filter) that do not take a thread
            // count. One core, modest memory.
            cpus          = 1
            memory        = { 4.GB * task.attempt }
            time          = { 30.min * task.attempt }
            errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
            maxRetries    = 2

            // Medium tier: multi-threaded vsearch/swarm/cutadapt steps
            // that scale with cores but are not memory hogs.
            withName: 'merge_fastq_pairs|trim_primers|list_local_clusters|search_for_terminal_gaps' {
                cpus   = { params.threads }
                memory = { 8.GB * task.attempt }
                time   = { 2.h * task.attempt }
            }

            // Top tier: vsearch all-vs-all self-search is fully
            // multi-threaded — give it the whole core allocation. Memory
            // grows with the dataset (~1x), fallback 32 GB.
            withName: 'find_similar_sequences' {
                cpus   = { params.threads }
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * task.attempt) as int} GB"
                           : 32.GB * task.attempt }
                time   = { 8.h * task.attempt }
            }

            // vsearch chimera detection runs as a two-stage pipe
            // (filtering | uchime_denovo), so it tops out at two
            // threads no matter how high params.threads goes — reserve
            // exactly two cores. Memory grows with the dataset (~1x),
            // fallback 32 GB. `chimera_detection` also matches
            // `chimera_detection_post_cleave`.
            withName: 'chimera_detection' {
                cpus   = 2
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * task.attempt) as int} GB"
                           : 32.GB * task.attempt }
                time   = { 8.h * task.attempt }
            }

            // Single-threaded but dataset-bound in memory (~1x), fallback
            // 16 GB: vsearch global dereplication (--fastx_uniques holds
            // the full set in a hash), build_occurrence_table and the
            // single-threaded mumu pass both load a whole-study table.
            withName: 'global_dereplication|build_occurrence_table|run_mumu' {
                cpus   = 1
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * task.attempt) as int} GB"
                           : 16.GB * task.attempt }
                time   = { 4.h * task.attempt }
            }

            // Multi-threaded and reference-database-bound in memory:
            // vsearch loads the reference and builds a k-mer index
            // (~4x the reference size). Both the stampa scatter (each
            // job loads the full reference regardless of chunk size)
            // and the single-pass sintax classifier scale off
            // --reference_size_gb, fallback 8 GB.
            withName: 'assign_taxonomy_stampa|assign_taxonomy_sintax' {
                cpus   = { params.threads }
                memory = { params.reference_size_gb
                           ? "${(params.reference_size_gb * 4 * task.attempt) as int} GB"
                           : 8.GB * task.attempt }
                time   = { 2.h * task.attempt }
            }

            // Memory-bound: swarm fastidious global clustering needs
            // roughly 3x the dataset size in RAM — the single most
            // memory-hungry step. Scale off --dataset_size_gb when
            // provided, otherwise fall back to 64 GB.
            withName: 'global_clustering' {
                cpus   = { params.threads }
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * 3 * task.attempt) as int} GB"
                           : 64.GB * task.attempt }
                time   = { 8.h * task.attempt }
            }
        }

        executor {
            queueSize       = params.slurm_queue_size
            submitRateLimit = '50/1min'
            pollInterval    = '30 sec'
        }
