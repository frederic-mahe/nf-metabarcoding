nextflow_pipeline {

    name "nf-metabarcoding workflow"
    script "main.nf"

    test("runs end-to-end on the paired_merge_ok fixtures") {
        // COVERAGE: [S01], [S03], [S10], [S11], [S12], [S19], [S71]
        tag "ci"
        when {
            params {
                outdir         = "${outputDir}/a_e2eok"
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_ok_{1,2}.fastq.gz"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            // [S19] per-step logs land in <outdir>/per_sample/
            def folder = "${outputDir}/a_e2eok/per_sample"
            def sampleId = "paired_merge_ok"
            ["merging", "trimming", "dereplicating", "clustering"].each { step ->
                def log = file("${folder}/${sampleId}_${step}.log")
                assert log.exists()       : "missing ${step} log: ${log}"
                assert log.size() > 0     : "empty ${step} log: ${log}"
            }

            // [S01]/[S19]: per-sample artefacts (the Part A → Part B
            // contract) also land in <outdir>/per_sample/.
            ["fas", "qual", "stats"].each { ext ->
                def artefact = file("${folder}/${sampleId}.${ext}")
                assert artefact.exists() :
                    "missing per-sample ${ext}: ${artefact}"
            }

            // [S17]: every row in the published .stats has column 2
            // (total reads) > 2. The paired_merge_ok fixture has 3
            // singleton clusters, all filtered out → an empty .stats
            // is a legitimate outcome.
            file("${folder}/${sampleId}.stats").readLines().each { line ->
                if ( line.trim().isEmpty() ) {
                    return
                }
                def total = line.split("\t")[1] as int
                assert total > 2 :
                    "[S17] violation: row with total=${total} reads survived: ${line}"
            }
        }
    }

    test("--help prints usage and exits without running any process") {
        // COVERAGE: [S57]
        tag "ci"
        when {
            params {
                help = true
                // deliberately no other params — --help must
                // short-circuit before the mode-required asserts
                // (`--fastq_folder`, `--forward_primer`, etc.) fire.
            }
        }
        then {
            assert workflow.success
            def out = workflow.stdout.toString()

            // header + all three entry-point flags appear in the
            // usage block (their presence is what makes the help
            // discoverable).
            ["Usage:",
             "--fastq_folder",
             "--fasta_folder",
             "--occurrence_table"].each { marker ->
                assert out.contains(marker) :
                    "--help output should contain '${marker}', got: ${out}"
            }

            // no process should run on --help — workflow.stdout
            // lists every executed process, so an empty intersection
            // with the process names confirms nothing fired.
            ["merge_fastq_pairs",
             "trim_primers",
             "filter_and_convert_to_fasta",
             "dereplicate_fasta",
             "list_local_clusters",
             "global_dereplication",
             "global_clustering",
             "discover_inputs",
             "discover_part_b_fasta"].each { proc ->
                assert !out.contains(proc) :
                    "--help must not trigger ${proc}, got: ${out}"
            }
        }
    }

    test("aborts when a required parameter is missing") {
        // COVERAGE: [S18]
        tag "ci"
        when {
            params {
                fastq_folder  = "tests/data"
                fastq_pattern = "/paired_merge_ok_{1,2}.fastq.gz"
                threads       = 1
                // forward_primer is deliberately not set
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.errorReport).toString().contains("forward_primer")
        }
    }

    test("--no_trimming true skips the trim_primers step") {
        // COVERAGE: [S20]
        // The trim_primers process must not appear in the workflow
        // trace. We check workflow.stdout (which lists every process
        // run) rather than the absence of paired_merge_ok_trimming.log
        // — `tests/data/` is shared across cases, so other tests in
        // this file may have just published that log there.
        tag "ci"
        when {
            params {
                forward_primer = ""
                reverse_primer = ""
                no_trimming    = true
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_ok_{1,2}.fastq.gz"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            def out = workflow.stdout.toString()
            assert !out.contains("trim_primers") :
                "trim_primers should not run when --no_trimming is set, got: ${out}"
            // the other Part A processes still run
            ["merge_fastq_pairs", "filter_and_convert_to_fasta",
             "dereplicate_fasta", "list_local_clusters"].each { proc ->
                assert out.contains(proc) :
                    "expected ${proc} to run, got: ${out}"
            }
        }
    }

    test("--no_trimming true with primers set aborts") {
        // COVERAGE: [S20]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                no_trimming    = true
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_ok_{1,2}.fastq.gz"
                threads        = 1
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.contains("forward_primer") || msg.contains("reverse_primer") :
                "expected error to name the conflicting primer parameter, got: ${msg}"
            assert msg.contains("no_trimming") :
                "expected error to mention --no_trimming, got: ${msg}"
        }
    }

    test("--no_trimming true also skips trim_primers on the shadow Part A pipeline") {
        // COVERAGE: [S04], [S20]
        // paired_merge_fail produces both a regular and a shadow
        // (_notmerged) stream — the regular and shadow channels are
        // mixed before the trim_primers gate in part_A, so asserting
        // trim_primers is entirely absent from the trace while the
        // shadow-only join_notmerged / strip_reads still run proves
        // --no_trimming reaches the shadow pipeline too.
        // As in the sibling [S20] test, we check workflow.stdout (the
        // process trace) rather than the absence of a published
        // _notmerged_trimming.log — tests/data/ is shared across
        // cases and the [S04] test may have just published one.
        tag "ci"
        when {
            params {
                forward_primer = ""
                reverse_primer = ""
                no_trimming    = true
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_fail_{1,2}.fastq.gz"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            def out = workflow.stdout.toString()
            assert !out.contains("trim_primers") :
                "trim_primers must not run when --no_trimming is set (shadow path), got: ${out}"
            // shadow-only processes still run on the _notmerged stream
            ["join_notmerged", "strip_reads"].each { proc ->
                assert out.contains(proc) :
                    "expected shadow-path ${proc} to run, got: ${out}"
            }
            // common processes still run on both regular and shadow streams
            ["merge_fastq_pairs", "filter_and_convert_to_fasta",
             "dereplicate_fasta", "list_local_clusters"].each { proc ->
                assert out.contains(proc) :
                    "expected ${proc} to run, got: ${out}"
            }
        }
    }

    test("unpaired fastq files are processed by skipping the merging step") {
        // COVERAGE: [S21]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/unpaired_only"
                outdir         = "${outputDir}/a_unpaired"
                fastq_pattern  = "/*_{1,2}.fastq.gz"  // matches nothing in this dir
                threads        = 1
            }
        }
        then {
            assert workflow.success
            def out = workflow.stdout.toString()
            assert !out.contains("merge_fastq_pairs") :
                "merge_fastq_pairs must not run when no paired files are present, got: ${out}"
            // downstream Part A processes still run on the unpaired sample
            ["trim_primers",
             "filter_and_convert_to_fasta",
             "dereplicate_fasta",
             "list_local_clusters"].each { proc ->
                assert out.contains(proc) :
                    "expected ${proc} to run on the unpaired sample, got: ${out}"
            }
            // per-sample artefacts and the [S19] logs land in <outdir>/per_sample/
            def folder = "${outputDir}/a_unpaired/per_sample"
            def sampleId = "unpaired_sample"
            assert file("${folder}/${sampleId}.fas").exists()         : "missing .fas"
            assert file("${folder}/${sampleId}_trimming.log").exists() : "missing trimming log"
            assert file("${folder}/${sampleId}_dereplicating.log").exists() : "missing dereplicating log"
            assert file("${folder}/${sampleId}_clustering.log").exists() : "missing clustering log"
            assert !file("${folder}/${sampleId}_merging.log").exists() :
                "merging log should not exist for an unpaired sample"
        }
    }

    test("--hash_function md5 names per-sample amplicons with 32-char MD5 digests") {
        // COVERAGE: [S65]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_ok_{1,2}.fastq.gz"
                hash_function  = "md5"
                outdir         = "${outputDir}/a_md5"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            // [S65] end-to-end: hash_relabel_flag() / hash_id_length()
            // thread md5 through filter_and_convert_to_fasta and the
            // .qual dedup. The published per-sample .qual carries
            // 32-hex-char names (vs the 40 of the default sha1 runs).
            def qual = file("${outputDir}/a_md5/per_sample/paired_merge_ok.qual")
            assert qual.exists() : "missing published .qual"
            def lines = qual.readLines()
            assert lines.size() > 0 : "expected at least one .qual row"
            lines.each { line ->
                assert line.split(' ')[0] ==~ /[0-9a-f]{32}/ :
                    "expected 32-char MD5 name in .qual, got: ${line}"
            }
        }
    }

    test("discovers a MiSeq-style paired sample via the canonical pattern table") {
        // COVERAGE: [S11], [S12]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/miseq"
                outdir         = "${outputDir}/a_miseq"
                fastq_pattern  = ""  // rely purely on the canonical table
                threads        = 1
            }
        }
        then {
            assert workflow.success
            // Sample ID derives from canonical pattern row 1
            // (`_L00[1-9]_R1_00[1-9]\.<ext>`).
            def folder = "${outputDir}/a_miseq/per_sample"
            def sampleId = "SampleX_S1"
            ["merging", "trimming", "dereplicating", "clustering"].each { step ->
                def log = file("${folder}/${sampleId}_${step}.log")
                assert log.exists()   : "missing ${step} log: ${log}"
                assert log.size() > 0 : "empty ${step} log: ${log}"
            }
        }
    }

    test("walks a comma-separated list of fastq folders") {
        // COVERAGE: [S10]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/miseq,${projectDir}/tests/data/unpaired_only"
                outdir         = "${outputDir}/a_comma"
                fastq_pattern  = ""
                threads        = 1
            }
        }
        then {
            assert workflow.success
            // Both samples — one paired (miseq), one single-end
            // (unpaired_only) — appear in the trace.
            def out = workflow.stdout.toString()
            assert out.contains("merge_fastq_pairs") :
                "expected merge_fastq_pairs to run on the MiSeq pair, got: ${out}"
            // Per-sample log probes
            assert file("${outputDir}/a_comma/per_sample/SampleX_S1_merging.log").exists()
            assert file("${outputDir}/a_comma/per_sample/unpaired_sample_dereplicating.log").exists()
            assert !file("${outputDir}/a_comma/per_sample/unpaired_sample_merging.log").exists() :
                "single-end sample must not produce a merging log"
        }
    }

    test("paired-end pairs that cannot merge produce a _notmerged shadow set") {
        // COVERAGE: [S04], [S19]
        tag "ci"
        when {
            params {
                outdir         = "${outputDir}/a_notmerged"
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_fail_{1,2}.fastq.gz"
                threads        = 1
            }
        }
        then {
            assert workflow.success

            def folder = "${outputDir}/a_notmerged/per_sample"
            def shadowId = "paired_merge_fail_notmerged"

            // [S04]: shadow path has no merging step (the reads in
            // this branch could not be merged, by definition); the
            // remaining three per-step logs land alongside the
            // regular ones.
            ["trimming", "dereplicating", "clustering"].each { step ->
                def log = file("${folder}/${shadowId}_${step}.log")
                assert log.exists()   : "missing shadow ${step} log: ${log}"
                assert log.size() > 0 : "empty shadow ${step} log: ${log}"
            }
            assert !file("${folder}/${shadowId}_merging.log").exists() :
                "shadow path must not publish a _merging.log"

            // shadow .fas exists and carries the default 8-A
            // join padding ([S04], [S63]); no Ns are introduced any
            // more.
            def fas = file("${folder}/${shadowId}.fas")
            assert fas.exists() : "missing shadow .fas"
            assert fas.text.contains("AAAAAAAA") :
                "shadow .fas must carry the 8-A join padding"
            fas.readLines().eachWithIndex { line, i ->
                if ( i % 2 == 1 ) {
                    assert !line.contains("N") :
                        "shadow .fas sequence line ${i} contains N: ${line}"
                }
            }

            // shadow .qual / .stats also published
            assert file("${folder}/${shadowId}.qual").exists() : "missing shadow .qual"
            assert file("${folder}/${shadowId}.stats").exists() : "missing shadow .stats"
        }
    }

    test("--join_padding_length lever widens the A run in the shadow .fas") {
        // COVERAGE: [S04], [S63]
        // End-to-end check that the param threads through Part A.
        // Pick a length that no natural read can produce by chance
        // (16 As) so the test fails fast if the lever is dropped.
        tag "ci"
        when {
            params {
                forward_primer       = "CCAGCASCYGCGGTAATTCC"
                reverse_primer       = "ACTTTCGTTCTTGATYRA"
                fastq_folder         = "${projectDir}/tests/data"
                fastq_pattern        = "/paired_merge_fail_{1,2}.fastq.gz"
                join_padding_length  = 16
                outdir               = "${outputDir}/a_padding"
                threads              = 1
            }
        }
        then {
            assert workflow.success
            def folder = "${outputDir}/a_padding/per_sample"
            def shadowId = "paired_merge_fail_notmerged"

            def fas = file("${folder}/${shadowId}.fas")
            assert fas.exists() : "missing shadow .fas"
            assert fas.text.contains("A" * 16) :
                "shadow .fas must carry the 16-A join padding"
            // No run shorter than the requested length should appear
            // as an *isolated* padding artefact: every join site must
            // be exactly 16 As. (Natural runs of As shorter than 16
            // are fine; the assertion above is the sufficient guard
            // for the lever.)
        }
    }

    test("aborts when two input fastq pairs resolve to the same sample ID") {
        // COVERAGE: [S13], [S14]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                // Two folders, each producing sample ID "A" via a
                // different canonical pattern row.
                fastq_folder   = (
                    "${projectDir}/tests/data/duplicate_sample_ids/run1," +
                    "${projectDir}/tests/data/duplicate_sample_ids/run2"
                )
                fastq_pattern  = ""
                threads        = 1
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            // error names the colliding sample ID and lists every
            // duplicated fastq path
            assert msg.toLowerCase().contains("duplicate") :
                "expected error to mention duplicates, got: ${msg}"
            assert msg.contains("run1/A_1.fastq.gz") :
                "expected error to list run1 R1, got: ${msg}"
            assert msg.contains("run2/A_R1.fastq.gz") :
                "expected error to list run2 R1, got: ${msg}"
        }
    }

    test("aborts when a sample ID ends with the reserved 'notmerged' suffix") {
        // COVERAGE: [S23]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/reserved_keyword"
                fastq_pattern  = ""
                threads        = 1
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.toLowerCase().contains("notmerged") :
                "expected error to mention the reserved suffix, got: ${msg}"
        }
    }

    test("Part B standalone runs every pre-cleaving process on the part_b fixture") {
        // COVERAGE: [S09], [S25], [S26], [S27], [S45], [S46]
        tag "ci"
        when {
            params {
                project_name   = "myproj"
                results_folder = "${outputDir}/part_b_results"
                fasta_folder   = "${projectDir}/tests/data/part_b"
                threads        = 1
            }
        }
        then {
            assert workflow.success

            // [S26]: the results folder is created on the fly.
            def resultDir = "${outputDir}/part_b_results/occurrence_table"
            assert file(resultDir).exists() : "results folder should be created"

            // [S09]/[S27]: 3 samples (S1, S2 with content + E empty);
            // S1_notmerged.fas is excluded. Project-wide artefacts use
            // the `<project>_<N>_samples` basename — N counts the
            // empty sample too.
            def base = "${resultDir}/myproj_3_samples"

            // [S45]: six step-level log files, all named under the
            // project-wide basename construct.
            ["${base}_dereplication.log",
             "${base}_clustering.log",
             "${base}_chimera_detection.log",
             "${base}_cleaving.log",
             "${base}_superstring_clustering.log",
             "${base}_post_clustering_curation.log"].each { log ->
                def f = file(log)
                assert f.exists() : "missing Part B step log: ${log}"
                assert f.size() > 0 : "empty Part B step log: ${log}"
            }

            // [S46]: the final occurrence table is published as
            // <basename>_table.tsv; intermediate tables are not
            // published.
            def finalTable = file("${base}_table.tsv")
            assert finalTable.exists() : "missing final occurrence table"
            assert finalTable.size() > 0
            assert finalTable.text.split("\n", 2)[0].startsWith("OTU\ttotal") :
                "unexpected header in final occurrence table"

            // [S59]: every Part B intermediate (tables, .qual,
            // .distr, swarm artefacts, etc.) is kept inside the
            // work directory; only the whitelist (table + post-mumu
            // fasta + six logs) reaches results_folder.
            ["${base}.OTU.filtered.cleaved.table",
             "${base}.OTU.filtered.cleaved.nosubstringOTUs.table",
             "${base}.OTU.filtered.cleaved.nosubstringOTUs_raw_mumu.table",
             "${base}.OTU.filtered.cleaved.nosubstringOTUs.mumu.table",
             "${base}.qual",
             "${base}.distr",
             "${base}_per_sample_OTUs.stats",
             "${base}.fas",
             "${base}_1f.swarms",
             "${base}_1f.stats",
             "${base}_1f.struct",
             "${base}_1f_representatives.fas"].each { intermediate ->
                assert !file(intermediate).exists() :
                    "intermediate leaked into results folder: ${intermediate}"
            }

            // [S56]: S1_notmerged.{fas,qual,stats} feed the shadow
            // Part B workflow (not the regular one). The
            // dereplicated regular global fasta is no longer
            // published ([S59]), so we check the regular
            // _table.tsv instead — the all-9 SHA1 of the shadow
            // sample must not appear in any row.
            def regularTable = file("${base}_table.tsv").text
            assert !regularTable.contains("9999999999") :
                "_notmerged sample leaked into the regular Part B table"

            // Shadow Part B publishes its own table and post-mumu
            // fasta with a _notmerged token in the basename.
            def shadow_base = "${resultDir}/myproj_1_samples_notmerged"
            assert file("${shadow_base}_table.tsv").exists() :
                "shadow Part B occurrence table should exist"
            assert file("${shadow_base}_table.fas").exists() :
                "shadow Part B post-mumu fasta should exist"

            // [S56]: published shadow sequences carry Ns (not Us).
            // The pre-mumu representatives FASTA is no longer
            // published ([S59]); the post-mumu _table.fas inherits
            // the same sequences (column 10 of _table.tsv) and is
            // checked here instead.
            def shadowFasta = file("${shadow_base}_table.fas").readLines()
            for (int i = 1; i < shadowFasta.size(); i += 2) {
                assert !shadowFasta[i].contains("U") :
                    "U leaked into shadow standalone fasta line ${i}: ${shadowFasta[i]}"
            }
        }
    }

    test("Part A → Part B end-to-end on the paired_merge_ok fixture") {
        // COVERAGE: [S01], [S27]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/e2e_part_b/ok"
                fastq_pattern  = ""
                project_name   = "e2e"
                results_folder = "${outputDir}/e2e_results"
                threads        = 1
            }
        }
        then {
            assert workflow.success

            def resultDir = "${outputDir}/e2e_results/occurrence_table"
            assert file(resultDir).exists() : "results folder should be created"

            // Part A's regular sample → Part B with N=1 (the
            // _notmerged shadow sample is dropped from the Part B
            // channel).
            //
            // [S59]: assert the published whitelist (table + post-
            // mumu fasta + six step logs).
            def base = "${resultDir}/e2e_1_samples"
            ["${base}_table.tsv",
             "${base}_table.fas",
             "${base}_dereplication.log",
             "${base}_clustering.log",
             "${base}_chimera_detection.log",
             "${base}_cleaving.log",
             "${base}_superstring_clustering.log",
             "${base}_post_clustering_curation.log"].each { artefact ->
                assert file(artefact).exists() :
                    "missing Part B artefact: ${artefact}"
            }
        }
    }

    test("--input fastq samplesheet drives Part A → Part B end-to-end") {
        // COVERAGE: [S02], [S70]
        // [S70]: --input (fastq profile) is the primary input. With
        // --project_name and an output dir set it drives Part A → Part B
        // exactly like the equivalent --fastq_folder run, publishing the
        // Part B occurrence table + step logs under
        // <outdir>/occurrence_table/ ([S71]). Part B can only build a
        // table from Part A's fasta, so these artefacts existing proves
        // --input drove the whole pipeline.
        tag "ci"
        setup {
            def sheet = file("${outputDir}/input_fastq.csv")
            sheet.text =
                "sample,fastq_1,fastq_2\n" +
                "sampleA," +
                "${projectDir}/tests/data/e2e_part_b/ok/sampleA_1.fastq.gz," +
                "${projectDir}/tests/data/e2e_part_b/ok/sampleA_2.fastq.gz\n"
        }
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                input          = "${outputDir}/input_fastq.csv"
                project_name   = "e2ei"
                results_folder = "${outputDir}/e2ei_results"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            def base = "${outputDir}/e2ei_results/occurrence_table/e2ei_1_samples"
            ["${base}_table.tsv",
             "${base}_table.fas",
             "${base}_dereplication.log",
             "${base}_clustering.log",
             "${base}_chimera_detection.log",
             "${base}_cleaving.log",
             "${base}_superstring_clustering.log",
             "${base}_post_clustering_curation.log"].each { artefact ->
                assert file(artefact).exists() :
                    "missing Part B artefact from --input run: ${artefact}"
            }
        }
    }

