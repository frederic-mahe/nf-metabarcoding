    test("an out-of-range numeric parameter aborts before any process runs") {
        // COVERAGE: [S72]
        // Wiring + message-propagation check for validate_numeric_params()
        // (the per-parameter range matrix is pinned in
        // tests/functions/check_numeric_param.nf.test). --threads 0 is
        // below the 1..256 range, so the run must abort at startup with a
        // message naming the parameter, in an otherwise-valid Part A mode.
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_ok_{1,2}.fastq.gz"
                threads        = 0
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.contains("threads") :
                "error should name the out-of-range parameter 'threads', got: ${msg}"
        }
    }

    test("an out-of-range Part C numeric parameter aborts before any process runs") {
        // COVERAGE: [S72]
