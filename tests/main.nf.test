    test("Part C standalone runs the stampa path end-to-end") {
        // COVERAGE: [S47], [S48], [S49], [S51]
        tag "ci"
        when {
            params {
                threads          = 1
                results_folder   = "${outputDir}/part_c_standalone"
                reference_dataset = "${outputDir}/part_c_standalone_ref.fas"
                occurrence_table  = "${outputDir}/part_c_standalone_table.tsv"
            }
        }
        setup {
            // Tiny reference + occurrence table fixtures built on the
            // fly (kept small enough to stay inside the test file).
            def ref = file("${outputDir}/part_c_standalone_ref.fas")
            ref.parentFile.mkdirs()
            ref.text = ">refA Kingdom|Phylum|Class\nACGTACGTACGTACGTACGTACGTACGTACGT\n"
            def tab = file("${outputDir}/part_c_standalone_table.tsv")
            tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t10\tNA\tamp1\t32\t10\tN\t1\t0.001\t" +
                "ACGTACGTACGTACGTACGTACGTACGTACGT\t0.0\tNA\tNA\t10\n"
            )
        }
        then {
            assert workflow.success
            // Part C derives its basename from the input table's
            // filename by stripping the trailing `_table` suffix.
            // Input `part_c_standalone_table.tsv` → basename
            // `part_c_standalone` → published table
            // `part_c_standalone_table_assigned.tsv` (D04 sub-q2).
            def updated = file(
                "${outputDir}/part_c_standalone/occurrence_table/part_c_standalone_table_assigned.tsv"
            )
            assert updated.exists() :
                "Part C should publish <basename>_table_assigned.tsv"
            def lines = updated.readLines()
            assert lines.size() == 2  // header + 1 row
            def row1 = lines[1].split("\t", -1)
            // identity/taxonomy/references overwritten from stampa
            assert row1[10] != "0.0" || row1[11] != "NA" :
                "expected at least one of identity/taxonomy/references to update, got: ${row1}"
        }
    }

    test("Part C standalone with --majority_assignment publishes the majority table") {
        // COVERAGE: [S66]
        // [S66]: the opt-in majority step runs after
        // update_occurrence_table on the regular path and publishes an
        // independent <basename>_table_assigned_majority.tsv alongside
        // the assigned table. The reference accession in the
        // `references` column resolves against the stampa reference so
        // the majority vote produces a real lineage.
        tag "ci"
        when {
            params {
                threads            = 1
                results_folder     = "${outputDir}/part_c_majority"
                reference_dataset  = "${outputDir}/part_c_majority_ref.fas"
                occurrence_table   = "${outputDir}/part_c_majority_table.tsv"
                majority_assignment = true
            }
        }
        setup {
            def ref = file("${outputDir}/part_c_majority_ref.fas")
            ref.parentFile.mkdirs()
            ref.text = (
                ">refA Kingdom|Phylum|Class\n" +
                "ACGTACGTACGTACGTACGTACGTACGTACGT\n"
            )
            def tab = file("${outputDir}/part_c_majority_table.tsv")
            // `references` already carries the stampa accession `refA`
            // so the majority step has something to look up (Part C's
            // update step would also fill it in, but pinning it here
            // keeps the majority assertion independent of vsearch).
            tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t10\tNA\tamp1\t32\t10\tN\t1\t0.001\t" +
                "ACGTACGTACGTACGTACGTACGTACGTACGT\t0.0\tNA\trefA\t10\n"
            )
        }
        then {
            assert workflow.success
            def assigned = file(
                "${outputDir}/part_c_majority/occurrence_table/part_c_majority_table_assigned.tsv"
            )
            assert assigned.exists() :
                "Part C should still publish <basename>_table_assigned.tsv"
            def majority = file(
                "${outputDir}/part_c_majority/occurrence_table/part_c_majority_table_assigned_majority.tsv"
            )
            assert majority.exists() :
                "--majority_assignment should publish <basename>_table_assigned_majority.tsv"
            def lines = majority.readLines()
            assert lines[0] == "OTU\tamplicon\ttaxonomy_majority"
            assert lines.size() == 2  // header + 1 OTU
            assert lines[1] == "1\tamp1\tKingdom (1/1)|Phylum (1/1)|Class (1/1)" :
                "unexpected majority row: ${lines[1]}"
        }
    }

