    test("empty input samples travel through to the occurrence table") {
        // COVERAGE: [S09]
        // [S09] requires empty samples to appear in the occurrence
        // table as a zero-abundance sample column on rows produced by
        // non-empty samples. The Part B standalone fixture
        // (tests/data/part_b) carries S1, S2, and an empty E.fas — S1
        // and S2 share sequence A (spread=2 → passes Part B's filter
        // rule), so the table has real rows on which to observe E's
        // zero column.
        //
        // A separate Part A probe further down asserts that Part A on
        // empty fastq.gz produces empty .fas / .qual / .stats — the
        // upstream half of the [S09] contract.
        tag "ci"
        when {
            params {
                project_name   = "empty"
                results_folder = "${outputDir}/empty_b_results"
                fasta_folder   = "${projectDir}/tests/data/part_b"
                threads        = 1
            }
        }
        then {
            assert workflow.success

            // Part B publishes <basename>_table.tsv. Three samples
            // (S1, S2, E) — N=3.
            def table = file("${outputDir}/empty_b_results/occurrence_table/empty_3_samples_table.tsv")
            assert table.exists() :
                "Part B should publish the occurrence table"

            def lines = table.readLines()
            assert lines.size() >= 2 :
                "table needs at least one data row to observe the empty " +
                "column; got header-only:\n${lines}"

            def header = lines[0].split("\t", -1).toList()

            // [S09]: E must appear as a sample column even though E.fas
            // is empty and writes no rows to .distr.
            def emptyCol = header.indexOf("E")
            assert emptyCol >= 0 :
                "expected the empty sample 'E' as a column, got: ${header}"
            // Non-empty samples are still there.
            assert header.indexOf("S1") >= 0 && header.indexOf("S2") >= 0 :
                "expected S1 and S2 columns alongside E, got: ${header}"

            // Every data row's empty-column value is 0.
            lines[1..-1].each { row ->
                def cols = row.split("\t", -1)
                assert cols[emptyCol] == "0" :
                    "empty sample E must contribute 0 on every row, got " +
                    "'${cols[emptyCol]}' in: ${row}"
            }
        }
    }

    test("Part A handles empty fastq pairs and emits empty .fas/.qual/.stats") {
        // COVERAGE: [S09]
        // Upstream half of the [S09] contract: an empty fastq pair
        // (zero records) must flow through Part A without errors and
        // produce empty per-sample artefacts. The downstream half (the
        // empty sample appearing as a zero column in the occurrence
        // table) is covered by the test above.
        tag "ci"
        setup {
            def dir = file("${outputDir}/empty_a_input")
            dir.mkdirs()
            ["empty_1.fastq.gz", "empty_2.fastq.gz"].each { name ->
                file("${dir}/${name}").bytes =
                    file("${projectDir}/tests/data/${name}").bytes
            }
        }
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${outputDir}/empty_a_input"
                outdir         = "${outputDir}/a_empty"
                fastq_pattern  = ""
                threads        = 1
            }
        }
        then {
            assert workflow.success
            ["fas", "qual", "stats"].each { ext ->
                def f = file("${outputDir}/a_empty/per_sample/empty.${ext}")
                assert f.exists() :
                    "Part A must emit empty.${ext} for an empty fastq pair: ${f}"
                assert f.size() == 0 :
                    "empty.${ext} must be zero-length, got ${f.size()} bytes"
            }
        }
    }

