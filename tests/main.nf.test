nextflow_pipeline {

    name "nf-metabarcoding workflow"
    script "main.nf"

    test("runs end-to-end on the paired_merge_ok fixtures") {
        // COVERAGE: [S01], [S03], [S10], [S11], [S12], [S19]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_ok_{1,2}.fastq.gz"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            // [S19] per-step logs land in params.fastq_folder
            def folder = "${projectDir}/tests/data"
            def sampleId = "paired_merge_ok"
            ["merging", "trimming", "dereplicating", "clustering"].each { step ->
                def log = file("${folder}/${sampleId}_${step}.log")
                assert log.exists()       : "missing ${step} log: ${log}"
                assert log.size() > 0     : "empty ${step} log: ${log}"
            }
            // TODO: assert per-sample artefacts exist (.fas, .qual, .stats)
            // TODO: assert each .stats row has > 2 reads
        }
    }

    test("aborts when a required parameter is missing") {
        // COVERAGE: [S18]
        tag "ci"
        when {
            params {
                fastq_folder  = "tests/data"
                fastq_pattern = "/paired_merge_ok_{1,2}.fastq.gz"
                threads       = 1
                // forward_primer is deliberately not set
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.errorReport).toString().contains("forward_primer")
        }
    }

    test("--no_trimming true skips the trim_primers step") {
        // COVERAGE: [S20]
        // The trim_primers process must not appear in the workflow
        // trace. We check workflow.stdout (which lists every process
        // run) rather than the absence of paired_merge_ok_trimming.log
        // — `tests/data/` is shared across cases, so other tests in
        // this file may have just published that log there.
        tag "ci"
        when {
            params {
                forward_primer = ""
                reverse_primer = ""
                no_trimming    = true
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_ok_{1,2}.fastq.gz"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            def out = workflow.stdout.toString()
            assert !out.contains("trim_primers") :
                "trim_primers should not run when --no_trimming is set, got: ${out}"
            // the other Part A processes still run
            ["merge_fastq_pairs", "filter_and_convert_to_fasta",
             "dereplicate_fasta", "list_local_clusters"].each { proc ->
                assert out.contains(proc) :
                    "expected ${proc} to run, got: ${out}"
            }
        }
    }

    test("--no_trimming true with primers set aborts") {
        // COVERAGE: [S20]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                no_trimming    = true
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_ok_{1,2}.fastq.gz"
                threads        = 1
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.contains("forward_primer") || msg.contains("reverse_primer") :
                "expected error to name the conflicting primer parameter, got: ${msg}"
            assert msg.contains("no_trimming") :
                "expected error to mention --no_trimming, got: ${msg}"
        }
    }

    test("unpaired fastq files are processed by skipping the merging step") {
        // COVERAGE: [S21]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/unpaired_only"
                fastq_pattern  = "/*_{1,2}.fastq.gz"  // matches nothing in this dir
                threads        = 1
            }
        }
        then {
            assert workflow.success
            def out = workflow.stdout.toString()
            assert !out.contains("merge_fastq_pairs") :
                "merge_fastq_pairs must not run when no paired files are present, got: ${out}"
            // downstream Part A processes still run on the unpaired sample
            ["trim_primers",
             "filter_and_convert_to_fasta",
             "dereplicate_fasta",
             "list_local_clusters"].each { proc ->
                assert out.contains(proc) :
                    "expected ${proc} to run on the unpaired sample, got: ${out}"
            }
            // per-sample artefacts and the [S19] logs land in fastq_folder
            def folder = "${projectDir}/tests/data/unpaired_only"
            def sampleId = "unpaired_sample"
            assert file("${folder}/${sampleId}.fas").exists()         : "missing .fas"
            assert file("${folder}/${sampleId}_trimming.log").exists() : "missing trimming log"
            assert file("${folder}/${sampleId}_dereplicating.log").exists() : "missing dereplicating log"
            assert file("${folder}/${sampleId}_clustering.log").exists() : "missing clustering log"
            assert !file("${folder}/${sampleId}_merging.log").exists() :
                "merging log should not exist for an unpaired sample"
        }
    }

    test("discovers a MiSeq-style paired sample via the canonical pattern table") {
        // COVERAGE: [S11], [S12]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/miseq"
                fastq_pattern  = ""  // rely purely on the canonical table
                threads        = 1
            }
        }
        then {
            assert workflow.success
            // Sample ID derives from canonical pattern row 1
            // (`_L00[1-9]_R1_00[1-9]\.<ext>`).
            def folder = "${projectDir}/tests/data/miseq"
            def sampleId = "SampleX_S1"
            ["merging", "trimming", "dereplicating", "clustering"].each { step ->
                def log = file("${folder}/${sampleId}_${step}.log")
                assert log.exists()   : "missing ${step} log: ${log}"
                assert log.size() > 0 : "empty ${step} log: ${log}"
            }
        }
    }

    test("walks a comma-separated list of fastq folders") {
        // COVERAGE: [S10]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/miseq,${projectDir}/tests/data/unpaired_only"
                fastq_pattern  = ""
                threads        = 1
            }
        }
        then {
            assert workflow.success
            // Both samples — one paired (miseq), one single-end
            // (unpaired_only) — appear in the trace.
            def out = workflow.stdout.toString()
            assert out.contains("merge_fastq_pairs") :
                "expected merge_fastq_pairs to run on the MiSeq pair, got: ${out}"
            // Per-sample log probes
            assert file("${projectDir}/tests/data/miseq/SampleX_S1_merging.log").exists()
            assert file("${projectDir}/tests/data/unpaired_only/unpaired_sample_dereplicating.log").exists()
            assert !file("${projectDir}/tests/data/unpaired_only/unpaired_sample_merging.log").exists() :
                "single-end sample must not produce a merging log"
        }
    }

    test("paired-end pairs that cannot merge produce a _notmerged shadow set") {
        // COVERAGE: [S04], [S19]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_fail_{1,2}.fastq.gz"
                threads        = 1
            }
        }
        then {
            assert workflow.success

            def folder = "${projectDir}/tests/data"
            def shadowId = "paired_merge_fail_notmerged"

            // per-step shadow logs land alongside the regular ones
            ["merging", "trimming", "dereplicating", "clustering"].each { step ->
                def log = file("${folder}/${shadowId}_${step}.log")
                assert log.exists()   : "missing shadow ${step} log: ${log}"
                assert log.size() > 0 : "empty shadow ${step} log: ${log}"
            }

            // shadow .fas exists and retains the 8-N join padding
            def fas = file("${folder}/${shadowId}.fas")
            assert fas.exists() : "missing shadow .fas"
            assert fas.text.contains("NNNNNNNN") :
                "shadow .fas must preserve the 8-N join padding"

            // shadow .qual / .stats also published
            assert file("${folder}/${shadowId}.qual").exists() : "missing shadow .qual"
            assert file("${folder}/${shadowId}.stats").exists() : "missing shadow .stats"
        }
    }

    test("aborts when two input fastq pairs resolve to the same sample ID") {
        // COVERAGE: [S13], [S14]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                // Two folders, each producing sample ID "A" via a
                // different canonical pattern row.
                fastq_folder   = (
                    "${projectDir}/tests/data/duplicate_sample_ids/run1," +
                    "${projectDir}/tests/data/duplicate_sample_ids/run2"
                )
                fastq_pattern  = ""
                threads        = 1
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            // error names the colliding sample ID and lists every
            // duplicated fastq path
            assert msg.toLowerCase().contains("duplicate") :
                "expected error to mention duplicates, got: ${msg}"
            assert msg.contains("run1/A_1.fastq.gz") :
                "expected error to list run1 R1, got: ${msg}"
            assert msg.contains("run2/A_R1.fastq.gz") :
                "expected error to list run2 R1, got: ${msg}"
        }
    }

    test("aborts when a sample ID ends with the reserved 'notmerged' suffix") {
        // COVERAGE: [S23]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/reserved_keyword"
                fastq_pattern  = ""
                threads        = 1
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.toLowerCase().contains("notmerged") :
                "expected error to mention the reserved suffix, got: ${msg}"
        }
    }

    test("Part B standalone runs every pre-cleaving process on the part_b fixture") {
        // COVERAGE: [S09], [S25], [S26], [S27], [S45], [S46]
        tag "ci"
        when {
            params {
                project_name   = "myproj"
                results_folder = "${outputDir}/part_b_results"
                fasta_folder   = "${projectDir}/tests/data/part_b"
                threads        = 1
            }
        }
        then {
            assert workflow.success

            // [S26]: the results folder is created on the fly.
            def resultDir = "${outputDir}/part_b_results"
            assert file(resultDir).exists() : "results folder should be created"

            // [S09]/[S27]: 3 samples (S1, S2 with content + E empty);
            // S1_notmerged.fas is excluded. Project-wide artefacts use
            // the `<project>_<N>_samples` basename — N counts the
            // empty sample too.
            def base = "${resultDir}/myproj_3_samples"

            // [S45]: six step-level log files, all named under the
            // project-wide basename construct.
            ["${base}_dereplication.log",
             "${base}_clustering.log",
             "${base}_chimera_detection.log",
             "${base}_cleaving.log",
             "${base}_superstring_clustering.log",
             "${base}_post_clustering_curation.log"].each { log ->
                def f = file(log)
                assert f.exists() : "missing Part B step log: ${log}"
                assert f.size() > 0 : "empty Part B step log: ${log}"
            }

            // [S46]: the final occurrence table is published as
            // <basename>_table.tsv; intermediate tables are not
            // published.
            def finalTable = file("${base}_table.tsv")
            assert finalTable.exists() : "missing final occurrence table"
            assert finalTable.size() > 0
            assert finalTable.text.split("\n", 2)[0].startsWith("OTU\ttotal") :
                "unexpected header in final occurrence table"

            ["${base}.OTU.filtered.cleaved.table",
             "${base}.OTU.filtered.cleaved.nosubstringOTUs.table",
             "${base}.OTU.filtered.cleaved.nosubstringOTUs_raw_mumu.table",
             "${base}.OTU.filtered.cleaved.nosubstringOTUs.mumu.table"].each { intermediate ->
                assert !file(intermediate).exists() :
                    "intermediate table leaked into results folder: ${intermediate}"
            }

            // Non-table intermediates (.qual, .distr, .stats, swarm
            // artefacts) remain published for debugging — the
            // restriction in [S46] is on intermediate *tables* only.
            ["${base}.qual",
             "${base}.distr",
             "${base}_per_sample_OTUs.stats",
             "${base}.fas",
             "${base}_1f.swarms",
             "${base}_1f.stats",
             "${base}_1f_representatives.fas"].each { artefact ->
                assert file(artefact).exists() :
                    "missing Part B artefact: ${artefact}"
            }

            // The notmerged decoy must not appear anywhere in the
            // global fasta.
            def globalFasta = file("${base}.fas").text
            assert !globalFasta.contains("9999999999") :
                "_notmerged decoy leaked into the Part B fasta channel"
        }
    }

    test("Part A → Part B end-to-end on the paired_merge_ok fixture") {
        // COVERAGE: [S01], [S27]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/e2e_part_b/ok"
                fastq_pattern  = ""
                project_name   = "e2e"
                results_folder = "${outputDir}/e2e_results"
                threads        = 1
            }
        }
        then {
            assert workflow.success

            def resultDir = "${outputDir}/e2e_results"
            assert file(resultDir).exists() : "results folder should be created"

            // Part A's regular sample → Part B with N=1 (the
            // _notmerged shadow sample is dropped from the Part B
            // channel).
            def base = "${resultDir}/e2e_1_samples"
            ["${base}.qual",
             "${base}.distr",
             "${base}_per_sample_OTUs.stats",
             "${base}.fas",
             "${base}_dereplication.log",
             "${base}_1f.swarms",
             "${base}_1f.stats",
             "${base}_1f_representatives.fas",
             "${base}_clustering.log",
             "${base}_table.tsv"].each { artefact ->
                assert file(artefact).exists() :
                    "missing Part B artefact: ${artefact}"
            }
        }
    }

    test("Part A → Part B drops the _notmerged shadow sample from the Part B channel") {
        // COVERAGE: [S04], [S27]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/e2e_part_b/fail"
                fastq_pattern  = ""
                project_name   = "shadow_e2e"
                results_folder = "${outputDir}/shadow_e2e_results"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            // sampleB.fastq.gz produces *two* Part A sample IDs (the
            // regular `sampleB` and the shadow `sampleB_notmerged`).
            // Only the regular one feeds Part B → N=1.
            def base = "${outputDir}/shadow_e2e_results/shadow_e2e_1_samples"
            assert file("${base}.fas").exists() : "Part B fasta should exist"
            // The shadow sample's published .fas stays in fastq_folder
            // (Part A's publishDir target) — not in the Part B results.
            def shadowInResults = file(
                "${outputDir}/shadow_e2e_results/sampleB_notmerged.fas"
            )
            assert !shadowInResults.exists() :
                "shadow .fas must not be published into the Part B results folder"
        }
    }

    test("Part B aborts when --project_name is missing") {
        // COVERAGE: [S25]
        tag "ci"
        when {
            params {
                results_folder = "${outputDir}/part_b_no_project"
                fasta_folder   = "${projectDir}/tests/data/part_b"
                threads        = 1
                // project_name deliberately unset
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.contains("project_name") :
                "expected error to name project_name, got: ${msg}"
        }
    }

    test("Part B aborts when --results_folder is missing") {
        // COVERAGE: [S26]
        tag "ci"
        when {
            params {
                project_name = "myproj"
                fasta_folder = "${projectDir}/tests/data/part_b"
                threads      = 1
                // results_folder deliberately unset
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.contains("results_folder") :
                "expected error to name results_folder, got: ${msg}"
        }
    }

    test("Part B aborts when two input fastas resolve to the same sample ID") {
        // COVERAGE: [S27], [S13], [S14]
        tag "ci"
        when {
            params {
                project_name   = "myproj"
                results_folder = "${outputDir}/part_b_dupes"
                // tests/data has every sample's .fas at the top level
                // AND duplicate copies in subfolders → at least one
                // duplicate sample ID across the two folders.
                fasta_folder   = (
                    "${projectDir}/tests/data/part_b," +
                    "${projectDir}/tests/data/part_b"
                )
                threads        = 1
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.toLowerCase().contains("duplicate") :
                "expected error to mention duplicates, got: ${msg}"
        }
    }

    test("Part C aborts when --reference_dataset is missing") {
        // COVERAGE: [S47]
        tag "ci"
        when {
            params {
                occurrence_table = "${projectDir}/tests/data/build_filtered_contingency_table/representatives"
                results_folder   = "${outputDir}/part_c_no_ref"
                threads          = 1
                // reference_dataset deliberately unset
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.contains("reference_dataset") :
                "expected error to name reference_dataset, got: ${msg}"
        }
    }

    test("Part C standalone runs the stampa path end-to-end") {
        // COVERAGE: [S47], [S48], [S49], [S51]
        tag "ci"
        when {
            params {
                threads          = 1
                results_folder   = "${outputDir}/part_c_standalone"
                reference_dataset = "${outputDir}/part_c_standalone_ref.fas"
                occurrence_table  = "${outputDir}/part_c_standalone_table.tsv"
            }
        }
        setup {
            // Tiny reference + occurrence table fixtures built on the
            // fly (kept small enough to stay inside the test file).
            def ref = file("${outputDir}/part_c_standalone_ref.fas")
            ref.parentFile.mkdirs()
            ref.text = ">refA Kingdom|Phylum|Class\nACGTACGTACGTACGTACGTACGTACGTACGT\n"
            def tab = file("${outputDir}/part_c_standalone_table.tsv")
            tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t10\tNA\tamp1\t32\t10\tN\t1\t0.001\t" +
                "ACGTACGTACGTACGTACGTACGTACGTACGT\t0.0\tNA\tNA\t10\n"
            )
        }
        then {
            assert workflow.success
            // Part C derives its basename from the input table's
            // filename by stripping the trailing `_table` suffix.
            // Input `part_c_standalone_table.tsv` → basename
            // `part_c_standalone` → published table
            // `part_c_standalone_table.tsv`.
            def updated = file(
                "${outputDir}/part_c_standalone/part_c_standalone_table.tsv"
            )
            assert updated.exists() :
                "Part C should publish <basename>_table.tsv"
            def lines = updated.readLines()
            assert lines.size() == 2  // header + 1 row
            def row1 = lines[1].split("\t", -1)
            // identity/taxonomy/references overwritten from stampa
            assert row1[10] != "0.0" || row1[11] != "NA" :
                "expected at least one of identity/taxonomy/references to update, got: ${row1}"
        }
    }

    test("empty input samples travel through to the occurrence table") {
        // COVERAGE: [S09] — pending until empty-sample passthrough lands.
        // Tagged "pending" so CI (`nf-test test --tag '!pending'`) skips
        // it. Run `nf-test test` locally to see the red.
        tag "pending"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/empty_{1,2}.fastq.gz"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            // TODO: assert occurrence table contains a row for the empty sample with abundance 0
        }
    }
}
