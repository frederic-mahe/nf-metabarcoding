    test("Part A → Part B → Part C end-to-end runs Part C when --reference_dataset is set") {
        // COVERAGE: [S01], [S51]
        // End-to-end three-part workflow: --reference_dataset triggers
        // Part C on Part B's regular occurrence table. The e2e_part_b
        // fixtures have no clusters above the >2 read threshold ([S17])
        // so Part B emits a header-only table. The empty-input
        // contract ([S51]) requires Part C to still publish a
        // header-only <basename>_table_assigned.tsv — exercised here.
        tag "ci"
        when {
            params {
                forward_primer    = "CCAGCASCYGCGGTAATTCC"
                reverse_primer    = "ACTTTCGTTCTTGATYRA"
                fastq_folder      = "${projectDir}/tests/data/e2e_part_b/ok"
                fastq_pattern     = ""
                project_name      = "e2ec"
                results_folder    = "${outputDir}/e2ec_results"
                reference_dataset = "${outputDir}/e2ec_ref.fas"
                threads           = 1
            }
        }
        setup {
            // Tiny reference (single record, identical shape to the
            // standalone Part C fixtures earlier in this file). The
            // e2e fixture's Part B table is empty so the reference is
            // never actually queried, but Part C still needs a valid
            // file path at --reference_dataset.
            def ref = file("${outputDir}/e2ec_ref.fas")
            ref.parentFile.mkdirs()
            ref.text = (
                ">refA Kingdom|Phylum|Class\n" +
                "ACGTACGTACGTACGTACGTACGTACGTACGT\n"
            )
        }
        then {
            assert workflow.success
            def base = "${outputDir}/e2ec_results/occurrence_table/e2ec_1_samples"
            def partB = file("${base}_table.tsv")
            assert partB.exists() :
                "Part B occurrence table should exist end-to-end"
            // The fixture leaves Part B with a header-only table.
            assert partB.readLines().size() == 1 :
                "expected Part B occurrence table to be header-only, got: ${partB.readLines()}"
            // [S51] empty-input contract: Part C still publishes a
            // header-only <basename>_table_assigned.tsv.
            def assigned = file("${base}_table_assigned.tsv")
            assert assigned.exists() :
                "Part C should publish <basename>_table_assigned.tsv even on empty input"
            assert assigned.readLines().size() == 1 :
                "expected header-only table_assigned.tsv, got: ${assigned.readLines()}"
            assert assigned.readLines()[0] == partB.readLines()[0] :
                "table_assigned header should match the input table header"
        }
    }

    test("Part A → Part B runs shadow Part B alongside the regular path") {
        // COVERAGE: [S04], [S27], [S56]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/e2e_part_b/fail"
                fastq_pattern  = ""
                project_name   = "shadow_e2e"
                results_folder = "${outputDir}/shadow_e2e_results"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            // sampleB.fastq.gz produces two Part A sample IDs: the
            // regular `sampleB` (empty .fas — pairs cannot merge)
            // and the shadow `sampleB_notmerged` (carries the join-
            // padded reads). Both feed Part B: regular path yields
            // shadow_e2e_1_samples_*, shadow path yields
            // shadow_e2e_1_samples_notmerged_*.
            def regular_base = "${outputDir}/shadow_e2e_results/occurrence_table/shadow_e2e_1_samples"
            def shadow_base  = "${regular_base}_notmerged"

            // [S59]: regular path publishes its table; shadow path
            // publishes table + post-mumu fasta.
            assert file("${regular_base}_table.tsv").exists() :
                "regular Part B occurrence table should exist"
            assert file("${shadow_base}_table.tsv").exists() :
                "shadow Part B occurrence table should exist"
            assert file("${shadow_base}_table.fas").exists() :
                "shadow Part B post-mumu fasta should exist (${shadow_base}_table.fas)"

            // [S56] guarantees the published sequences carry only
            // A/C/G/T — the A-padding is composed entirely of
            // standard bases, so neither N nor U should appear on
            // any sequence line. The pre-mumu _1f_representatives.fas
            // is no longer published ([S59]); the post-mumu
            // _table.fas carries the same sequences (col 10 of
            // _table.tsv) and is checked here instead.
            def fastaLines = file("${shadow_base}_table.fas").readLines()
            for (int i = 1; i < fastaLines.size(); i += 2) {
                assert !fastaLines[i].contains("U") :
                    "U leaked into shadow post-mumu fasta line ${i}: ${fastaLines[i]}"
                assert !fastaLines[i].contains("N") :
                    "N leaked into shadow post-mumu fasta line ${i}: ${fastaLines[i]}"
            }

            // [S71]: per-sample shadow .fas goes to <outdir>/per_sample/,
            // never mixed in with the Part B occurrence_table/ artefacts.
            def perSampleInResults = file(
                "${outputDir}/shadow_e2e_results/occurrence_table/sampleB_notmerged.fas"
            )
            assert !perSampleInResults.exists() :
                "per-sample shadow .fas must not appear under occurrence_table/"
        }
    }

    test("Part B results folder holds only table + post-mumu fasta + step logs") {
        // COVERAGE: [S59]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/e2e_part_b/fail"
                fastq_pattern  = ""
                project_name   = "whitelist"
                results_folder = "${outputDir}/whitelist_results"
                threads        = 1
            }
        }
        then {
            assert workflow.success
            def resultDir = "${outputDir}/whitelist_results/occurrence_table"
            def regular = "whitelist_1_samples"
            def shadow  = "whitelist_1_samples_notmerged"
            def stepLogs = [
                "_dereplication.log",
                "_clustering.log",
                "_chimera_detection.log",
                "_cleaving.log",
                "_superstring_clustering.log",
                "_post_clustering_curation.log",
            ]
            def expected = []
            [regular, shadow].each { base ->
                expected << "${base}_table.tsv"
                expected << "${base}_table.fas"
                stepLogs.each { suffix -> expected << "${base}${suffix}" }
            }
            def actual = file(resultDir).listFiles()*.name.toList().sort()
            assert actual == expected.sort() :
                "Part B results folder mismatch.\nexpected: ${expected.sort()}\nactual:   ${actual}"

            // [S68]/[S71]: software_versions.yml is a sibling under
            // <outdir>/pipeline_info/, not inside occurrence_table/.
            assert file("${outputDir}/whitelist_results/pipeline_info/software_versions.yml").exists() :
                "software_versions.yml should be under <outdir>/pipeline_info/"

            // [S59] spell out the blacklist for the regular path so
            // a regression that re-adds a publishDir surfaces with a
            // descriptive failure rather than the generic set diff
            // above.
            ["${regular}.qual",
             "${regular}.distr",
             "${regular}_per_sample_OTUs.stats",
             "${regular}.fas",
             "${regular}_1f.swarms",
             "${regular}_1f.stats",
             "${regular}_1f.struct",
             "${regular}_1f_representatives.fas",
             "${regular}_1f_representatives.results",
             "${regular}_1f_representatives.uchime",
             "${regular}_1f_representatives.results2",
             "${regular}_1f_representatives.uchime2",
             "${regular}_1f.stats2",
             "${regular}_1f.swarms2",
             "${regular}_1f_representatives.fas2",
             "${regular}.OTU.filtered.cleaved.nosubstringOTUs.fas",
            ].each { forbidden ->
                assert !file("${resultDir}/${forbidden}").exists() :
                    "blacklisted Part B intermediate leaked: ${forbidden}"
            }
        }
    }

