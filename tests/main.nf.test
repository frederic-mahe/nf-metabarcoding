        }
    }

    test("Part C standalone runs the regular path through sintax when --taxonomy_method=sintax") {
        // COVERAGE: [S61], [S64]
        // The regular path can opt into sintax via params.taxonomy_method.
        // [S64]: with --taxonomy_method=sintax the regular path consumes
        // --reference_dataset_sintax (not --reference_dataset). The
        // published file is still <basename>_table_assigned.tsv (no
        // _notmerged token).
        tag "ci"
        when {
            params {
                threads                  = 1
                taxonomy_method          = "sintax"
                results_folder           = "${outputDir}/part_c_regular_sintax"
                reference_dataset_sintax = "${outputDir}/part_c_regular_sintax_ref.fas"
                occurrence_table         = "${outputDir}/part_c_regular_sintax_table.tsv"
                sintax_cutoff            = 0.5
            }
        }
        setup {
            def ref = file("${outputDir}/part_c_regular_sintax_ref.fas")
            ref.parentFile.mkdirs()
            ref.text = (
                ">refA;tax=d:Bacteria,p:Proteobacteria;\n" +
                "ACGTACGTACGTACGTACGTACGTACGTACGT\n"
            )
            def tab = file("${outputDir}/part_c_regular_sintax_table.tsv")
            tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t10\tNA\tamp1\t32\t10\tN\t1\t0.001\t" +
                "ACGTACGTACGTACGTACGTACGTACGTACGT\t0.0\tNA\tNA\t10\n"
            )
        }
        then {
            assert workflow.success
            def assigned = file(
                "${outputDir}/part_c_regular_sintax/occurrence_table/part_c_regular_sintax_table_assigned.tsv"
            )
            assert assigned.exists() :
                "regular sintax path should publish <basename>_table_assigned.tsv"
            def lines = assigned.readLines()
            assert lines.size() == 2 :
                "expected header + 1 row, got: ${lines}"
            // No _notmerged sibling was created → no shadow output.
            def shadow = file(
                "${outputDir}/part_c_regular_sintax/occurrence_table/part_c_regular_sintax_notmerged_table_assigned.tsv"
            )
            assert !shadow.exists() :
                "no _notmerged sibling on disk → shadow Part C must not run"
        }
    }

    test("Part C standalone runs shadow Part C when <basename>_notmerged_table.tsv sibling exists") {
        // COVERAGE: [S50], [S62], [S64]
        // [S62]: presence of a <basename>_notmerged_table.tsv sibling
        // alongside the --occurrence_table input is the toggle for the
        // shadow Part C workflow. Both assigned tables must reach the
        // results folder when the sibling is present **and**
        // --reference_dataset_sintax is set ([S64]).
        //
        // The reference header carries both formats so a single fixture
        // serves the regular (stampa, space-separated lineage) and
        // shadow (sintax, `;tax=...;`) paths at once. stampa_merge.py
        // splits the target on the first space, sintax picks up the
        // `tax=...` annotation. Production users would supply two
        // distinct files; the hybrid fixture is a test-only shortcut.
        tag "ci"
        when {
            params {
                threads                  = 1
                results_folder           = "${outputDir}/part_c_shadow"
                reference_dataset        = "${outputDir}/part_c_shadow_ref.fas"
                reference_dataset_sintax = "${outputDir}/part_c_shadow_ref.fas"
                occurrence_table         = "${outputDir}/part_c_shadow_table.tsv"
                sintax_cutoff            = 0.5
            }
        }
        setup {
            // 80-nt non-periodic sequence — sintax needs enough unique
            // kmers (it samples 8-mers) to bootstrap a lineage.
            def SEQ = "ACGGAATTCAGTATTCGATGCAATCAGTAGCATGCAGTTAATCGATGCATTAGCATGCAGTCATGCAATCGAGCATTAGC"
            def ref = file("${outputDir}/part_c_shadow_ref.fas")
            ref.parentFile.mkdirs()
            ref.text = (
                ">refA;tax=d:Bacteria,p:Proteobacteria; Bacteria|Proteobacteria\n" +
                "${SEQ}\n"
            )
            def tab = file("${outputDir}/part_c_shadow_table.tsv")
            tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t10\tNA\tamp1\t80\t10\tN\t1\t0.001\t${SEQ}\t0.0\tNA\tNA\t10\n"
            )
            def shadow_tab = file("${outputDir}/part_c_shadow_notmerged_table.tsv")
            shadow_tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t7\tNA\tampS\t80\t7\tN\t1\t0.001\t${SEQ}\t0.0\tNA\tNA\t7\n"
            )
        }
        then {
            assert workflow.success
            // regular path → stampa
            def regular = file(
                "${outputDir}/part_c_shadow/occurrence_table/part_c_shadow_table_assigned.tsv"
            )
            assert regular.exists() :
                "regular Part C should publish <basename>_table_assigned.tsv"
            // shadow path → sintax on the _notmerged sibling
            def shadow = file(
                "${outputDir}/part_c_shadow/occurrence_table/part_c_shadow_notmerged_table_assigned.tsv"
            )
            assert shadow.exists() :
                "shadow Part C should publish <basename>_notmerged_table_assigned.tsv"
            def shadow_rows = shadow.readLines()
            assert shadow_rows.size() == 2 :
                "expected shadow assigned table header + 1 row, got: ${shadow_rows}"
            def fields = shadow_rows[1].split("\t", -1)
            assert fields[3] == "ampS" :
                "expected shadow row amplicon ampS, got: ${fields[3]}"
            // sintax column 2 = bootstrap-annotated lineage in the
            // taxonomy field (col 12 of the occurrence table schema).
            assert fields[11].contains("d:Bacteria") :
                "expected shadow taxonomy to carry sintax lineage, got: ${fields[11]}"
        }
    }

    test("Part C standalone with no _notmerged sibling skips the shadow workflow") {
        // COVERAGE: [S62]
        // No <basename>_notmerged_table.tsv next to --occurrence_table →
        // shadow Part C is not invoked, only the regular assigned table
        // is published, and the workflow exits cleanly (no error).
        tag "ci"
        when {
            params {
                threads           = 1
                results_folder    = "${outputDir}/part_c_no_shadow"
                reference_dataset = "${outputDir}/part_c_no_shadow_ref.fas"
                occurrence_table  = "${outputDir}/part_c_no_shadow_table.tsv"
            }
        }
        setup {
            def ref = file("${outputDir}/part_c_no_shadow_ref.fas")
            ref.parentFile.mkdirs()
            ref.text = ">refA Kingdom|Phylum|Class\nACGTACGTACGTACGTACGTACGTACGTACGT\n"
            def tab = file("${outputDir}/part_c_no_shadow_table.tsv")
            tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t10\tNA\tamp1\t32\t10\tN\t1\t0.001\t" +
                "ACGTACGTACGTACGTACGTACGTACGTACGT\t0.0\tNA\tNA\t10\n"
            )
            // deliberately no <basename>_notmerged_table.tsv sibling
        }
        then {
            assert workflow.success
            def regular = file(
                "${outputDir}/part_c_no_shadow/occurrence_table/part_c_no_shadow_table_assigned.tsv"
            )
            assert regular.exists() :
                "regular Part C should publish <basename>_table_assigned.tsv"
            def shadow = file(
                "${outputDir}/part_c_no_shadow/occurrence_table/part_c_no_shadow_notmerged_table_assigned.tsv"
            )
            assert !shadow.exists() :
                "no sibling → no shadow Part C → no _notmerged_table_assigned.tsv"
        }
    }

    test("shadow Part C reads --reference_dataset_sintax, not --reference_dataset") {
        // COVERAGE: [S50], [S64]
        // The shadow path always runs sintax. Point --reference_dataset
        // at a stampa-only fasta (no `;tax=...;` header) and
        // --reference_dataset_sintax at a separate sintax-formatted
        // fasta. The published shadow assigned table must carry sintax
        // lineage from the *sintax* file — i.e. the shadow path did not
        // fall back to --reference_dataset.
        tag "ci"
        when {
            params {
                threads                  = 1
                results_folder           = "${outputDir}/part_c_two_refs"
                reference_dataset        = "${outputDir}/part_c_two_refs_stampa_ref.fas"
                reference_dataset_sintax = "${outputDir}/part_c_two_refs_sintax_ref.fas"
                occurrence_table         = "${outputDir}/part_c_two_refs_table.tsv"
                sintax_cutoff            = 0.5
            }
        }
        setup {
            // 80-nt non-periodic sequence — sintax samples 8-mers and
            // needs enough unique kmers to bootstrap a lineage.
            def SEQ = "ACGGAATTCAGTATTCGATGCAATCAGTAGCATGCAGTTAATCGATGCATTAGCATGCAGTCATGCAATCGAGCATTAGC"
            // stampa-only reference: no ;tax=...; annotation, so a
            // sintax run against this file would produce no taxonomy
            // hit (empty col 2 → "NA" after the reshape in [S50]).
            def stampa_ref = file("${outputDir}/part_c_two_refs_stampa_ref.fas")
            stampa_ref.parentFile.mkdirs()
            stampa_ref.text = ">refStampa Bacteria|Proteobacteria\n${SEQ}\n"
            // sintax-only reference: ;tax=...; annotation; a stampa
            // run against this file would carry the entire ;tax=...;
            // string into the references column instead of a clean
            // lineage. Distinct taxonomy from the stampa file so the
            // assertion below can tell which one was consumed.
            def sintax_ref = file("${outputDir}/part_c_two_refs_sintax_ref.fas")
            sintax_ref.text = ">refSintax;tax=d:Archaea,p:Crenarchaeota;\n${SEQ}\n"
            def tab = file("${outputDir}/part_c_two_refs_table.tsv")
            tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t10\tNA\tamp1\t80\t10\tN\t1\t0.001\t${SEQ}\t0.0\tNA\tNA\t10\n"
            )
            def shadow_tab = file("${outputDir}/part_c_two_refs_notmerged_table.tsv")
            shadow_tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t7\tNA\tampS\t80\t7\tN\t1\t0.001\t${SEQ}\t0.0\tNA\tNA\t7\n"
            )
        }
        then {
            assert workflow.success
            def shadow_assigned = file(
                "${outputDir}/part_c_two_refs/occurrence_table/part_c_two_refs_notmerged_table_assigned.tsv"
            )
            assert shadow_assigned.exists() :
                "shadow Part C should publish <basename>_notmerged_table_assigned.tsv"
            def rows = shadow_assigned.readLines()
            assert rows.size() == 2 :
                "expected header + 1 shadow row, got: ${rows}"
            def taxonomy = rows[1].split("\t", -1)[11]
            // Sintax must have read the sintax-formatted file: lineage
            // names "Archaea/Crenarchaeota" from the sintax ref, not
            // "Bacteria/Proteobacteria" from the stampa ref. If shadow
            // Part C had silently fallen back to --reference_dataset
            // (stampa-only), the taxonomy column would be "NA" (no
            // ;tax=...; in the stampa file).
            assert taxonomy.contains("d:Archaea") :
                "shadow taxonomy should come from --reference_dataset_sintax, got: ${taxonomy}"
            assert !taxonomy.contains("d:Bacteria") :
                "shadow path must not consume --reference_dataset, got: ${taxonomy}"
        }
    }

    test("shadow Part C is silently skipped when --reference_dataset_sintax is unset") {
        // COVERAGE: [S50], [S64]
        // Sibling <basename>_notmerged_table.tsv on disk but no
        // --reference_dataset_sintax → shadow Part C must not run; the
        // regular stampa path still publishes its assigned table and
        // the workflow exits cleanly.
        tag "ci"
        when {
            params {
                threads           = 1
                results_folder    = "${outputDir}/part_c_shadow_skip"
                reference_dataset = "${outputDir}/part_c_shadow_skip_ref.fas"
                occurrence_table  = "${outputDir}/part_c_shadow_skip_table.tsv"
                // reference_dataset_sintax deliberately unset
            }
        }
        setup {
            def ref = file("${outputDir}/part_c_shadow_skip_ref.fas")
            ref.parentFile.mkdirs()
            ref.text = ">refA Kingdom|Phylum|Class\nACGTACGTACGTACGTACGTACGTACGTACGT\n"
            def tab = file("${outputDir}/part_c_shadow_skip_table.tsv")
            tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t10\tNA\tamp1\t32\t10\tN\t1\t0.001\t" +
                "ACGTACGTACGTACGTACGTACGTACGTACGT\t0.0\tNA\tNA\t10\n"
            )
            def shadow_tab = file("${outputDir}/part_c_shadow_skip_notmerged_table.tsv")
            shadow_tab.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\tchimera\tspread\t" +
                "quality\tsequence\tidentity\ttaxonomy\treferences\ts1\n" +
                "1\t7\tNA\tampS\t32\t7\tN\t1\t0.001\t" +
                "ACGTACGTACGTACGTACGTACGTACGTACGT\t0.0\tNA\tNA\t7\n"
            )
        }
        then {
            assert workflow.success
            def regular = file(
                "${outputDir}/part_c_shadow_skip/occurrence_table/part_c_shadow_skip_table_assigned.tsv"
            )
            assert regular.exists() :
                "regular Part C should publish <basename>_table_assigned.tsv"
            def shadow = file(
                "${outputDir}/part_c_shadow_skip/occurrence_table/part_c_shadow_skip_notmerged_table_assigned.tsv"
            )
            assert !shadow.exists() :
                "no --reference_dataset_sintax → shadow Part C must not publish"
        }
    }

    test("regular Part C aborts when --taxonomy_method=sintax but --reference_dataset_sintax is missing") {
        // COVERAGE: [S47], [S61], [S64]
        // Selecting the sintax method on the regular path without
        // supplying a sintax-formatted reference must abort at startup,
        // with stderr naming the missing parameter.
        tag "ci"
        when {
            params {
                threads          = 1
                taxonomy_method  = "sintax"
                results_folder   = "${outputDir}/part_c_sintax_no_ref"
                occurrence_table = "${projectDir}/tests/data/build_filtered_contingency_table/representatives"
                // reference_dataset_sintax deliberately unset
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.contains("reference_dataset_sintax") :
                "expected error to name reference_dataset_sintax, got: ${msg}"
        }
    }

    test("a sintax-formatted file passed to --reference_dataset aborts at startup") {
        // COVERAGE: [S73]
        // Wiring + message-propagation for check_reference_format (the
        // format matrix is pinned in
        // tests/functions/check_reference_format.nf.test). A sintax file
        // (>id;tax=...; — no space-separated lineage) handed to the
        // stampa flag must abort naming the parameter.
        tag "ci"
        setup {
            def ref = file("${outputDir}/s73_sintax_as_stampa.fas")
            ref.parentFile.mkdirs()
            ref.text = ">refX;tax=d:Bacteria,p:Proteobacteria;\nACGTACGTACGTACGTACGTACGTACGTACGT\n"
        }
        when {
            params {
                threads           = 1
                results_folder    = "${outputDir}/s73_a"
                occurrence_table  = "${projectDir}/tests/data/build_filtered_contingency_table/representatives"
                reference_dataset = "${outputDir}/s73_sintax_as_stampa.fas"
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.contains("reference_dataset") && msg.contains("stampa-formatted") :
                "expected a stampa-format error naming reference_dataset, got: ${msg}"
        }
    }

    test("a stampa-formatted file passed to --reference_dataset_sintax aborts at startup") {
        // COVERAGE: [S73]
        // The mirror case: a stampa file (no `tax=`) handed to the sintax
        // flag must abort naming reference_dataset_sintax.
        tag "ci"
        setup {
            def ref = file("${outputDir}/s73_stampa_as_sintax.fas")
            ref.parentFile.mkdirs()
            ref.text = ">refY Kingdom|Phylum|Class\nACGTACGTACGTACGTACGTACGTACGTACGT\n"
        }
        when {
            params {
                threads                  = 1
                taxonomy_method          = "sintax"
                results_folder           = "${outputDir}/s73_b"
                occurrence_table         = "${projectDir}/tests/data/build_filtered_contingency_table/representatives"
                reference_dataset_sintax = "${outputDir}/s73_stampa_as_sintax.fas"
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.contains("reference_dataset_sintax") && msg.contains("sintax-formatted") :
                "expected a sintax-format error naming reference_dataset_sintax, got: ${msg}"
        }
    }

    test("a gzip-compressed reference is decompressed and format-sniffed") {
        // COVERAGE: [S73]
        // A `.gz` reference must be transparently decompressed for the
        // sniff: a gzipped stampa file (no `tax=`) handed to the sintax
        // flag must still abort with the sintax-format error, proving the
        // header was actually decoded rather than read as raw gzip bytes.
        tag "ci"
        setup {
            def gz = file("${outputDir}/s73_stampa.fas.gz")
            gz.parentFile.mkdirs()
            def os = new java.util.zip.GZIPOutputStream(gz.newOutputStream())
            os.write(">refZ Kingdom|Phylum\nACGTACGTACGTACGTACGTACGTACGTACGT\n".getBytes("UTF-8"))
            os.close()
        }
        when {
            params {
                threads                  = 1
                taxonomy_method          = "sintax"
                results_folder           = "${outputDir}/s73_c"
                occurrence_table         = "${projectDir}/tests/data/build_filtered_contingency_table/representatives"
                reference_dataset_sintax = "${outputDir}/s73_stampa.fas.gz"
            }
        }
        then {
            assert workflow.failed
            def msg = (workflow.stdout + workflow.errorReport).toString()
            assert msg.contains("sintax-formatted") :
                "expected the gzip reference to be decoded and sniffed, got: ${msg}"
        }
    }

    test("Part B standalone runs end-to-end with --fastidious false") {
        // COVERAGE: [S22], [S32]
        // [S22]/[S32] propagation lever: setting params.fastidious to
        // false threads --no-fastidious through both global_clustering
        // (swarm) and cleaving (cluster_cleaver.py), and the workflow
        // still produces a usable Part B occurrence table. The Part B
        // results folder is whitelist-published ([S59]) so we can't
        // directly observe the _1 suffix from here — the per-process
        // tests in global_clustering.nf.test / cleaving.nf.test pin
        // that. This test is the end-to-end smoke: the whole chain
        // (including downstream chimera detection, cleaver-aware
        // build_occurrence_table, mumu, etc.) survives the non-fastidious
        // input naming.
        tag "ci"
        when {
            params {
                project_name   = "nofast"
                results_folder = "${outputDir}/part_b_nofast"
                fasta_folder   = "${projectDir}/tests/data/part_b"
                threads        = 1
                fastidious     = false
            }
        }
        then {
            assert workflow.success
            def base = "${outputDir}/part_b_nofast/occurrence_table/nofast_3_samples"
            assert file("${base}_table.tsv").exists() :
                "Part B should publish the table under --fastidious=false"
            assert file("${base}_table.fas").exists() :
                "Part B should publish the post-mumu fasta under --fastidious=false"
            ["_dereplication.log",
             "_clustering.log",
             "_chimera_detection.log",
             "_cleaving.log",
             "_superstring_clustering.log",
             "_post_clustering_curation.log"].each { suffix ->
                def log = file("${base}${suffix}")
                assert log.exists() && log.size() > 0 :
                    "missing or empty step log: ${log}"
            }
        }
    }

    test("Part A runs in isolation when only --fastq_folder is set") {
        // COVERAGE: [S02]
        // [S02]: "each part can be run separately, or all at once". The
        // dispatch mechanism is implicit-by-params (covered by the
        // "(or equivalent flag)" clause in the spec's Pass-when): with
        // only --fastq_folder set, the workflow runs Part A and
        // returns before Part B/Part C wiring is reached. Part B and C
        // standalone modes are already covered by sibling tests above.
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data"
                fastq_pattern  = "/paired_merge_ok_{1,2}.fastq.gz"
                threads        = 1
                // project_name / fasta_folder / occurrence_table
                // deliberately unset → Part A only.
            }
        }
        then {
            assert workflow.success
            def out = workflow.stdout.toString()

            // Every Part A process appears in the trace.
            ["merge_fastq_pairs",
             "trim_primers",
             "filter_and_convert_to_fasta",
             "dereplicate_fasta",
             "list_local_clusters"].each { proc ->
                assert out.contains(proc) :
                    "expected Part A's ${proc} to run, got: ${out}"
            }

            // No Part B / Part C process is wired when project_name,
            // fasta_folder, and occurrence_table are all unset.
            ["global_dereplication",
             "global_clustering",
             "build_occurrence_table",
             "cleaving",
             "run_mumu",
             "rebuild_post_mumu_table",
             "discover_part_b_fasta",
             "assign_taxonomy_stampa",
             "assign_taxonomy_sintax",
             "update_occurrence_table"].each { proc ->
                assert !out.contains(proc) :
                    "Part A-only run must not invoke ${proc}, got: ${out}"
            }
        }
    }

    test("plain / .gz / .bz2 inputs produce byte-identical Part A outputs") {
        // COVERAGE: [S03]
        // [S03]: "the same input data in any of these forms produces
        // byte-identical Part A outputs". The compression_variants
        // fixture holds three identical-content pairs:
        //   cmp_plain_{1,2}.fastq    (no compression)
        //   cmp_gz_{1,2}.fastq.gz    (gzip)
        //   cmp_bz2_{1,2}.fastq.bz2  (bzip2)
        // After one Part A run, the three derived samples
        // (cmp_plain / cmp_gz / cmp_bz2) must publish identical
        // .fas, .qual and .stats files. The SHA1 IDs are computed
        // from the sequence content, which is the same across the
        // three pairs, so byte-identity is the spec-mandated outcome.
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "${projectDir}/tests/data/compression_variants"
                outdir         = "${outputDir}/a_compress"
                fastq_pattern  = ""
                threads        = 1
            }
        }
        then {
            assert workflow.success
            def folder = "${outputDir}/a_compress/per_sample"

            // every sample published the three per-sample artefacts.
            ["cmp_plain", "cmp_gz", "cmp_bz2"].each { sampleId ->
                ["fas", "qual", "stats"].each { ext ->
                    def artefact = file("${folder}/${sampleId}.${ext}")
                    assert artefact.exists() :
                        "missing per-sample ${ext} for ${sampleId}: ${artefact}"
                }
            }

            // [S03] core assertion: outputs are byte-identical across
            // the three compression variants.
            ["fas", "qual", "stats"].each { ext ->
                def plain = file("${folder}/cmp_plain.${ext}").bytes
                def gz    = file("${folder}/cmp_gz.${ext}").bytes
                def bz2   = file("${folder}/cmp_bz2.${ext}").bytes
                assert plain == gz :
                    "[S03] cmp_plain.${ext} differs from cmp_gz.${ext}"
                assert plain == bz2 :
                    "[S03] cmp_plain.${ext} differs from cmp_bz2.${ext}"
            }
        }
    }
}
