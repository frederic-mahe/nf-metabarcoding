nextflow_function {

    name "check_numeric_param"
    script "modules/local/functions.nf"
    function "check_numeric_param"

    // [S72]: range validation of numeric parameters. check_numeric_param
    // is the pure, table-driven core (name + value in, value out, or a
    // throw naming the parameter); validate_numeric_params() is the
    // params-reading wrapper called from validate_params(). The
    // message-propagation / wiring contract is covered at the
    // integration level in tests/main.nf.test.

    // ---- valid values pass through unchanged --------------------------
    test("fastq_encoding 64 is accepted") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'fastq_encoding'
            input[1] = 64
        """ } }
        then {
            assert function.success
            assert function.result == 64
        }
    }

    test("threads at the lower bound (1) and upper bound (256) are accepted") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'threads'
            input[1] = 256
        """ } }
        then { assert function.success }
    }

    test("percentage at the inclusive upper bound (1.0) is accepted") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'percentage'
            input[1] = 1.0
        """ } }
        then { assert function.success }
    }

    test("the no-split / no-limit sentinel 0 is accepted for stampa knobs") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'stampa_chunk_size'
            input[1] = 0
        """ } }
        then { assert function.success }
    }

    test("stripright 0 (trim disabled) is accepted") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'stripright'
            input[1] = 0
        """ } }
        then { assert function.success }
    }

    test("iddef boundaries 0 and 4 are accepted") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'iddef'
            input[1] = 4
        """ } }
        then { assert function.success }
    }

    test("stampa_id at the inclusive bounds (0.0) is accepted") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'stampa_id'
            input[1] = 0.0
        """ } }
        then { assert function.success }
    }

    // ---- out-of-range values abort ------------------------------------
    test("fastq_encoding rejects a value outside {33,64}") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'fastq_encoding'
            input[1] = 32
        """ } }
        then { assert !function.success }
    }

    test("threads rejects 0 (below the minimum)") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'threads'
            input[1] = 0
        """ } }
        then { assert !function.success }
    }

    test("threads rejects 257 (above the 256 cap)") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'threads'
            input[1] = 257
        """ } }
        then { assert !function.success }
    }

    test("percentage rejects 0 (lower bound is exclusive)") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'percentage'
            input[1] = 0
        """ } }
        then { assert !function.success }
    }

    test("percentage rejects a value above 1") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'percentage'
            input[1] = 1.5
        """ } }
        then { assert !function.success }
    }

    test("chimera_minsize rejects 0 (minimum is 1)") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'chimera_minsize'
            input[1] = 0
        """ } }
        then { assert !function.success }
    }

    test("stripright rejects a negative value") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'stripright'
            input[1] = -1
        """ } }
        then { assert !function.success }
    }

    test("iddef rejects 5 (above the vsearch 0..4 range)") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'iddef'
            input[1] = 5
        """ } }
        then { assert !function.success }
    }

    test("iddef rejects a non-integer") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'iddef'
            input[1] = 2.5
        """ } }
        then { assert !function.success }
    }

    test("stampa_maxrejects rejects a negative value") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'stampa_maxrejects'
            input[1] = -1
        """ } }
        then { assert !function.success }
    }

    test("stampa_id rejects a value above 1") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'stampa_id'
            input[1] = 1.5
        """ } }
        then { assert !function.success }
    }

    test("sintax_cutoff rejects an out-of-range value (e.g. 90 instead of 0.9)") {
        // COVERAGE: [S72]
        tag "ci"
        when { function { """
            input[0] = 'sintax_cutoff'
            input[1] = 90
        """ } }
        then { assert !function.success }
    }
}
