nextflow_function {

    name "vsearch_version_error"
    script "modules/local/functions.nf"
    function "vsearch_version_error"

    // [S136] (D25): vsearch older than 2.32.0 rejects quality scores
    // above 41 ([S106]). The function reads the first line of
    // `vsearch --version` and returns null when the version is at
    // least 2.32.0, an error message otherwise. Components are
    // compared as numbers: 2.9.1 is older, 2.100.0 newer.

    test("the minimum version passes") {
        // COVERAGE: [S136]
        tag "pending"
        when { function { """
            input[0] = "vsearch v2.32.0_linux_x86_64, 123.0GB RAM, 24 cores"
        """ } }
        then {
            assert function.success
            assert function.result == null
        }
    }

    test("newer versions pass, compared as numbers") {
        // COVERAGE: [S136]
        tag "pending"
        when { function { """
            input[0] = "vsearch v2.32.1_linux_x86_64"
        """ } }
        then {
            assert function.success
            assert function.result == null
        }
    }

    test("a two-digit minor version is newer") {
        // COVERAGE: [S136]
        tag "pending"
        when { function { """
            input[0] = "vsearch v2.100.0_linux_aarch64, 8.0GB RAM, 4 cores"
        """ } }
        then {
            assert function.success
            assert function.result == null
        }
    }

    test("a missing patch number counts as zero") {
        // COVERAGE: [S136]
        tag "pending"
        when { function { """
            input[0] = "vsearch v3.0_macos_x86_64"
        """ } }
        then {
            assert function.success
            assert function.result == null
        }
    }

    test("an older version is rejected with the version found") {
        // COVERAGE: [S136]
        tag "pending"
        when { function { """
            input[0] = "vsearch v2.31.0_linux_x86_64, 64.0GB RAM, 16 cores"
        """ } }
        then {
            assert function.success
            assert function.result ==
                "vsearch 2.31.0 found, but nf-metabarcoding needs vsearch " +
                "2.32.0 or newer (older versions reject quality scores " +
                "above 41). Use -profile conda or a container profile " +
                "(e.g. -profile apptainer)."
        }
    }

    test("a one-digit minor version is older, not newer") {
        // COVERAGE: [S136]
        // A string comparison would rank "2.9.1" above "2.32.0".
        tag "pending"
        when { function { """
            input[0] = "vsearch v2.9.1_linux_x86_64"
        """ } }
        then {
            assert function.success
            assert function.result ==
                "vsearch 2.9.1 found, but nf-metabarcoding needs vsearch " +
                "2.32.0 or newer (older versions reject quality scores " +
                "above 41). Use -profile conda or a container profile " +
                "(e.g. -profile apptainer)."
        }
    }

    test("an empty version line is reported as unreadable") {
        // COVERAGE: [S136]
        tag "pending"
        when { function { """
            input[0] = ""
        """ } }
        then {
            assert function.success
            assert function.result ==
                "vsearch version could not be read (is vsearch installed?); " +
                "nf-metabarcoding needs vsearch 2.32.0 or newer. Use " +
                "-profile conda or a container profile (e.g. -profile apptainer)."
        }
    }

    test("a missing vsearch is reported as unreadable") {
        // COVERAGE: [S136]
        tag "pending"
        when { function { """
            input[0] = "bash: line 1: vsearch: command not found"
        """ } }
        then {
            assert function.success
            assert function.result ==
                "vsearch version could not be read (is vsearch installed?); " +
                "nf-metabarcoding needs vsearch 2.32.0 or newer. Use " +
                "-profile conda or a container profile (e.g. -profile apptainer)."
        }
    }
}
