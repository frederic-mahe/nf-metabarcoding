nextflow_process {

    name "extract_expected_error_values"
    script "main.nf"
    process "extract_expected_error_values"

    setup {
        run("merge_fastq_pairs") {
            script "main.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        run("trim_primers") {
            script "main.nf"
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
        run("convert_fastq_to_fasta") {
            script "main.nf"
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                """
            }
        }
    }

    test("emits one .qual line per unique sequence, keeping the lowest ee") {
        // COVERAGE: [S01]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "tests/data"
            }
            process {
                """
                input[0] = convert_fastq_to_fasta.out[0]
                input[1] = convert_fastq_to_fasta.out[1]
                """
            }
        }
        then {
            assert process.success

            // column layout: <SHA1> <ee> <length>, space-separated
            def lines = path(process.out[1].get(0)).readLines()
            assert lines.size() > 0 : "expected at least one .qual line"
            lines.each { line ->
                def cols = line.split(' ')
                assert cols.size() == 3 : "expected 3 columns, got: ${line}"
                assert cols[0] ==~ /[0-9a-f]{40}/ : "expected 40-char SHA1 hex in column 1: ${line}"
                assert cols[1] ==~ /[0-9.]+/      : "expected ee float in column 2: ${line}"
                assert cols[2] ==~ /\d+/          : "expected integer length in column 3: ${line}"
            }

            // TODO: assert duplicate SHA1s are collapsed to the lowest ee
            // TODO: assert sort order matches the spec (length asc, id asc, ee asc)
        }
    }
}
