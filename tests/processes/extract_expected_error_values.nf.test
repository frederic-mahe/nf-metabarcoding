nextflow_process {

    name "extract_expected_error_values"
    script "main.nf"
    process "extract_expected_error_values"

    setup {
        run("merge_fastq_pairs") {
            script "main.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        run("trim_primers") {
            script "main.nf"
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
        run("convert_fastq_to_fasta") {
            script "main.nf"
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                """
            }
        }
    }

    test("emits one .qual line per unique sequence, keeping the lowest ee") {
        // COVERAGE: [S01]
        tag "ci"
        when {
            process {
                """
                input[0] = convert_fastq_to_fasta.out[0]
                input[1] = convert_fastq_to_fasta.out[1]
                """
            }
        }
        then {
            assert process.success
            // TODO: assert column layout is <SHA1> <ee> <length>
            // TODO: assert duplicate SHA1s are collapsed to the lowest ee
            // TODO: assert sort order matches the spec (length asc, id asc, ee asc)
        }
    }
}
