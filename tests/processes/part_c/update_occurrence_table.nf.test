nextflow_process {

    name "update_occurrence_table"
    script "modules/local/part_c/update_occurrence_table.nf"
    process "update_occurrence_table"

    test("splices the taxonomy columns onto the occurrence table") {
        // COVERAGE: [S51]
        // D04 sub-question 2 resolution (2026-05-19): publish a
        // sibling file `<basename>_table_assigned.tsv` rather than
        // overwriting Part B's `<basename>_table.tsv`. This test
        // pins both the join behaviour (rows whose amplicon ID
        // appears in the assignments file get their identity /
        // taxonomy / references columns overwritten; rows missing
        // from the assignments pass through unchanged) and the
        // output filename.
        tag "ci"
        when {
            process {
                """
                def t = workDir.resolve("input_table.tsv")
                t.text = '''OTU\\ttotal\\tcloud\\tamplicon\\tlength\\tabundance\\tchimera\\tspread\\tquality\\tsequence\\tidentity\\ttaxonomy\\treferences\\ts1
1\\t10\\tNA\\tamp1\\t10\\t10\\tN\\t1\\t0.001\\tACGTACGTAC\\t0.0\\tNA\\tNA\\t10
2\\t5\\tNA\\tamp2\\t10\\t5\\tN\\t1\\t0.001\\tTTTTTTTTTT\\t0.0\\tNA\\tNA\\t5
'''
                def a = workDir.resolve("assignments")
                a.text = 'amp1\\t10\\t99.0\\tBacteria|Firmicutes\\trefA\\n'
                input[0] = file(t.toString())
                input[1] = file(a.toString())
                input[2] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success
            def out = process.out[0].get(0)
            assert out.endsWith("proj_3_samples_table_assigned.tsv") :
                "expected <basename>_table_assigned.tsv, got: ${out}"
            def lines = path(out).readLines()
            assert lines.size() == 3   // header + 2 rows
            def row1 = lines[1].split("\t", -1)
            assert row1[10] == "99.0"       // identity overwritten
            assert row1[11] == "Bacteria|Firmicutes"
            assert row1[12] == "refA"
            // amp2 missing from assignments → passthrough.
            def row2 = lines[2].split("\t", -1)
            assert row2[11] == "NA"
        }
    }

    test("leaves the input occurrence table untouched") {
        // COVERAGE: [S51]
        // [S51] guarantees Part C is non-destructive: the input
        // `_table.tsv` is not modified — the annotated table is a
        // sibling, not an overwrite. A regression that switched to
        // an in-place update (e.g. `sed -i` instead of stdout
        // redirection) would not be caught by the join assertions
        // above. Stash the input's bytes before the process runs and
        // compare after.
        tag "ci"
        setup {
            def t = file("${outputDir}/persisted_input_table.tsv")
            t.parentFile.mkdirs()
            t.text = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\t" +
                "chimera\tspread\tquality\tsequence\tidentity\t" +
                "taxonomy\treferences\ts1\n" +
                "1\t10\tNA\tamp1\t10\t10\tN\t1\t0.001\tACGTACGTAC" +
                "\t0.0\tNA\tNA\t10\n"
            )
            def a = file("${outputDir}/persisted_assignments")
            a.text = "amp1\t10\t99.0\tBacteria|Firmicutes\trefA\n"
        }
        when {
            process {
                """
                input[0] = file("${outputDir}/persisted_input_table.tsv")
                input[1] = file("${outputDir}/persisted_assignments")
                input[2] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success
            // The input file on disk must be byte-identical to what
            // setup{} wrote — neither truncated, rewritten, nor
            // appended to.
            def expected = (
                "OTU\ttotal\tcloud\tamplicon\tlength\tabundance\t" +
                "chimera\tspread\tquality\tsequence\tidentity\t" +
                "taxonomy\treferences\ts1\n" +
                "1\t10\tNA\tamp1\t10\t10\tN\t1\t0.001\tACGTACGTAC" +
                "\t0.0\tNA\tNA\t10\n"
            )
            def actual = file("${outputDir}/persisted_input_table.tsv").text
            assert actual == expected :
                "Part C must not modify its input table. Got:\n${actual}\nExpected:\n${expected}"
        }
    }
}
