nextflow_process {

    name "assign_taxonomy_stampa"
    script "modules/local/part_c/assign_taxonomy_stampa.nf"
    process "assign_taxonomy_stampa"

    test("runs vsearch --usearch_global + stampa_merge.py on a single chunk") {
        // COVERAGE: [S49]
        // [S49] (revised, 2026-05-19): assign_taxonomy_stampa is the
        // per-chunk step of a scatter-gather. It consumes one fasta
        // chunk + the reference and emits one stampa_chunk.tsv slice;
        // the workflow uses splitFasta/collectFile around it. The
        // basename input is gone — the gather step (collectFile)
        // owns the final filename.
        //
        // Real-world LCA correctness is pinned by the pytest suite
        // (test_stampa_merge.py).
        tag "ci"
        when {
            params {
                threads = 1
                iddef   = 1
            }
            process {
                """
                def reps = workDir.resolve("reps.fas")
                reps.text = '>amp1;size=10;\\nACGTACGTACGTACGTACGTACGTACGTACGT\\n'
                def ref = workDir.resolve("reference.fas")
                ref.text = '>refA Kingdom|Phylum|Class\\nACGTACGTACGTACGTACGTACGTACGTACGT\\n'
                input[0] = file(reps.toString())
                input[1] = file(ref.toString())
                """
            }
        }
        then {
            assert process.success
            def chunk_tsv = process.out[0].get(0)
            assert chunk_tsv.endsWith("stampa_chunk.tsv") :
                "expected stampa_chunk.tsv, got: ${chunk_tsv}"
            def rows = path(chunk_tsv).readLines()
            assert rows.size() >= 1
            // expected shape: amplicon\tabundance\tidentity\ttaxonomy\treferences
            def fields = rows[0].split("\t")
            assert fields.size() == 5
            assert fields[0] == "amp1"
            assert fields[1] == "10"
        }
    }

    test("respects --stampa_id override (No_hit when threshold is too strict)") {
        // COVERAGE: [S49]
        // Pins the wiring of params.stampa_id onto vsearch's --id flag.
        // Fixture: 80-nt non-repetitive sequences (the periodic ACGT
        // pattern used in the smoke test above is too low-complexity
        // for vsearch's default --minwordmatches 12 seeding). The
        // query shares its first 67 nt with the reference and ends in
        // 13 `G`s; vsearch reports ~87.7% identity. Under the default
        // --stampa_id=0.5 vsearch returns the reference as the top
        // hit; raising --stampa_id to 0.95 pushes the alignment below
        // threshold and stampa_merge.py emits "No_hit".
        tag "ci"
        when {
            params {
                threads   = 1
                iddef     = 1
                stampa_id = 0.95
            }
            process {
                """
                def REF = 'ACGGAATTCAGTATTCGATGCAATCAGTAGCATGCAGTTAATCGATGCATTAGCATGCAGTCATGCAATCGAGCATTAGC'
                def QRY = 'ACGGAATTCAGTATTCGATGCAATCAGTAGCATGCAGTTAATCGATGCATTAGCATGCAGTCATGCAAGGGGGGGGGGGGG'
                def reps = workDir.resolve("reps.fas")
                reps.text = '>amp1;size=10;\\n' + QRY + '\\n'
                def ref = workDir.resolve("reference.fas")
                ref.text = '>refA Kingdom|Phylum|Class\\n' + REF + '\\n'
                input[0] = file(reps.toString())
                input[1] = file(ref.toString())
                """
            }
        }
        then {
            assert process.success
            def chunk_tsv = process.out[0].get(0)
            def rows = path(chunk_tsv).readLines()
            assert rows.size() == 1
            def fields = rows[0].split("\t", -1)
            assert fields[3] == "No_hit" :
                "stampa_id=0.95 should reject a 87.5%-identity hit, got: ${rows[0]}"
            assert fields[4] == "No_hit" :
                "expected No_hit accession when threshold rejects the hit, got: ${rows[0]}"
        }
    }

    test("respects --stampa_maxrejects override (param threads through to vsearch)") {
        // COVERAGE: [S49]
        // The behavioural effect of --maxrejects only shows up against
        // a reference dataset large enough that vsearch would stop
        // scanning before finding the true best hit. That is hard to
        // express as a tiny fixture, so this test pins the *wiring* —
        // setting params.stampa_maxrejects to a small non-default
        // value must not break the process and must still produce the
        // expected top hit on a single-reference DB.
        tag "ci"
        when {
            params {
                threads            = 1
                iddef              = 1
                stampa_maxrejects  = 1
            }
            process {
                """
                def reps = workDir.resolve("reps.fas")
                reps.text = '>amp1;size=10;\\nACGTACGTACGTACGTACGTACGTACGTACGT\\n'
                def ref = workDir.resolve("reference.fas")
                ref.text = '>refA Kingdom|Phylum|Class\\nACGTACGTACGTACGTACGTACGTACGTACGT\\n'
                input[0] = file(reps.toString())
                input[1] = file(ref.toString())
                """
            }
        }
        then {
            assert process.success
            def chunk_tsv = process.out[0].get(0)
            def rows = path(chunk_tsv).readLines()
            assert rows.size() == 1
            def fields = rows[0].split("\t", -1)
            assert fields[3] == "Kingdom|Phylum|Class" :
                "expected the single ref to be the top hit, got: ${rows[0]}"
        }
    }
}
