nextflow_process {

    name "assign_taxonomy_stampa"
    script "main.nf"
    process "assign_taxonomy_stampa"

    test("runs vsearch --usearch_global + stampa_merge.py on a tiny reference") {
        // COVERAGE: [S49]
        // Skeleton phase: this exercises the process wiring end-to-
        // end against a 2-sequence reference dataset so we know
        // vsearch's command line and bin/stampa_merge.py's invocation
        // glue work. The LCA correctness is pinned by the pytest
        // suite (test_stampa_merge.py).
        tag "ci"
        when {
            params {
                threads = 1
                iddef   = 1
            }
            process {
                """
                def reps = workDir.resolve("reps.fas")
                reps.text = '>amp1;size=10;\\nACGTACGTACGTACGTACGTACGTACGTACGT\\n'
                def ref = workDir.resolve("reference.fas")
                ref.text = '>refA Kingdom|Phylum|Class\\nACGTACGTACGTACGTACGTACGTACGTACGT\\n'
                input[0] = file(reps.toString())
                input[1] = file(ref.toString())
                input[2] = "proj_1_samples"
                """
            }
        }
        then {
            assert process.success
            def assignments = process.out[0].get(0)
            def log = process.out[1].get(0)
            assert assignments.endsWith("proj_1_samples_taxonomy_stampa.tsv")
            assert log.endsWith("proj_1_samples_taxonomy.log")
            def rows = path(assignments).readLines()
            assert rows.size() >= 1
            // expected shape: amplicon\tabundance\tidentity\ttaxonomy\treferences
            def fields = rows[0].split("\t")
            assert fields.size() == 5
            assert fields[0] == "amp1"
            assert fields[1] == "10"
        }
    }
}
