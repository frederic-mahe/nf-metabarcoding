nextflow_process {

    name "assign_taxonomy_sintax"
    script "modules/local/part_c/assign_taxonomy_sintax.nf"
    process "assign_taxonomy_sintax"

    test("reshapes vsearch --sintax output: column 2 (bootstrap lineage) becomes taxonomy") {
        // COVERAGE: [S50], [S61]
        // [S50] revised (2026-05-21): the path lifts vsearch's
        // tabbed-output column 2 (lineage with bootstrap, e.g.
        // `d:Bacteria(1.00),p:Proteobacteria(0.95)`) into the
        // canonical assignments TSV's `taxonomy` column. `identity`
        // and `references` stay at placeholder values (`0.0` / `NA`).
        // That canonical 5-column file is the unpublished
        // `<basename>_assignments_sintax.tsv` intermediate consumed by
        // update_occurrence_table; the process additionally emits the
        // published `<basename>_taxonomy_sintax.tsv` carrying vsearch's
        // verbatim 4-column --tabbedout under a header ([S61]).
        //
        // The fixture uses an 80-nt non-periodic sequence: sintax
        // samples 8-mers and needs enough unique kmers to bootstrap a
        // confident lineage — short or periodic sequences come back
        // unclassified (col 2 empty), exercised by the second test.
        tag "ci"
        when {
            params {
                threads       = 1
                sintax_cutoff = 0.9
            }
            process {
                """
                def SEQ = 'ACGGAATTCAGTATTCGATGCAATCAGTAGCATGCAGTTAATCGATGCATTAGCATGCAGTCATGCAATCGAGCATTAGC'
                def reps = workDir.resolve("reps.fas")
                reps.text = '>amp1;size=10;\\n' + SEQ + '\\n'
                def ref = workDir.resolve("reference.fas")
                ref.text = '>refA;tax=d:Bacteria,p:Proteobacteria,c:Gammaproteobacteria;\\n' + SEQ + '\\n'
                input[0] = file(reps.toString())
                input[1] = file(ref.toString())
                input[2] = "proj_1_samples_notmerged"
                """
            }
        }
        then {
            assert process.success
            def assignments = process.out.taxonomy.get(0)
            assert assignments.endsWith("proj_1_samples_notmerged_assignments_sintax.tsv") :
                "expected the canonical <basename>_assignments_sintax.tsv intermediate, got: ${assignments}"
            def log = process.out.log.get(0)
            assert log.endsWith("proj_1_samples_notmerged_taxonomy.log") :
                "expected <basename>_taxonomy.log, got: ${log}"

            def rows = path(assignments).readLines()
            assert rows.size() == 1 :
                "expected one row per query, got: ${rows}"
            def fields = rows[0].split("\t", -1)
            assert fields.size() == 5 :
                "expected 5-column TSV (amplicon\\tabundance\\tidentity\\ttaxonomy\\treferences), got: ${rows[0]}"
            assert fields[0] == "amp1" :
                "expected amplicon=amp1, got: ${fields[0]}"
            assert fields[1] == "10" :
                "expected abundance=10 (parsed from ;size=10;), got: ${fields[1]}"
            assert fields[2] == "0.0" :
                "expected identity placeholder 0.0, got: ${fields[2]}"
            // Taxonomy column = vsearch tabbed-output column 2:
            // bootstrap-annotated lineage like `d:Bacteria(1.00),...`
            assert fields[3].contains("d:Bacteria") :
                "expected taxonomy to carry the sintax lineage (column 2), got: ${fields[3]}"
            assert fields[3] =~ /\([0-9.]+\)/ :
                "expected bootstrap parens in taxonomy, got: ${fields[3]}"
            assert fields[4] == "NA" :
                "expected references placeholder NA, got: ${fields[4]}"

            // [S61]: the published standalone table keeps vsearch's
            // verbatim 4-column --tabbedout layout under a header row.
            def published = process.out.published.get(0)
            assert published.endsWith("proj_1_samples_notmerged_taxonomy_sintax.tsv") :
                "expected the published <basename>_taxonomy_sintax.tsv, got: ${published}"
            def plines = path(published).readLines().findAll { it.trim() }
            assert plines[0] == "query\ttaxonomy\tstrand\tcutoff_taxonomy" :
                "expected the manpage-derived 4-column header, got: ${plines[0]}"
            assert plines.size() == 2 :
                "expected header + one query row, got: ${plines}"
            def pfields = plines[1].split("\t", -1)
            assert pfields.size() == 4 :
                "expected vsearch's 4-column --tabbedout, got: ${plines[1]}"
            assert pfields[0].startsWith("amp1;size=10;") :
                "col 1 must be vsearch's verbatim query label, got: ${pfields[0]}"
            assert pfields[1].contains("d:Bacteria") :
                "col 2 must carry the bootstrap-annotated lineage, got: ${pfields[1]}"
        }
    }

    test("params.sintax_cutoff threads through to vsearch --sintax_cutoff") {
        // COVERAGE: [S50]
        // [S50] specifies the process lifts vsearch's tabbed-output
        // column 2 (the unfiltered bootstrap-annotated lineage), so
        // params.sintax_cutoff does NOT change the taxonomy column
        // value — it only affects vsearch's internal col-4 lineage
        // (which the process ignores). The wiring is therefore only
        // observable through vsearch's own --log echo of the full
        // command line. A hard-coded cutoff or a dropped param would
        // leave the default value in the log and fail this assertion.
        tag "ci"
        when {
            params {
                threads       = 1
                sintax_cutoff = 0.93   // non-default sentinel
            }
            process {
                """
                def SEQ = 'ACGGAATTCAGTATTCGATGCAATCAGTAGCATGCAGTTAATCGATGCATTAGCATGCAGTCATGCAATCGAGCATTAGC'
                def reps = workDir.resolve("reps.fas")
                reps.text = '>amp1;size=10;\\n' + SEQ + '\\n'
                def ref = workDir.resolve("reference.fas")
                ref.text = '>refA;tax=d:Bacteria,p:Proteobacteria;\\n' + SEQ + '\\n'
                input[0] = file(reps.toString())
                input[1] = file(ref.toString())
                input[2] = "proj_1_samples_notmerged"
                """
            }
        }
        then {
            assert process.success
            def log = path(process.out.log.get(0)).text
            assert log.contains("--sintax_cutoff 0.93") :
                "expected vsearch log to echo --sintax_cutoff 0.93 from params, got:\n${log}"
        }
    }

    test("emits NA in the taxonomy column when sintax produces no classification") {
        // COVERAGE: [S50]
        // Short / low-complexity sequences come back unclassified from
        // sintax — vsearch's tabbed output has an empty column 2 for
        // that query. The reshape must turn the empty cell into the
        // canonical `NA` placeholder so the assignments TSV stays
        // 5-column tidy and update_occurrence_table can pass the row
        // through unchanged.
        tag "ci"
        when {
            params {
                threads       = 1
                sintax_cutoff = 0.9
            }
            process {
                """
                def reps = workDir.resolve("reps.fas")
                reps.text = '>amp1;size=10;\\nACGTACGTACGTACGTACGTACGTACGTACGT\\n'
                def ref = workDir.resolve("reference.fas")
                ref.text = '>refA;tax=d:Bacteria,p:Proteobacteria;\\nACGTACGTACGTACGTACGTACGTACGTACGT\\n'
                input[0] = file(reps.toString())
                input[1] = file(ref.toString())
                input[2] = "proj_1_samples_notmerged"
                """
            }
        }
        then {
            assert process.success
            def assignments = process.out.taxonomy.get(0)
            def rows = path(assignments).readLines()
            assert rows.size() == 1 :
                "expected one passthrough row even when unclassified, got: ${rows}"
            def fields = rows[0].split("\t", -1)
            assert fields.size() == 5
            assert fields[0] == "amp1"
            assert fields[1] == "10"
            assert fields[3] == "NA" :
                "empty sintax col 2 → taxonomy must be NA, got: ${fields[3]}"
        }
    }

    test("params.sintax_randseed threads through to vsearch --randseed") {
        // COVERAGE: [S91]
        // [S91] wires params.sintax_randseed to vsearch's --randseed so a
        // non-zero value makes the sintax bootstrap reproducible. Like
        // sintax_cutoff, the wiring is observable through vsearch's own
        // --log echo of the full command line — the seed does not change
        // this fixture's single confident assignment, only run-to-run
        // determinism. A dropped param or a hard-coded seed would leave a
        // different value in the log and fail this assertion.
        tag "ci"
        when {
            params {
                threads         = 1
                sintax_cutoff   = 0.9
                sintax_randseed = 42   // non-default sentinel
            }
            process {
                """
                def SEQ = 'ACGGAATTCAGTATTCGATGCAATCAGTAGCATGCAGTTAATCGATGCATTAGCATGCAGTCATGCAATCGAGCATTAGC'
                def reps = workDir.resolve("reps.fas")
                reps.text = '>amp1;size=10;\\n' + SEQ + '\\n'
                def ref = workDir.resolve("reference.fas")
                ref.text = '>refA;tax=d:Bacteria,p:Proteobacteria;\\n' + SEQ + '\\n'
                input[0] = file(reps.toString())
                input[1] = file(ref.toString())
                input[2] = "proj_1_samples_notmerged"
                """
            }
        }
        then {
            assert process.success
            def log = path(process.out.log.get(0)).text
            assert log.contains("--randseed 42") :
                "expected vsearch log to echo --randseed 42 from params, got:\n${log}"
        }
    }
}
