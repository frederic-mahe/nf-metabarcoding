nextflow_process {

    name "list_local_clusters"
    script "main.nf"
    process "list_local_clusters"

    setup {
        run("merge_fastq_pairs") {
            script "main.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        run("trim_primers") {
            script "main.nf"
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
        run("convert_fastq_to_fasta") {
            script "main.nf"
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                """
            }
        }
        run("dereplicate_fasta") {
            script "main.nf"
            process {
                """
                input[0] = convert_fastq_to_fasta.out[0]
                input[1] = convert_fastq_to_fasta.out[1]
                """
            }
        }
    }

    test("keeps only clusters with more than 2 reads") {
        when {
            process {
                """
                input[0] = dereplicate_fasta.out[0]
                input[1] = dereplicate_fasta.out[1]
                """
            }
        }
        then {
            assert process.success
            // TODO: assert every row in the .stats output has column 2 > 2
            // TODO: assert clusters with <=2 reads are absent
            // TODO: confirm the --fastidious flag is not used (per process comment)
        }
    }
}
