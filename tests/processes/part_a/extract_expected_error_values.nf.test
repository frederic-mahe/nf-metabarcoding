nextflow_process {

    name "extract_expected_error_values"
    script "main.nf"
    process "extract_expected_error_values"

    setup {
        run("merge_fastq_pairs") {
            script "main.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        run("trim_primers") {
            script "main.nf"
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
        run("filter_and_convert_to_fasta") {
            script "main.nf"
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                """
            }
        }
    }

    test("emits one .qual line per unique sequence, keeping the lowest ee") {
        // COVERAGE: [S01]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "tests/data"
            }
            process {
                """
                input[0] = filter_and_convert_to_fasta.out[0]
                input[1] = filter_and_convert_to_fasta.out[1]
                """
            }
        }
        then {
            assert process.success

            // Part A → Part B contract (see "Interfaces between parts"
            // in SPECIFICATIONS.md): space-separated `<SHA1> <ee> <length>`
            // sorted by length / SHA1 / ee, one row per unique SHA1.
            def lines = path(process.out[1].get(0)).readLines()
            assert lines.size() > 0 : "expected at least one .qual line"
            lines.each { line ->
                def cols = line.split(' ')
                assert cols.size() == 3 : "expected 3 columns, got: ${line}"
                assert cols[0] ==~ /[0-9a-f]{40}/ : "expected 40-char SHA1 hex in column 1: ${line}"
                assert cols[1] ==~ /[0-9.]+/      : "expected ee float in column 2: ${line}"
                assert cols[2] ==~ /\d+/          : "expected integer length in column 3: ${line}"
            }

            // Uniqueness: every SHA1 appears at most once
            // (`uniq --check-chars=40` collapses duplicates onto the
            // lowest-ee row).
            def shas = lines.collect { it.split(' ')[0] }
            assert shas == shas.unique() :
                ".qual must have one row per unique SHA1, got duplicates in: ${shas}"

            // Sort order: primary by length asc, secondary by SHA1
            // ascii asc, tertiary by ee numeric asc. The fixture's
            // three reads have the same length after primer trimming,
            // so we assert (a) length is non-decreasing and (b) within
            // each length bucket, SHA1 is non-decreasing.
            for (int i = 1; i < lines.size(); i++) {
                def prev = lines[i - 1].split(' ')
                def cur  = lines[i].split(' ')
                def prevLen = prev[2] as int
                def curLen  = cur[2] as int
                assert prevLen <= curLen :
                    "length must be non-decreasing, got ${prevLen} then ${curLen}"
                if ( prevLen == curLen ) {
                    assert prev[0] <= cur[0] :
                        "within a length bucket, SHA1 must be non-decreasing: ${prev[0]} then ${cur[0]}"
                }
            }
        }
    }

    test("--hash_function md5 dedups by the 32-char name width") {
        // COVERAGE: [S65]
        // Fed a filtered fasta with 32-char (MD5-width) names where two
        // records share a name with different ee. The dedup must derive
        // uniq --check-chars from hash_function (32, not the SHA1 40):
        // at width 40 the trailing ee digits enter the comparison and
        // the duplicate names survive.
        tag "ci"
        when {
            params {
                // primers satisfy the file-level setup chain; this test
                // feeds the fixture below directly and ignores its output.
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                hash_function  = "md5"
                fastq_folder   = "tests/data"
            }
            process {
                """
                input[0] = "md5_sample"
                input[1] = file("\${projectDir}/tests/data/hash_function/md5_filtered.fas")
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out[1].get(0)).readLines()
            def shas = lines.collect { it.split(' ')[0] }
            assert shas == shas.unique() :
                "one row per unique MD5 name expected, got duplicates: ${shas}"
            lines.each { line ->
                assert line.split(' ')[0] ==~ /[0-9a-f]{32}/ :
                    "expected 32-char MD5 hex in column 1: ${line}"
            }
            // The shared name 'a*32' appears with ee 0.020000 and
            // 0.010000; the lower-ee row must be the survivor.
            def rowA = lines.find { it.startsWith("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") }
            assert rowA != null : "shared MD5 name missing from .qual"
            assert rowA.contains("0.010000") :
                "expected the lower-ee row to win, got: ${rowA}"
            assert lines.size() == 2 :
                "expected 2 unique names after dedup, got ${lines.size()}: ${lines}"
        }
    }
}
