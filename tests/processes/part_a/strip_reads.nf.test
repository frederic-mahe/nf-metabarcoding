nextflow_process {

    name "strip_reads"
    script "modules/local/part_a/strip_reads.nf"
    process "strip_reads"

    test("trims params.stripright bases from the 3' end of both reads") {
        // COVERAGE: [S24]
        tag "ci"
        when {
            params {
                stripright = 30
            }
            process {
                """
                input[0] = tuple(
                    "sample_fail",
                    file("\${projectDir}/tests/data/paired_merge_fail_1.fastq.gz"),
                    file("\${projectDir}/tests/data/paired_merge_fail_2.fastq.gz")
                )
                """
            }
        }
        then {
            assert process.success

            // raw reads are 70 nt; expect 40 nt after stripping 30
            def fwdLines = path(process.out.stripped.get(0)[1]).readLines()
            def revLines = path(process.out.stripped.get(0)[2]).readLines()
            assert fwdLines.size() > 0 && fwdLines.size() % 4 == 0 :
                "fwd fastq must be a multiple of 4 lines, got ${fwdLines.size()}"
            assert revLines.size() == fwdLines.size() :
                "fwd/rev streams must stay in sync"

            for (int i = 1; i < fwdLines.size(); i += 4) {
                assert fwdLines[i].length() == 40 :
                    "fwd: expected length 40, got ${fwdLines[i].length()}: ${fwdLines[i]}"
                assert revLines[i].length() == 40 :
                    "rev: expected length 40, got ${revLines[i].length()}: ${revLines[i]}"
                // quality string must match sequence length
                assert fwdLines[i + 2].length() == fwdLines[i].length() :
                    "fwd: quality length must match sequence length"
                assert revLines[i + 2].length() == revLines[i].length() :
                    "rev: quality length must match sequence length"
            }
        }
    }

    test("emits canonical 4-line fastq for both stripped streams") {
        // COVERAGE: [S54]
        // Regression guard for the vsearch --fastq_stripright output
        // shape (see [S54] rationale).
        tag "ci"
        when {
            params {
                stripright = 30
            }
            process {
                """
                input[0] = tuple(
                    "sample_fail",
                    file("\${projectDir}/tests/data/paired_merge_fail_1.fastq.gz"),
                    file("\${projectDir}/tests/data/paired_merge_fail_2.fastq.gz")
                )
                """
            }
        }
        then {
            assert process.success
            [process.out.stripped.get(0)[1], process.out.stripped.get(0)[2]].each { p ->
                def lines = path(p).readLines()
                if (lines.size() == 0) {
                    return
                }
                assert lines.size() % 4 == 0 :
                    "${p}: fastq must be a multiple of 4 lines, got ${lines.size()}"
                for (int i = 0; i < lines.size(); i += 4) {
                    assert lines[i].startsWith("@") :
                        "${p}: line ${i+1} must start with '@', got: ${lines[i]}"
                    assert lines[i + 2].startsWith("+") :
                        "${p}: line ${i+3} must start with '+', got: ${lines[i + 2]}"
                    assert lines[i + 1].length() == lines[i + 3].length() :
                        "${p}: record ${i/4}: sequence/quality length mismatch"
                }
            }
        }
    }

    test("stripright = 0 is a no-op (reads keep their original length)") {
        // COVERAGE: [S24]
        tag "ci"
        when {
            params {
                stripright = 0
            }
            process {
                """
                input[0] = tuple(
                    "sample_fail",
                    file("\${projectDir}/tests/data/paired_merge_fail_1.fastq.gz"),
                    file("\${projectDir}/tests/data/paired_merge_fail_2.fastq.gz")
                )
                """
            }
        }
        then {
            assert process.success
            def fwdLines = path(process.out.stripped.get(0)[1]).readLines()
            def revLines = path(process.out.stripped.get(0)[2]).readLines()
            for (int i = 1; i < fwdLines.size(); i += 4) {
                assert fwdLines[i].length() == 70 :
                    "fwd: expected original length 70, got ${fwdLines[i].length()}"
                assert revLines[i].length() == 70 :
                    "rev: expected original length 70, got ${revLines[i].length()}"
            }
        }
    }

    test("accepts maximum Phred+33 quality (Q93) reads") {
        // COVERAGE: [S106]
        // Both --fastx_filter passes must read Q93 ('~') input, which
        // vsearch rejects under its default --fastq_qmax 41. Success
        // with non-empty output proves --fastq_qmax 93 reached both
        // passes; --fastx_filter has no --fastq_qmaxout, so the Q93
        // scores also pass through to the stripped streams unchanged.
        tag "ci"
        when {
            params {
                stripright = 0
            }
            process {
                """
                input[0] = tuple(
                    "sample_hq",
                    file("\${projectDir}/tests/data/highqual_1.fastq.gz"),
                    file("\${projectDir}/tests/data/highqual_2.fastq.gz")
                )
                """
            }
        }
        then {
            assert process.success
            def fwd = path(process.out.stripped.get(0)[1]).readLines()
            def rev = path(process.out.stripped.get(0)[2]).readLines()
            assert fwd.size() == 4 && rev.size() == 4 :
                "expected one 4-line record per stream, got fwd=${fwd.size()} rev=${rev.size()}"
            assert fwd[3] ==~ /^~+$/ :
                "fwd quality must stay Q93 ('~'), got: ${fwd[3]}"
            assert rev[3] ==~ /^~+$/ :
                "rev quality must stay Q93 ('~'), got: ${rev[3]}"
        }
    }

    test("derives the quality ceiling from the encoding offset (offset 64)") {
        // COVERAGE: [S106]
        // Under fastq_encoding=64 the highest representable quality is
        // 126-64=62; the all-'~' fixture reads as Q62. A hardcoded
        // --fastq_qmax 93 would abort both passes (64 + 93 > 126), so
        // success proves each pass derives qmax as 126-offset.
        tag "ci"
        when {
            params {
                stripright     = 0
                fastq_encoding = 64
            }
            process {
                """
                input[0] = tuple(
                    "sample_hq64",
                    file("\${projectDir}/tests/data/highqual_1.fastq.gz"),
                    file("\${projectDir}/tests/data/highqual_2.fastq.gz")
                )
                """
            }
        }
        then {
            assert process.success
            def fwd = path(process.out.stripped.get(0)[1]).readLines()
            def rev = path(process.out.stripped.get(0)[2]).readLines()
            assert fwd.size() == 4 && rev.size() == 4 :
                "expected one 4-line record per stream, got fwd=${fwd.size()} rev=${rev.size()}"
            assert fwd[3] ==~ /^~+$/ :
                "fwd quality must stay at the Q62 ceiling ('~'), got: ${fwd[3]}"
            assert rev[3] ==~ /^~+$/ :
                "rev quality must stay at the Q62 ceiling ('~'), got: ${rev[3]}"
        }
    }
}
