nextflow_process {

    name "dereplicate_fasta"
    script "main.nf"
    process "dereplicate_fasta"

    setup {
        run("merge_fastq_pairs") {
            script "main.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        run("trim_primers") {
            script "main.nf"
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
        run("filter_and_convert_to_fasta") {
            script "main.nf"
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                input[2] = 0
                """
            }
        }
    }

    test("dereplicates and drops ee values") {
        // COVERAGE: [S01]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "tests/data"
            }
            process {
                """
                input[0] = filter_and_convert_to_fasta.out[0]
                input[1] = filter_and_convert_to_fasta.out[1]
                """
            }
        }
        then {
            assert process.success
            // TODO: assert headers carry `size=N` (--sizeout)
            // TODO: assert `ee=` is absent (--xee)
            // TODO: assert duplicate sequences are collapsed
        }
    }

    test("emits a per-sample dereplicating log") {
        // COVERAGE: [S19]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "tests/data"
            }
            process {
                """
                input[0] = filter_and_convert_to_fasta.out[0]
                input[1] = filter_and_convert_to_fasta.out[1]
                """
            }
        }
        then {
            assert process.success
            def logPath = process.out[2].get(0)
            assert logPath.endsWith("sample_ok_dereplicating.log") : "unexpected log path: ${logPath}"
            assert path(logPath).readLines().size() > 0 : "expected non-empty dereplicating log"
        }
    }
}
