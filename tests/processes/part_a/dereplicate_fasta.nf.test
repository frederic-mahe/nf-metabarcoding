nextflow_process {

    name "dereplicate_fasta"
    script "main.nf"
    process "dereplicate_fasta"

    setup {
        run("merge_fastq_pairs") {
            script "main.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        run("trim_primers") {
            script "main.nf"
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
        run("filter_and_convert_to_fasta") {
            script "main.nf"
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                input[2] = 0
                """
            }
        }
    }

    test("dereplicates and drops ee values") {
        // COVERAGE: [S01]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "tests/data"
            }
            process {
                """
                input[0] = filter_and_convert_to_fasta.out[0]
                input[1] = filter_and_convert_to_fasta.out[1]
                """
            }
        }
        then {
            assert process.success
            // Output contract (Part A → Part B): every record's header
            // is `>SHA1;size=N` with --sizeout and stripped of
            // `ee=` / `length=` (--xee / --xlength).
            def lines = path(process.out[1].get(0)).readLines()
            assert lines.size() > 0 : "expected at least one record"
            assert lines.size() % 2 == 0 :
                "fasta width=0 expected, got ${lines.size()} lines"
            def shas = []
            for (int i = 0; i < lines.size(); i += 2) {
                def header = lines[i]
                assert header ==~ /^>[0-9a-f]{40};size=\d+;?$/ :
                    "expected >SHA1;size=N, got: ${header}"
                assert !header.contains("ee=") :
                    "ee= must be stripped (--xee), got: ${header}"
                assert !header.contains("length=") :
                    "length= must be stripped (--xlength), got: ${header}"
                shas << header.replaceFirst(/^>/, '').split(';')[0]
            }
            // duplicate-sequence collapse: every emitted SHA1 is unique.
            assert shas == shas.unique() :
                "dereplication must produce one row per SHA1, got: ${shas}"
        }
    }

    test("emits single-line fasta from vsearch --fastx_uniques") {
        // COVERAGE: [S55]
        // Regression guard for the vsearch --fastx_uniques output
        // shape (--fasta_width 0). See [S55] rationale.
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "tests/data"
            }
            process {
                """
                input[0] = filter_and_convert_to_fasta.out[0]
                input[1] = filter_and_convert_to_fasta.out[1]
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out[1].get(0)).readLines()
            if (lines.size() == 0) {
                return
            }
            assert lines.size() % 2 == 0 :
                "fasta must be a multiple of 2 lines, got ${lines.size()}"
            for (int i = 0; i < lines.size(); i += 2) {
                assert lines[i].startsWith(">") :
                    "fasta line ${i+1} must start with '>', got: ${lines[i]}"
                assert !lines[i + 1].startsWith(">") :
                    "fasta line ${i+2} must be sequence data, got header: ${lines[i + 1]}"
            }
        }
    }

    test("emits a per-sample dereplicating log") {
        // COVERAGE: [S19]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "tests/data"
            }
            process {
                """
                input[0] = filter_and_convert_to_fasta.out[0]
                input[1] = filter_and_convert_to_fasta.out[1]
                """
            }
        }
        then {
            assert process.success
            def logPath = process.out[2].get(0)
            assert logPath.endsWith("sample_ok_dereplicating.log") : "unexpected log path: ${logPath}"
            assert path(logPath).readLines().size() > 0 : "expected non-empty dereplicating log"
        }
    }
}
