nextflow_process {

    name "mask_ns_for_swarm"
    script "main.nf"
    process "mask_ns_for_swarm"

    test("replaces N with U in sequence lines, leaves headers alone") {
        // COVERAGE: [S04]
        // [S04] step 4 was updated from N->A to N->U so the
        // substitution is losslessly reversible: U cannot appear in
        // Part A output sequences ([S52]), so the shadow Part B
        // restore step ([S56]) can do a literal U->N pass on swarm's
        // representatives without risking corruption of any natural
        // motif.
        tag "ci"
        when {
            process {
                """
                input[0] = "sample_notmerged"
                input[1] = file("\${projectDir}/tests/data/n_containing.fas")
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out[1].get(0)).readLines()

            assert lines.size() == 4 : "expected 4 lines (2 records), got ${lines.size()}"

            // header lines untouched (>seq1_with_Ns must keep its 'N's)
            assert lines[0] == ">seq1_with_Ns" : "header 1 was rewritten: ${lines[0]}"
            assert lines[2] == ">seq2_no_Ns"   : "header 2 was rewritten: ${lines[2]}"

            // sequence lines: every N -> U
            lines.eachWithIndex { line, i ->
                if (i % 2 == 1) {
                    assert !line.contains("N") :
                        "sequence line ${i} still contains N: ${line}"
                }
            }

            // padding of 8 Ns becomes 8 Us in seq1
            assert lines[1].contains("UUUUUUUU") :
                "expected 8 Us where the 8 Ns were, got: ${lines[1]}"
            assert !lines[1].contains("A".multiply(8)) :
                "no 8-run of As should be introduced; got: ${lines[1]}"
        }
    }
}
