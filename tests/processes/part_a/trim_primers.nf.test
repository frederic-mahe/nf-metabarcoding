nextflow_process {

    name "trim_primers"
    script "main.nf"
    process "trim_primers"

    setup {
        run("merge_fastq_pairs") {
            script "main.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
    }

    test("trims forward and reverse primers from merged reads") {
        // COVERAGE: [S01]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
            }
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
        then {
            assert process.success

            // every sequence line should be shorter than the 98-bp merged
            // input (20-bp forward + 18-bp reverse primer removed)
            def lines = path(process.out[1].get(0)).readLines()
            def seqs = []
            for (int i = 1; i < lines.size(); i += 4) {
                seqs.add(lines[i])
            }
            assert seqs.size() > 0 : "expected at least one trimmed read"
            seqs.each { seq ->
                assert seq.length() < 98 : "expected length < 98 after trimming, got ${seq.length()}: ${seq}"
            }

            // TODO: assert read count preserved (or `--max-n 0` discards expected)
        }
    }

    test("emits a per-sample trimming log") {
        // COVERAGE: [S19]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
            }
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
        then {
            assert process.success
            def logPath = process.out[2].get(0)
            assert logPath.endsWith("sample_ok_trimming.log") : "unexpected log path: ${logPath}"
            assert path(logPath).readLines().size() > 0 : "expected non-empty trimming log"
        }
    }
}
