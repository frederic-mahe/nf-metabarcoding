nextflow_process {

    name "trim_primers"
    script "modules/local/part_a/trim_primers.nf"
    process "trim_primers"

    setup {
        run("merge_fastq_pairs") {
            script "modules/local/part_a/merge_fastq_pairs.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
    }

    test("trims forward and reverse primers from merged reads") {
        // COVERAGE: [S01]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
            }
            process {
                """
                input[0] = merge_fastq_pairs.out.merged
                """
            }
        }
        then {
            assert process.success

            // The paired_merge_ok fixture carries 3 amplicons; every
            // amplicon flanked by the canonical forward + reverse
            // primer pair → cutadapt --discard-untrimmed keeps all
            // three. Read count must be preserved.
            def lines = path(process.out.trimmed.get(0)[1]).readLines()
            assert lines.size() == 12 :
                "expected 3 trimmed records (12 lines), got ${lines.size()}"

            // After trimming, every sequence is shorter than the 98-bp
            // amplicon (20 forward + 18 reverse primer removed). The
            // synthetic body is 60 nt; allow a few bp of slack on each
            // side to absorb cutadapt's 2/3 minimum-overlap matching.
            def seqs = []
            for (int i = 1; i < lines.size(); i += 4) {
                seqs.add(lines[i])
            }
            seqs.each { seq ->
                assert seq.length() <= 64 :
                    "expected length <= 64 (60 body + slack) after trimming, got ${seq.length()}: ${seq}"
                assert seq.length() >= 56 :
                    "expected length >= 56 (60 body - slack) after trimming, got ${seq.length()}: ${seq}"
                // The forward primer (with IUPAC ambiguities collapsed
                // in the fixture: S→C, Y→C) must not survive at the
                // 5' end of the read. We can't ban arbitrary primer
                // substrings — bodies legitimately contain motifs like
                // CCAGCA — but `startsWith` is a tight check.
                assert !seq.startsWith("CCAGCACCCGCGGTAATTCC") :
                    "forward-primer prefix should be gone, got: ${seq}"
            }
        }
    }

    test("emits a per-sample trimming log") {
        // COVERAGE: [S19]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
            }
            process {
                """
                input[0] = merge_fastq_pairs.out.merged
                """
            }
        }
        then {
            assert process.success
            def logPath = process.out.log.get(0)
            assert logPath.endsWith("sample_ok_trimming.log") : "unexpected log path: ${logPath}"
            assert path(logPath).readLines().size() > 0 : "expected non-empty trimming log"
        }
    }
}
