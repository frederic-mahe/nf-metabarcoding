nextflow_process {

    name "restore_ns_in_representatives"
    script "main.nf"
    process "restore_ns_in_representatives"

    test("replaces U with N in sequence lines, leaves headers alone") {
        // COVERAGE: [S56]
        // Round-trip of mask_ns_for_swarm ([S04]): swarm picks
        // representatives from a U-masked fasta; this restore step
        // rewrites the join-padding Us back to Ns before downstream
        // Part B steps consume the representatives.
        tag "ci"
        when {
            process {
                """
                input[0] = "sample_notmerged"
                input[1] = file("\${projectDir}/tests/data/u_containing.fas")
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out[1].get(0)).readLines()

            assert lines.size() == 4 :
                "expected 4 lines (2 records), got ${lines.size()}"

            // header lines untouched
            assert lines[0] == ">seq1_with_Us" :
                "header 1 was rewritten: ${lines[0]}"
            assert lines[2] == ">seq2_no_Us" :
                "header 2 was rewritten: ${lines[2]}"

            // sequence lines: every U -> N
            lines.eachWithIndex { line, i ->
                if (i % 2 == 1) {
                    assert !line.contains("U") :
                        "sequence line ${i} still contains U: ${line}"
                }
            }

            // 8 Us become 8 Ns in seq1
            assert lines[1].contains("NNNNNNNN") :
                "expected 8 Ns where the 8 Us were, got: ${lines[1]}"
        }
    }
}
