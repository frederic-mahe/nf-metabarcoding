nextflow_process {

    name "filter_and_convert_to_fasta"
    script "main.nf"
    process "filter_and_convert_to_fasta"

    setup {
        run("merge_fastq_pairs") {
            script "main.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        run("trim_primers") {
            script "main.nf"
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
    }

    test("converts trimmed fastq to fasta with SHA1 labels and ee values") {
        // COVERAGE: [S01]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
            }
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                input[2] = 0
                """
            }
        }
        then {
            assert process.success
            // Header layout: `>SHA1;ee=<float>;length=<int>` produced
            // by vsearch's --relabel_sha1 --eeout --lengthout. The
            // extract_ee.awk consumer ([S01]) and discover_fasta's
            // U-rejection ([S53]) both depend on this contract.
            def lines = path(process.out[1].get(0)).readLines()
            assert lines.size() > 0 : "expected at least one fasta record"
            assert lines.size() % 2 == 0 :
                "fasta width=0 expected, got ${lines.size()} lines"
            for (int i = 0; i < lines.size(); i += 2) {
                def header = lines[i]
                assert header.startsWith(">") : "missing > on header line ${i}: ${header}"
                // pattern: `>SHA1;ee=<float>;length=<int>`
                assert header ==~ /^>[0-9a-f]{40};ee=[0-9.]+;length=\d+$/ :
                    "header does not match >SHA1;ee=<float>;length=<int>: ${header}"
                def seq = lines[i + 1]
                assert !seq.startsWith(">") :
                    "expected sequence on line ${i+1}, got header: ${seq}"
                // [S52] guarantees no U / u survives.
                assert !seq.contains("U") && !seq.contains("u") :
                    "U survived [S52] normalisation: ${seq}"
            }
        }
    }

    test("emits single-line fasta (one record = two lines)") {
        // COVERAGE: [S55]
        // Regression guard: vsearch is invoked with --fasta_width 0
        // so every record is a header line + a single sequence line.
        // cluster_cleaver.py and build_filtered_contingency_table.py
        // silently misread folded fastas, hence the explicit guard.
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
            }
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                input[2] = 0
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out[1].get(0)).readLines()
            if (lines.size() == 0) {
                return
            }
            assert lines.size() % 2 == 0 :
                "fasta must be a multiple of 2 lines, got ${lines.size()}"
            for (int i = 0; i < lines.size(); i += 2) {
                assert lines[i].startsWith(">") :
                    "fasta line ${i+1} must start with '>', got: ${lines[i]}"
                assert !lines[i + 1].startsWith(">") :
                    "fasta line ${i+2} must be sequence data, got header: ${lines[i + 1]}"
            }
        }
    }

    test("normalises U/u to T/t on sequence lines (no U survives)") {
        // COVERAGE: [S52]
        tag "ci"
        when {
            params {
                // setup{} runs trim_primers for every test in the
                // file; give it the same primers as the first test
                // so it succeeds, even though this test feeds the
                // process under test directly from a fixture and
                // does not consume trim_primers.out.
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
            }
            process {
                """
                input[0] = "u_sample"
                input[1] = file("\${projectDir}/tests/data/u_normalisation.fastq")
                input[2] = 0
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out[1].get(0)).readLines()

            // Two records survive (length 40 > MIN_LENGTH=32).
            assert lines.size() == 4 :
                "expected 4 lines (2 records), got ${lines.size()}"

            // No 'U' or 'u' may appear anywhere in the output —
            // sequence lines must have been rewritten before vsearch
            // hashed and emitted them.
            lines.each { line ->
                assert !line.contains("U") :
                    "literal 'U' survived to fasta: ${line}"
                assert !line.contains("u") :
                    "literal 'u' survived to fasta: ${line}"
            }

            // Sequence content should be the input with every U->T
            // and u->t (case preserved). vsearch may pad headers with
            // metadata, so we only check the sequence lines.
            assert lines[1] == "ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT" :
                "uppercase input not normalised correctly: ${lines[1]}"
            assert lines[3] == "acgtacgtacgtacgtacgtacgtacgtacgtacgtacgt" :
                "lowercase input not normalised correctly: ${lines[3]}"
        }
    }
}
