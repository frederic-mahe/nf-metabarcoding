nextflow_process {

    name "filter_and_convert_to_fasta"
    script "main.nf"
    process "filter_and_convert_to_fasta"

    setup {
        run("merge_fastq_pairs") {
            script "main.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        run("trim_primers") {
            script "main.nf"
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
    }

    test("converts trimmed fastq to fasta with SHA1 labels and ee values") {
        // COVERAGE: [S01]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
            }
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                input[2] = "--relabel_sha1"
                """
            }
        }
        then {
            assert process.success
            // Header layout: `>SHA1;ee=<float>;length=<int>` produced
            // by vsearch's --relabel_sha1 --eeout --lengthout. The
            // extract_ee.awk consumer ([S01]) depends on this contract.
            def lines = path(process.out[1].get(0)).readLines()
            assert lines.size() > 0 : "expected at least one fasta record"
            assert lines.size() % 2 == 0 :
                "fasta width=0 expected, got ${lines.size()} lines"
            for (int i = 0; i < lines.size(); i += 2) {
                def header = lines[i]
                assert header.startsWith(">") : "missing > on header line ${i}: ${header}"
                // pattern: `>SHA1;ee=<float>;length=<int>`
                assert header ==~ /^>[0-9a-f]{40};ee=[0-9.]+;length=\d+$/ :
                    "header does not match >SHA1;ee=<float>;length=<int>: ${header}"
                def seq = lines[i + 1]
                assert !seq.startsWith(">") :
                    "expected sequence on line ${i+1}, got header: ${seq}"
            }
        }
    }

    test("--hash_function md5 produces 32-char MD5 amplicon names") {
        // COVERAGE: [S65]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                hash_function  = "md5"
            }
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                input[2] = "--relabel_md5"
                """
            }
        }
        then {
            assert process.success
            // [S65]: vsearch is invoked with --relabel_md5, so every
            // amplicon name is a 32-hex-character MD5 digest (vs the
            // 40-char SHA1 of the default run above).
            def lines = path(process.out[1].get(0)).readLines()
            assert lines.size() > 0 : "expected at least one fasta record"
            for (int i = 0; i < lines.size(); i += 2) {
                def header = lines[i]
                assert header ==~ /^>[0-9a-f]{32};ee=[0-9.]+;length=\d+$/ :
                    "header does not match >MD5;ee=<float>;length=<int>: ${header}"
            }
        }
    }

    test("emits single-line fasta (one record = two lines)") {
        // COVERAGE: [S55]
        // Regression guard: vsearch is invoked with --fasta_width 0
        // so every record is a header line + a single sequence line.
        // cluster_cleaver.py and build_filtered_contingency_table.py
        // silently misread folded fastas, hence the explicit guard.
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
            }
            process {
                """
                input[0] = trim_primers.out[0]
                input[1] = trim_primers.out[1]
                input[2] = "--relabel_sha1"
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out[1].get(0)).readLines()
            if (lines.size() == 0) {
                return
            }
            assert lines.size() % 2 == 0 :
                "fasta must be a multiple of 2 lines, got ${lines.size()}"
            for (int i = 0; i < lines.size(); i += 2) {
                assert lines[i].startsWith(">") :
                    "fasta line ${i+1} must start with '>', got: ${lines[i]}"
                assert !lines[i + 1].startsWith(">") :
                    "fasta line ${i+2} must be sequence data, got header: ${lines[i + 1]}"
            }
        }
    }

}
