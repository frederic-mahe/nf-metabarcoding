nextflow_process {

    name "list_local_clusters"
    script "modules/local/part_a/list_local_clusters.nf"
    process "list_local_clusters"

    setup {
        run("merge_fastq_pairs") {
            script "modules/local/part_a/merge_fastq_pairs.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        run("trim_primers") {
            script "modules/local/part_a/trim_primers.nf"
            process {
                """
                input[0] = merge_fastq_pairs.out.merged
                """
            }
        }
        run("filter_and_convert_to_fasta") {
            script "modules/local/part_a/filter_and_convert_to_fasta.nf"
            process {
                """
                input[0] = trim_primers.out.trimmed
                input[1] = "--relabel_sha1"
                """
            }
        }
        run("dereplicate_fasta") {
            script "modules/local/part_a/dereplicate_fasta.nf"
            process {
                """
                input[0] = filter_and_convert_to_fasta.out.fasta
                """
            }
        }
    }

    test("keeps only clusters with more than 2 reads") {
        // COVERAGE: [S17]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "tests/data"
            }
            process {
                """
                input[0] = dereplicate_fasta.out.fasta
                """
            }
        }
        then {
            assert process.success
            // [S17]: filter_swarm_stats.awk drops every row whose
            // column 2 (total reads) is <= 2. The paired_merge_ok
            // fixture's 3 reads collapse into 3 singleton clusters
            // (one per amplicon) — all filtered out. Assert the
            // output is either empty OR every surviving row carries
            // column 2 > 2; mixed bag is a [S17] violation.
            def stats = path(process.out.stats.get(0)[1]).readLines()
            stats.each { line ->
                if ( line.trim().isEmpty() ) {
                    return
                }
                def cols = line.split("\t")
                assert cols.size() >= 2 :
                    "expected at least 2 tab-separated columns, got: ${line}"
                def total = cols[1] as int
                assert total > 2 :
                    "[S17] violation: row with total=${total} reads survived the > 2 filter: ${line}"
            }
        }
    }

    test("emits a per-sample clustering log") {
        // COVERAGE: [S19]
        tag "ci"
        when {
            params {
                forward_primer = "CCAGCASCYGCGGTAATTCC"
                reverse_primer = "ACTTTCGTTCTTGATYRA"
                fastq_folder   = "tests/data"
            }
            process {
                """
                input[0] = dereplicate_fasta.out.fasta
                """
            }
        }
        then {
            assert process.success
            def logPath = process.out.log.get(0)
            assert logPath.endsWith("sample_ok_clustering.log") : "unexpected log path: ${logPath}"
            assert path(logPath).readLines().size() > 0 : "expected non-empty clustering log"
        }
    }
}
