nextflow_process {

    name "join_notmerged"
    script "modules/local/part_a/join_notmerged.nf"
    process "join_notmerged"

    setup {
        run("merge_fastq_pairs") {
            script "modules/local/part_a/merge_fastq_pairs.nf"
            process {
                """
                input[0] = tuple(
                    "sample_fail",
                    [
                        file("\${projectDir}/tests/data/paired_merge_fail_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_fail_2.fastq.gz")
                    ]
                )
                """
            }
        }
    }

    test("joins not-merged R1/R2 with the default 8-A padding") {
        // COVERAGE: [S04], [S63]
        // The A-padding redesign ([S04]) drops the mask/restore
        // round-trip: vsearch --fastq_join is invoked with
        // --join_padgap set to params.join_padding_length As and
        // --join_padgapq set to the same number of `I` characters
        // (Phred 40). With the default length, every joined read
        // carries a run of 8 As at the R1/R2 boundary.
        tag "ci"
        when {
            process {
                """
                input[0] = merge_fastq_pairs.out.notmerged.map { row ->
                    tuple(row[0] + "_notmerged", row[1], row[2])
                }
                """
            }
        }
        then {
            assert process.success

            def lines = path(process.out.joined.get(0)[1]).readLines()
            assert lines.size() >= 4 : "expected at least one joined fastq record"
            assert lines.size() % 4 == 0 :
                "fastq must have a multiple of 4 lines, got ${lines.size()}"

            def seqs = []
            def quals = []
            for (int i = 1; i < lines.size(); i += 4) {
                seqs.add(lines[i])
                quals.add(lines[i + 2])
            }
            seqs.each { seq ->
                assert seq.contains("AAAAAAAA") :
                    "expected 8-A join padding in: ${seq}"
                assert !seq.contains("N") :
                    "shadow path must not introduce N padding: ${seq}"
            }
            quals.each { q ->
                assert q.contains("IIIIIIII") :
                    "expected 8-I (Phred 40) padding-quality run in: ${q}"
            }
        }
    }

    test("--join_padding_length 12 widens the A run to at least 12 As") {
        // COVERAGE: [S63]
        // The lever is workflow-wide. With join_padding_length=12,
        // every joined record must carry a run of at least 12 As at
        // the join site. The matching --join_padgapq Phred-40 ('I')
        // string must be exactly 12 characters long so the run of
        // padding-quality bytes is also at least 12. (An exact-length
        // assertion on the A run is unsafe because a read whose R1
        // tail or R2 head happens to be an A would inflate the visible
        // run by one or two characters — the meaningful check is the
        // lower bound matching the requested length.)
        tag "ci"
        when {
            params {
                join_padding_length = 12
            }
            process {
                """
                input[0] = merge_fastq_pairs.out.notmerged.map { row ->
                    tuple(row[0] + "_notmerged", row[1], row[2])
                }
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out.joined.get(0)[1]).readLines()
            assert lines.size() % 4 == 0 :
                "fastq must have a multiple of 4 lines, got ${lines.size()}"

            for (int i = 1; i < lines.size(); i += 4) {
                def seq = lines[i]
                def qual = lines[i + 2]
                assert seq.contains("A" * 12) :
                    "expected 12-A run in: ${seq}"
                assert qual.contains("I" * 12) :
                    "expected 12-I (Phred 40) padding-quality run in: ${qual}"
            }
        }
    }

    test("emits canonical 4-line fastq from vsearch --fastq_join") {
        // COVERAGE: [S54]
        // Regression guard for the vsearch --fastq_join output shape
        // (see [S54] rationale).
        tag "ci"
        when {
            process {
                """
                input[0] = merge_fastq_pairs.out.notmerged.map { row ->
                    tuple(row[0] + "_notmerged", row[1], row[2])
                }
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out.joined.get(0)[1]).readLines()
            if (lines.size() == 0) {
                return
            }
            assert lines.size() % 4 == 0 :
                "fastq must be a multiple of 4 lines, got ${lines.size()}"
            for (int i = 0; i < lines.size(); i += 4) {
                assert lines[i].startsWith("@") :
                    "line ${i+1} must start with '@', got: ${lines[i]}"
                assert lines[i + 2].startsWith("+") :
                    "line ${i+3} must start with '+', got: ${lines[i + 2]}"
                assert lines[i + 1].length() == lines[i + 3].length() :
                    "record ${i/4}: sequence/quality length mismatch"
            }
        }
    }

    test("does not emit a merging log for the shadow path") {
        // COVERAGE: [S04], [S19]
        // The shadow path performs an A-padded join, not a merge,
        // so a `_merging.log` would be misleading. The process must
        // expose only the sampleId and joined fastq output channels.
        tag "ci"
        when {
            process {
                """
                input[0] = merge_fastq_pairs.out.notmerged.map { row ->
                    tuple(row[0] + "_notmerged", row[1], row[2])
                }
                """
            }
        }
        then {
            assert process.success
            // The shadow join exposes a single declared output: the
            // (sampleId, joined fastq) tuple. A `_merging.log` output
            // would be a regression. (nf-test surfaces the one declared
            // channel under both its positional and its `joined` name,
            // so process.out.size() is 2; an extra emitted output would
            // push it higher.)
            assert process.out.size() == 2 :
                "join_notmerged must expose only the (sampleId, joined fastq) tuple, got ${process.out.size()} entries"
            def joined = process.out.joined.get(0)
            assert joined.size() == 2 && joined[1].endsWith("joined_fastq") :
                "expected a (sampleId, joined fastq) tuple, got: ${joined}"
        }
    }
}
