nextflow_process {

    name "merge_fastq_pairs"
    script "modules/local/part_a/merge_fastq_pairs.nf"
    process "merge_fastq_pairs"

    test("merges overlapping paired-end reads") {
        // COVERAGE: [S01], [S03]
        // The paired_merge_ok fixture carries 3 amplicons whose
        // R1 + R2 overlap on the central insert ([S03] paired-end
        // path). vsearch --fastq_mergepairs must emit one merged
        // record per pair and leave the notmerged_{fwd,rev} streams
        // empty for this fixture.
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success

            // merged fastq: 3 records (= 12 lines, 4 per record).
            def merged = path(process.out[1].get(0)).readLines()
            assert merged.size() == 12 :
                "expected 3 merged records (12 lines), got ${merged.size()}"

            // every input pair merged → notmerged_fwd / notmerged_rev empty.
            assert path(process.out[3].get(0)).readLines().isEmpty() :
                "notmerged_fwd should be empty when every pair merges"
            assert path(process.out[4].get(0)).readLines().isEmpty() :
                "notmerged_rev should be empty when every pair merges"
        }
    }

    test("emits a per-sample merging log") {
        // COVERAGE: [S19]
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success
            def logPath = process.out[2].get(0)
            assert logPath.endsWith("sample_ok_merging.log") : "unexpected log path: ${logPath}"
            assert path(logPath).readLines().size() > 0 : "expected non-empty merging log"
        }
    }

    test("emits canonical 4-line fastq for merged + notmerged outputs") {
        // COVERAGE: [S54]
        // Regression guard: vsearch produces 4-line fastq by default;
        // downstream consumers (further vsearch invocations, awk-based
        // helpers) assume the layout, so a silent drift to a folded
        // representation would corrupt the wrong bytes.
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_fail",
                    [
                        file("\${projectDir}/tests/data/paired_merge_fail_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_fail_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success

            // The merged fastq is empty here (paired_merge_fail can't
            // overlap), but notmerged_fwd / notmerged_rev are not.
            [process.out[1].get(0),
             process.out[3].get(0),
             process.out[4].get(0)].each { p ->
                def lines = path(p).readLines()
                if (lines.size() == 0) {
                    return  // empty fastq is valid ([S09])
                }
                assert lines.size() % 4 == 0 :
                    "${p}: fastq must be a multiple of 4 lines, got ${lines.size()}"
                for (int i = 0; i < lines.size(); i += 4) {
                    assert lines[i].startsWith("@") :
                        "${p}: line ${i+1} must start with '@', got: ${lines[i]}"
                    assert lines[i + 2].startsWith("+") :
                        "${p}: line ${i+3} must start with '+', got: ${lines[i + 2]}"
                    assert lines[i + 1].length() == lines[i + 3].length() :
                        "${p}: record ${i/4}: sequence/quality length mismatch " +
                        "(${lines[i + 1].length()} vs ${lines[i + 3].length()})"
                }
            }
        }
    }

    test("non-overlapping pairs are captured as notmerged_{fwd,rev}") {
        // COVERAGE: [S04] — D01 is resolved; the shadow pipeline
        // collects unmerged R1/R2 via --fastqout_notmerged_fwd/_rev.
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_fail",
                    [
                        file("\${projectDir}/tests/data/paired_merge_fail_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_fail_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success

            // out[1] = merged fastq (empty — every pair failed to merge)
            def mergedLines = path(process.out[1].get(0)).readLines()
            assert mergedLines.size() == 0 :
                "expected zero merged reads, got ${mergedLines.size()} lines"

            // out[3] = notmerged_fwd, out[4] = notmerged_rev — both non-empty
            def fwdLines = path(process.out[3].get(0)).readLines()
            def revLines = path(process.out[4].get(0)).readLines()
            assert fwdLines.size() > 0 && fwdLines.size() % 4 == 0 :
                "unexpected notmerged_fwd content: ${fwdLines.size()} lines"
            assert fwdLines.size() == revLines.size() :
                "fwd/rev streams must stay in sync, got " +
                "fwd=${fwdLines.size()} rev=${revLines.size()}"
        }
    }
}
