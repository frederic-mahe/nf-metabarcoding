nextflow_process {

    name "merge_fastq_pairs"
    script "modules/local/part_a/merge_fastq_pairs.nf"
    process "merge_fastq_pairs"

    test("merges overlapping paired-end reads") {
        // COVERAGE: [S01], [S03]
        // The paired_merge_ok fixture carries 3 amplicons whose
        // R1 + R2 overlap on the central insert ([S03] paired-end
        // path). vsearch --fastq_mergepairs must emit one merged
        // record per pair and leave the notmerged_{fwd,rev} streams
        // empty for this fixture.
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success

            // merged fastq: 3 records (= 12 lines, 4 per record).
            def merged = path(process.out.merged.get(0)[1]).readLines()
            assert merged.size() == 12 :
                "expected 3 merged records (12 lines), got ${merged.size()}"

            // every input pair merged → notmerged_fwd / notmerged_rev empty.
            assert path(process.out.notmerged.get(0)[1]).readLines().isEmpty() :
                "notmerged_fwd should be empty when every pair merges"
            assert path(process.out.notmerged.get(0)[2]).readLines().isEmpty() :
                "notmerged_rev should be empty when every pair merges"
        }
    }

    test("emits a per-sample merging log") {
        // COVERAGE: [S19]
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success
            def logPath = process.out.log.get(0)
            assert logPath.endsWith("sample_ok_merging.log") : "unexpected log path: ${logPath}"
            assert path(logPath).readLines().size() > 0 : "expected non-empty merging log"
        }
    }

    test("emits canonical 4-line fastq for merged + notmerged outputs") {
        // COVERAGE: [S54]
        // Regression guard: vsearch produces 4-line fastq by default;
        // downstream consumers (further vsearch invocations, awk-based
        // helpers) assume the layout, so a silent drift to a folded
        // representation would corrupt the wrong bytes.
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_fail",
                    [
                        file("\${projectDir}/tests/data/paired_merge_fail_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_fail_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success

            // The merged fastq is empty here (paired_merge_fail can't
            // overlap), but notmerged_fwd / notmerged_rev are not.
            [process.out.merged.get(0)[1],
             process.out.notmerged.get(0)[1],
             process.out.notmerged.get(0)[2]].each { p ->
                def lines = path(p).readLines()
                if (lines.size() == 0) {
                    return  // empty fastq is valid ([S09])
                }
                assert lines.size() % 4 == 0 :
                    "${p}: fastq must be a multiple of 4 lines, got ${lines.size()}"
                for (int i = 0; i < lines.size(); i += 4) {
                    assert lines[i].startsWith("@") :
                        "${p}: line ${i+1} must start with '@', got: ${lines[i]}"
                    assert lines[i + 2].startsWith("+") :
                        "${p}: line ${i+3} must start with '+', got: ${lines[i + 2]}"
                    assert lines[i + 1].length() == lines[i + 3].length() :
                        "${p}: record ${i/4}: sequence/quality length mismatch " +
                        "(${lines[i + 1].length()} vs ${lines[i + 3].length()})"
                }
            }
        }
    }

    test("non-overlapping pairs are captured as notmerged_{fwd,rev}") {
        // COVERAGE: [S04] — D01 is resolved; the shadow pipeline
        // collects unmerged R1/R2 via --fastqout_notmerged_fwd/_rev.
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_fail",
                    [
                        file("\${projectDir}/tests/data/paired_merge_fail_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_fail_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success

            // out.merged = merged fastq (empty — every pair failed to merge)
            def mergedLines = path(process.out.merged.get(0)[1]).readLines()
            assert mergedLines.size() == 0 :
                "expected zero merged reads, got ${mergedLines.size()} lines"

            // out.notmerged = (id, notmerged_fwd, notmerged_rev) — both non-empty
            def fwdLines = path(process.out.notmerged.get(0)[1]).readLines()
            def revLines = path(process.out.notmerged.get(0)[2]).readLines()
            assert fwdLines.size() > 0 && fwdLines.size() % 4 == 0 :
                "unexpected notmerged_fwd content: ${fwdLines.size()} lines"
            assert fwdLines.size() == revLines.size() :
                "fwd/rev streams must stay in sync, got " +
                "fwd=${fwdLines.size()} rev=${revLines.size()}"
        }
    }

    test("accepts and preserves maximum Phred+33 quality (Q93)") {
        // COVERAGE: [S106]
        // PacBio HiFi-style input carries per-base quality up to Q93.
        // vsearch's default --fastq_qmax is 41 and aborts on anything
        // higher, so success here proves --fastq_qmax 93 reached
        // --fastq_mergepairs. Every base of the fixture is Q93 ('~');
        // the R1/R2 overlap agrees, so its merged posterior quality is
        // far above Q41 and — with --fastq_qmaxout 93 — is written as
        // Q93 rather than clamped to the default 41 ('J'). Asserting
        // that every merged quality character is '~' therefore
        // witnesses both flags at once.
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_hq",
                    [
                        file("\${projectDir}/tests/data/highqual_1.fastq.gz"),
                        file("\${projectDir}/tests/data/highqual_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success

            def merged = path(process.out.merged.get(0)[1]).readLines()
            assert merged.size() > 0 && merged.size() % 4 == 0 :
                "expected a non-empty 4-line-record merged fastq, got ${merged.size()} lines"
            for (int i = 3; i < merged.size(); i += 4) {
                assert merged[i] ==~ /^~+$/ :
                    "merged quality must be all Q93 ('~') with --fastq_qmaxout 93, got: ${merged[i]}"
            }
        }
    }

    test("derives the quality ceiling from the encoding offset (offset 64)") {
        // COVERAGE: [S106]
        // Under fastq_encoding=64 the highest representable quality is
        // 126-64=62, so the all-'~' fixture reads as Q62. A hardcoded
        // --fastq_qmax / --fastq_qmaxout of 93 would abort here because
        // 64 + 93 > 126; success proves the ceiling is derived as
        // 126-offset. With the derived --fastq_qmaxout 62 the agreeing
        // overlap is written at Q62 — again '~' at offset 64 — so every
        // merged quality character is '~'.
        tag "ci"
        when {
            params {
                fastq_encoding = 64
            }
            process {
                """
                input[0] = tuple(
                    "sample_hq64",
                    [
                        file("\${projectDir}/tests/data/highqual_1.fastq.gz"),
                        file("\${projectDir}/tests/data/highqual_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success

            def merged = path(process.out.merged.get(0)[1]).readLines()
            assert merged.size() > 0 && merged.size() % 4 == 0 :
                "expected a non-empty 4-line-record merged fastq, got ${merged.size()} lines"
            for (int i = 3; i < merged.size(); i += 4) {
                assert merged[i] ==~ /^~+$/ :
                    "merged quality must reach the Q62 ceiling ('~') with the derived --fastq_qmaxout, got: ${merged[i]}"
            }
        }
    }
}
