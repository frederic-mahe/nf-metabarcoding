nextflow_process {

    name "merge_fastq_pairs"
    script "main.nf"
    process "merge_fastq_pairs"

    test("merges overlapping paired-end reads") {
        // COVERAGE: [S01], [S03]
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success
            // TODO: assert that the merged_fastq output contains 3 records
        }
    }

    test("emits a per-sample merging log") {
        // COVERAGE: [S19]
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success
            def logPath = process.out[2].get(0)
            assert logPath.endsWith("sample_ok_merging.log") : "unexpected log path: ${logPath}"
            assert path(logPath).readLines().size() > 0 : "expected non-empty merging log"
        }
    }

    test("non-overlapping pairs are captured as notmerged_{fwd,rev}") {
        // COVERAGE: [S04] — D01 is resolved; the shadow pipeline
        // collects unmerged R1/R2 via --fastqout_notmerged_fwd/_rev.
        tag "ci"
        when {
            process {
                """
                input[0] = tuple(
                    "sample_fail",
                    [
                        file("\${projectDir}/tests/data/paired_merge_fail_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_fail_2.fastq.gz")
                    ]
                )
                """
            }
        }
        then {
            assert process.success

            // out[1] = merged fastq (empty — every pair failed to merge)
            def mergedLines = path(process.out[1].get(0)).readLines()
            assert mergedLines.size() == 0 :
                "expected zero merged reads, got ${mergedLines.size()} lines"

            // out[3] = notmerged_fwd, out[4] = notmerged_rev — both non-empty
            def fwdLines = path(process.out[3].get(0)).readLines()
            def revLines = path(process.out[4].get(0)).readLines()
            assert fwdLines.size() > 0 && fwdLines.size() % 4 == 0 :
                "unexpected notmerged_fwd content: ${fwdLines.size()} lines"
            assert fwdLines.size() == revLines.size() :
                "fwd/rev streams must stay in sync, got " +
                "fwd=${fwdLines.size()} rev=${revLines.size()}"
        }
    }
}
