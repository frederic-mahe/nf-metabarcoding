nextflow_process {

    name "download_run"
    script "modules/local/fetch/download_run.nf"
    process "download_run"

    // [S100]/[S101]: the download stage runs one task per run accession via
    // fastq-dl (pinned fastq-dl=4.0.1 as a per-process conda directive, NOT
    // in environment.yml; --provider ena), publishing under a per-accession
    // subfolder <outdir>/<accession>/. Network-backed in production; here it
    // is exercised only in stub mode (the stub touches fixture fastq.gz),
    // per the D19 testing boundary. Blocked by D19 — pending until the fetch
    // sub-workflow lands.

    options "-stub"

    test("downloads a run and carries its accession through (stub)") {
        // COVERAGE: [S100], [S101]
        // The emitted tuple keys each run's fastq to its accession — the
        // key that lets the per-accession publishDir subfolder ([S100])
        // resolve. The subfolder layout itself is asserted end-to-end in
        // tests/main.nf.test (publishDir targets are not visible on
        // process.out, which reports work-dir paths).
        tag "ci"
        when {
            process {
                """
                input[0] = ['PRJEB89924', 'ERR13334567']
                """
            }
        }
        then {
            assert process.success
            def acc = process.out.reads.get(0).get(0)
            assert acc == 'PRJEB89924' :
                "the accession must be carried through as the tuple key"
            def reads = process.out.reads.get(0).get(1)
            assert reads.every { it.endsWith('.fastq.gz') } :
                "download must emit fastq.gz file(s), got: ${reads}"
            assert reads.any { it.contains('ERR13334567') } :
                "emitted fastq must belong to the requested run"
        }
    }

    test("pins fastq-dl=4.0.1 as a per-process conda directive and passes --provider ena") {
        // COVERAGE: [S101]
        // The pin lives on the process (not environment.yml) so non-fetch
        // users never resolve it; the provider defaults to ena. Asserted
        // statically against the module source.
        tag "ci"
        then {
            def src = path("${projectDir}/modules/local/fetch/download_run.nf").text
            assert src.contains("bioconda::fastq-dl=4.0.1") :
                "download_run must pin fastq-dl=4.0.1 in a per-process conda directive"
            assert src.contains("--provider ena") :
                "download_run must pass --provider ena"
            def env = path("${projectDir}/environment.yml").text
            assert !env.contains("fastq-dl") :
                "fastq-dl must NOT be in environment.yml (per-process only)"
        }
    }

    test("passes --max-attempts 5 to fastq-dl (raising the default of 3)") {
        // COVERAGE: [S101]
        // fastq-dl defaults to 3 download attempts; the download stage
        // raises the ceiling to 5 so a transient ENA / network hiccup is
        // retried more times before the run-task fails. Asserted
        // statically against the module source.
        tag "ci"
        then {
            def src = path("${projectDir}/modules/local/fetch/download_run.nf").text
            assert src.contains("--max-attempts 5") :
                "download_run must pass --max-attempts 5 to fastq-dl"
        }
    }
}
