nextflow_process {

    name "build_expected_error_file"
    script "main.nf"
    process "build_expected_error_file"

    test("merges per-sample .qual files and uniqs by SHA1") {
        // COVERAGE: [S28]
        tag "ci"
        when {
            process {
                """
                input[0] = [
                    file("\${projectDir}/tests/data/part_b/S1.qual"),
                    file("\${projectDir}/tests/data/part_b/S2.qual"),
                    file("\${projectDir}/tests/data/part_b/E.qual")
                ]
                input[1] = "proj_3_samples"
                input[2] = 40
                """
            }
        }
        then {
            assert process.success
            def outPath = process.out[0].get(0)
            assert outPath.endsWith("proj_3_samples.qual") :
                "unexpected output filename: ${outPath}"
            def lines = path(outPath).readLines()
            // 3 distinct SHA1s across the three inputs (A shared, B and
            // C unique; E.qual is empty so contributes nothing).
            assert lines.size() == 3 :
                "expected 3 rows after uniq, got ${lines.size()}: ${lines}"
            def shas = lines.collect { it.split(/\s+/)[0] } as Set
            assert shas == [
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "cccccccccccccccccccccccccccccccccccccccc",
            ] as Set
            // S2 carries the lower ee for sequence A (0.005000) and
            // sorts ahead of S1 (0.010000), so it must be the row
            // that survives uniq.
            def rowA = lines.find {
                it.startsWith("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
            }
            assert rowA != null
            assert rowA.contains("0.005000") :
                "expected the lower-ee row to win, got: ${rowA}"
        }
    }

    test("--hash_function md5 merges and uniqs by the 32-char name width") {
        // COVERAGE: [S65]
        // Same merge as above but with 32-char (MD5-width) names. The
        // uniq --check-chars width is passed explicitly as input[2] (32);
        // at the SHA1 width (40) the trailing ee digits would enter the
        // comparison and the shared name would not collapse.
        tag "ci"
        when {
            process {
                """
                input[0] = [
                    file("\${projectDir}/tests/data/hash_function/S1_md5.qual"),
                    file("\${projectDir}/tests/data/hash_function/S2_md5.qual")
                ]
                input[1] = "proj_md5"
                input[2] = 32
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out[0].get(0)).readLines()
            // md5_a shared (lower ee in S2), md5_b (S1), md5_c (S2).
            assert lines.size() == 3 :
                "expected 3 rows after uniq, got ${lines.size()}: ${lines}"
            lines.each { line ->
                assert line.split(/\s+/)[0] ==~ /[0-9a-f]{32}/ :
                    "expected 32-char MD5 hex in column 1: ${line}"
            }
            def rowA = lines.find {
                it.startsWith("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
            }
            assert rowA != null
            assert rowA.contains("0.005000") :
                "expected the lower-ee row to win, got: ${rowA}"
        }
    }
}
