nextflow_process {

    name "global_dereplication"
    script "modules/local/part_b/global_dereplication.nf"
    process "global_dereplication"

    test("collapses identical sequences across samples and sums sizes") {
        // COVERAGE: [S31]
        tag "ci"
        when {
            process {
                """
                input[0] = [
                    file("\${projectDir}/tests/data/part_b/S1.fas"),
                    file("\${projectDir}/tests/data/part_b/S2.fas"),
                    file("\${projectDir}/tests/data/part_b/E.fas")
                ]
                input[1] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success

            // Output fasta is the first emitted path.
            def fastaPath = process.out[0].get(0)
            assert fastaPath.endsWith("proj_3_samples.fas") :
                "unexpected fasta output: ${fastaPath}"

            // 3 unique sequences across the three inputs (A is
            // shared, B and C are unique; E.fas is empty and
            // contributes nothing — [S09]/[S27]).
            def lines = path(fastaPath).readLines()
            def headers = lines.findAll { it.startsWith(">") }
            assert headers.size() == 3 :
                "expected 3 records after global dereplication, got ${headers.size()}"

            // Sequence A has size=3 in S1 and size=1 in S2 → sum=4.
            // vsearch --fastx_uniques rewrites headers as
            // ">SHA1;size=N;" or similar.
            def header_a = headers.find {
                it.contains("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
            }
            assert header_a != null : "missing record for sequence A"
            assert header_a ==~ /.*;size=4;?.*/ :
                "expected size=4 for shared sequence A, got: ${header_a}"

            // log file is the second emitted path; [S45] pins the
            // step-specific suffix.
            def logPath = process.out[1].get(0)
            assert logPath.endsWith("proj_3_samples_dereplication.log") :
                "unexpected log filename: ${logPath}"
            assert path(logPath).readLines().size() > 0 :
                "vsearch log should not be empty"
        }
    }

    test("emits single-line fasta from vsearch --fastx_uniques") {
        // COVERAGE: [S55]
        // Regression guard for the vsearch --fastx_uniques output
        // shape (--fasta_width 0). See [S55] rationale.
        tag "ci"
        when {
            process {
                """
                input[0] = [
                    file("\${projectDir}/tests/data/part_b/S1.fas"),
                    file("\${projectDir}/tests/data/part_b/S2.fas"),
                    file("\${projectDir}/tests/data/part_b/E.fas")
                ]
                input[1] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out[0].get(0)).readLines()
            if (lines.size() == 0) {
                return
            }
            assert lines.size() % 2 == 0 :
                "fasta must be a multiple of 2 lines, got ${lines.size()}"
            for (int i = 0; i < lines.size(); i += 2) {
                assert lines[i].startsWith(">") :
                    "fasta line ${i+1} must start with '>', got: ${lines[i]}"
                assert !lines[i + 1].startsWith(">") :
                    "fasta line ${i+2} must be sequence data, got header: ${lines[i + 1]}"
            }
        }
    }

}
