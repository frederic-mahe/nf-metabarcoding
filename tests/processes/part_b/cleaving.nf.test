nextflow_process {

    name "cleaving"
    script "modules/local/part_b/cleaving.nf"
    process "cleaving"

    setup {
        run("list_all_cluster_seeds_of_size_greater_than_2") {
            script "modules/local/part_b/list_all_cluster_seeds_of_size_greater_than_2.nf"
            process {
                """
                input[0] = [
                    file("\${projectDir}/tests/data/part_b/S1.stats"),
                    file("\${projectDir}/tests/data/part_b/S2.stats"),
                    file("\${projectDir}/tests/data/part_b/E.stats")
                ]
                input[1] = "proj_3_samples"
                """
            }
        }
        run("global_dereplication") {
            script "modules/local/part_b/global_dereplication.nf"
            process {
                """
                input[0] = [
                    file("\${projectDir}/tests/data/part_b/S1.fas"),
                    file("\${projectDir}/tests/data/part_b/S2.fas"),
                    file("\${projectDir}/tests/data/part_b/E.fas")
                ]
                input[1] = "proj_3_samples"
                """
            }
        }
        run("global_clustering") {
            script "modules/local/part_b/global_clustering.nf"
            process {
                """
                input[0] = global_dereplication.out.fasta
                input[1] = "proj_3_samples"
                """
            }
        }
    }

    test("wraps bin/cluster_cleaver.py and emits .stats2, .swarms2, .fas2, .log") {
        // COVERAGE: [S22], [S45]
        tag "ci"
        when {
            process {
                """
                input[0] = global_clustering.out.stats   // .stats
                input[1] = global_clustering.out.struct   // .struct
                input[2] = global_clustering.out.swarms   // .swarms
                input[3] = global_dereplication.out.fasta // global .fas
                input[4] = list_all_cluster_seeds_of_size_greater_than_2.out.stats
                input[5] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success

            // The process emits four paths: .stats2, .swarms2,
            // _representatives.fas2, and the [S45] cleaving log.
            def stats2 = process.out.stats.get(0)
            def swarms2 = process.out.swarms.get(0)
            def fas2 = process.out.representatives.get(0)
            def log = process.out.log.get(0)

            assert stats2.endsWith("proj_3_samples_1f.stats2") :
                "unexpected .stats2 filename: ${stats2}"
            assert swarms2.endsWith("proj_3_samples_1f.swarms2") :
                "unexpected .swarms2 filename: ${swarms2}"
            assert fas2.endsWith("proj_3_samples_1f_representatives.fas2") :
                "unexpected .fas2 filename: ${fas2}"
            assert log.endsWith("proj_3_samples_cleaving.log") :
                "unexpected log filename: ${log}"

            // All three data files must exist (they may be empty when
            // the fixture's clusters carry no sub-seeds — that is a
            // valid outcome per the cleaver's contract).
            [stats2, swarms2, fas2].each { p ->
                assert file(p).exists() : "missing cleaver output: ${p}"
            }
            // bin/cluster_cleaver.py emits INFO-level progress on
            // stderr, so the log is always non-empty.
            assert path(log).readLines().size() > 0 :
                "cleaving log should not be empty"
        }
    }

    test("--percentage threads through to cluster_cleaver.py") {
        // COVERAGE: [S22]
        // [S22] promises a configurable cleaving threshold exposed as
        // --percentage. The script honours the flag (pinned by
        // tests/python/test_cluster_cleaver.py); this test guards the
        // *workflow wiring* — that cleaving.nf forwards params.percentage
        // to the script. cluster_cleaver.py logs the resolved threshold
        // and the percentage it came from on stderr (the published
        // cleaving log), so a non-default --percentage must surface
        // there. A regression that drops the wiring would log the 0.05
        // default instead.
        tag "ci"
        when {
            params {
                percentage = 0.5
            }
            process {
                """
                input[0] = global_clustering.out.stats   // .stats
                input[1] = global_clustering.out.struct   // .struct
                input[2] = global_clustering.out.swarms   // .swarms
                input[3] = global_dereplication.out.fasta // global .fas
                input[4] = list_all_cluster_seeds_of_size_greater_than_2.out.stats
                input[5] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success
            def log = process.out.log.get(0)
            assert path(log).text.contains("--percentage 0.5") :
                "cleaving log should record the wired --percentage 0.5, got:\n${path(log).text}"
        }
    }

    test("--fastidious false swaps the cleaved representatives suffix from _1f to _1") {
        // COVERAGE: [S22]
        // Propagation lever from [S22]: cluster_cleaver.py receives
        // --no-fastidious, and the published representatives FASTA
        // filename swaps from _1f_representatives.fas2 to
        // _1_representatives.fas2. The .stats2 / .swarms2 names follow
        // the input filename (which carries the upstream global_clustering
        // suffix), so they stay as `_1f` here because the setup{}
        // block above runs global_clustering with the default
        // (fastidious=true). The cleaver's filename-branching for
        // representatives is what [S22] propagates.
        tag "ci"
        when {
            params {
                fastidious = false
            }
            process {
                """
                input[0] = global_clustering.out.stats   // .stats
                input[1] = global_clustering.out.struct   // .struct
                input[2] = global_clustering.out.swarms   // .swarms
                input[3] = global_dereplication.out.fasta // global .fas
                input[4] = list_all_cluster_seeds_of_size_greater_than_2.out.stats
                input[5] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success
            def fas2 = process.out.representatives.get(0)
            assert fas2.endsWith("proj_3_samples_1_representatives.fas2") :
                "expected _1_representatives.fas2 with --fastidious=false, got: ${fas2}"
        }
    }
}
