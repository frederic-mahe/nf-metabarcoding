nextflow_process {

    name "build_occurrence_table"
    script "modules/local/part_b/build_occurrence_table.nf"
    process "build_occurrence_table"

    test("merges Part B inputs into the filtered occurrence table") {
        // COVERAGE: [S35]
        // COVERAGE: [S127]
        // The cleaved variants (representatives_2, stats_2, swarms_2,
        // uchime_2) are wired as empty fixtures here to
        // exercise the empty-cleaved path; the same script is also
        // pinned byte-exact by the pytest characterization test.
        tag "ci"
        when {
            process {
                """
                def empty = workDir.resolve("empty")
                empty.text = ""
                def reps = file("\${projectDir}/tests/data/build_filtered_contingency_table/representatives")
                def stats = file("\${projectDir}/tests/data/build_filtered_contingency_table/stats")
                def swarms = file("\${projectDir}/tests/data/build_filtered_contingency_table/swarms")
                def uchime = file("\${projectDir}/tests/data/build_filtered_contingency_table/uchime")
                def quality = file("\${projectDir}/tests/data/build_filtered_contingency_table/quality")
                def distr = file("\${projectDir}/tests/data/build_filtered_contingency_table/distribution")
                input[0]  = reps
                input[1]  = file(empty.toString())   // empty fas2
                input[2]  = stats
                input[3]  = file(empty.toString())   // empty stats2
                input[4]  = swarms
                input[5]  = file(empty.toString())   // empty swarms2
                input[6]  = uchime
                input[7]  = file(empty.toString())   // empty uchime2
                input[8]  = quality
                input[9]  = distr
                input[10] = "proj"
                input[11] = "s1,s2,s3,s4,s5"   // [S09] sample list
                """
            }
        }
        then {
            assert process.success
            def outPath = process.out.table.get(0)
            assert outPath.endsWith("proj.OTU.filtered.cleaved.table") :
                "unexpected output filename: ${outPath}"
            // The fixture concatenated with itself doubles every row,
            // but the script keys on seed-set so duplicates collapse
            // back to the same three passing clusters. The full
            // golden-file content is pinned by the pytest
            // characterization test; here we sanity-check the
            // header + row count.
            def lines = path(outPath).readLines()
            assert lines.size() == 4 :
                "expected header + 3 rows, got ${lines.size()}: ${lines}"
            assert lines[0].startsWith("OTU\ttotal") :
                "unexpected header: ${lines[0]}"
            // [S127]: no assignments are passed, so every row carries
            // the placeholder identity / taxonomy / references.
            lines.drop(1).each { row ->
                def cols = row.split("\t")
                assert cols[10..12] == ["0.0", "NA", "NA"] :
                    "placeholder columns expected, got: ${row}"
            }
        }
    }
}
