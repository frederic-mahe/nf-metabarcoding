nextflow_process {

    name "chimera_detection"
    script "modules/local/part_b/chimera_detection.nf"
    process "chimera_detection"

    setup {
        run("global_dereplication") {
            script "modules/local/part_b/global_dereplication.nf"
            process {
                """
                input[0] = [
                    file("\${projectDir}/tests/data/part_b/S1.fas"),
                    file("\${projectDir}/tests/data/part_b/S2.fas"),
                    file("\${projectDir}/tests/data/part_b/E.fas")
                ]
                input[1] = "proj_3_samples"
                """
            }
        }
        run("global_clustering") {
            script "modules/local/part_b/global_clustering.nf"
            process {
                """
                input[0] = global_dereplication.out.fasta
                input[1] = "proj_3_samples"
                """
            }
        }
    }

    test("runs uchime_denovo on minsize-filtered representatives") {
        // COVERAGE: [S34]
        tag "ci"
        when {
            process {
                """
                input[0] = global_clustering.out.representatives
                input[1] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success

            // The process emits two paths: the uchime hit table and
            // the stderr log.
            def uchimePath = process.out.uchime.get(0)
            def logPath    = process.out.log.get(0)

            assert uchimePath.endsWith("proj_3_samples_1f_representatives.uchime") :
                "unexpected uchime filename: ${uchimePath}"
            assert logPath.endsWith("proj_3_samples_1f_representatives.log") :
                "unexpected log filename: ${logPath}"

            // The .uchime table may legitimately be empty (no
            // chimeras found in the tiny fixture); the log must not.
            assert file(uchimePath).exists() : "missing .uchime file"
            assert path(logPath).readLines().size() > 0 :
                "uchime stderr log should not be empty"
        }
    }

    test("params.chimera_minsize threads through to --fastx_filter --minsize") {
        // COVERAGE: [S34]
        // The part_b fixture's global representatives have sizes 4, 4,
        // and 2 after global_dereplication. Setting chimera_minsize=5
        // pushes every record below the threshold, so uchime sees an
        // empty stream and the .uchime table comes back empty — even
        // though the same fixture under the default minsize=2 keeps
        // all three records (as the test above demonstrates implicitly
        // via the populated .log). A stale wiring (e.g. hard-coded
        // --minsize 2) would still let the size-4 records through and
        // leave a non-empty .uchime, so the empty .uchime + the
        // matching "0 unique sequences" line in the stderr log are
        // both sufficient and necessary witnesses that the param
        // reached vsearch.
        tag "ci"
        when {
            params {
                chimera_minsize = 5
            }
            process {
                """
                input[0] = global_clustering.out.representatives
                input[1] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success
            def uchimePath = process.out.uchime.get(0)
            def logPath    = process.out.log.get(0)

            assert path(uchimePath).readLines().isEmpty() :
                "expected an empty .uchime table when minsize filters every record"
            assert path(logPath).text.contains("0 unique sequences") :
                "expected uchime to report 0 unique sequences, got:\n${path(logPath).text}"
        }
    }

    test("a failing first pipe stage fails the task instead of truncating output") {
        // COVERAGE: [S81]
        // [S81]: chimera_detection pipes `vsearch --fastx_filter | vsearch
        // --uchime_denovo`. A non-FASTA `representatives` input makes the
        // left-hand vsearch exit non-zero while emitting nothing, so the
        // right-hand uchime reads an empty stream and exits 0. Without
        // `set -euo pipefail` the task is reported successful with an
        // empty `.uchime` — the silent-truncation failure mode. Under
        // pipefail the left-hand failure propagates and the task fails.
        tag "ci"
        when {
            process {
                """
                def junk = workDir.resolve("not_a_fasta.txt")
                junk.text = "this is not a fasta file at all\\njust random text\\n"
                input[0] = file(junk.toString())
                input[1] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.failed :
                "[S81] a failure in the left-hand vsearch of the pipe must fail the task"
        }
    }
}
