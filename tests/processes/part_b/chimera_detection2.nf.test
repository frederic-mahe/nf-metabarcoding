nextflow_process {

    name "chimera_detection2"
    script "main.nf"
    process "chimera_detection2"

    setup {
        run("global_dereplication") {
            script "main.nf"
            process {
                """
                input[0] = [
                    file("\${projectDir}/tests/data/part_b/S1.fas"),
                    file("\${projectDir}/tests/data/part_b/S2.fas"),
                    file("\${projectDir}/tests/data/part_b/E.fas")
                ]
                input[1] = "proj_3_samples"
                """
            }
        }
        run("global_clustering") {
            script "main.nf"
            process {
                """
                input[0] = global_dereplication.out[0]
                input[1] = "proj_3_samples"
                """
            }
        }
        run("chimera_detection") {
            script "main.nf"
            process {
                """
                input[0] = global_clustering.out[3]
                input[1] = "proj_3_samples"
                """
            }
        }
    }

    test("runs uchime_denovo on cat(pre-cleave, cleaved); empty cleaved → fallback minsize") {
        // COVERAGE: [S37], [S45]
        // We exercise the empty-cleaved branch: the part_b fixture's
        // cleaving step legitimately produces an empty .fas2 (no
        // sub-seeds in the tiny inputs), so the dynamic --minsize
        // must fall back to params.chimera_minsize and the
        // concatenated stream effectively boils down to the
        // pre-cleave representatives.
        //
        // [S45]: the canonical <basename>_chimera_detection.log
        // contains the concatenation of both chimera-detection
        // runs' stderr, each preceded by a section header.
        tag "ci"
        when {
            process {
                """
                def empty_fas2 = workDir.resolve("empty.fas2")
                empty_fas2.text = ""
                input[0] = global_clustering.out[3]
                input[1] = file(empty_fas2.toString())
                input[2] = chimera_detection.out[1]
                input[3] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success
            def uchime2 = process.out[0].get(0)
            def log2    = process.out[1].get(0)
            assert uchime2.endsWith("proj_3_samples_1f_representatives.uchime2")
            // [S45]: the canonical chimera_detection log uses the
            // project-wide naming construct.
            assert log2.endsWith("proj_3_samples_chimera_detection.log")
            assert file(uchime2).exists()

            def log_text = path(log2).text
            assert log_text.contains("=== chimera_detection ===") :
                "canonical log should announce the pre-cleave section, got:\n${log_text}"
            assert log_text.contains("=== chimera_detection2 ===") :
                "canonical log should announce the post-cleave section, got:\n${log_text}"
            // The two section headers must appear in order — pre-cleave
            // first, post-cleave second.
            assert log_text.indexOf("=== chimera_detection ===") <
                   log_text.indexOf("=== chimera_detection2 ===") :
                "section headers must appear in order (pre-cleave before post-cleave)"
        }
    }

    test("non-empty cleaved fas2 drops --minsize to its smallest size") {
        // COVERAGE: [S37]
        // The smallest size in the cleaved fas2 below is 1; since
        // params.chimera_minsize defaults to 2 and the spec says
        // --minsize never drops below it, the effective minsize is
        // 2. The test asserts the run completes (uchime is invoked
        // on the concat) — exact uchime output isn't pinned (it
        // depends on the vsearch version), but the contract is:
        //   non-empty pre-cleave fasta + cleaved fas2 with low-size
        //   records → completes without error.
        tag "ci"
        when {
            process {
                """
                def fas2 = workDir.resolve("cleaved.fas2")
                fas2.text = '''>cleaved_aa;size=1
AAAAAAAAAA
>cleaved_bb;size=3
ACACACACAC
'''
                input[0] = global_clustering.out[3]
                input[1] = file(fas2.toString())
                input[2] = chimera_detection.out[1]
                input[3] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success
            assert file(process.out[0].get(0)).exists()
            assert path(process.out[1].get(0)).readLines().size() > 0
        }
    }
}
