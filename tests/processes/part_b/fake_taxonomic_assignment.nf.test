nextflow_process {

    name "fake_taxonomic_assignment"
    script "modules/local/part_b/fake_taxonomic_assignment.nf"
    process "fake_taxonomic_assignment"

    setup {
        run("global_dereplication") {
            script "modules/local/part_b/global_dereplication.nf"
            process {
                """
                input[0] = [
                    file("\${projectDir}/tests/data/part_b/S1.fas"),
                    file("\${projectDir}/tests/data/part_b/S2.fas"),
                    file("\${projectDir}/tests/data/part_b/E.fas")
                ]
                input[1] = "proj_3_samples"
                """
            }
        }
        run("global_clustering") {
            script "modules/local/part_b/global_clustering.nf"
            process {
                """
                input[0] = global_dereplication.out.fasta
                input[1] = "proj_3_samples"
                """
            }
        }
    }

    test("emits one placeholder row per representative") {
        // COVERAGE: [S33]
        tag "ci"
        when {
            process {
                """
                input[0] = global_clustering.out.representatives
                input[1] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success
            def outPath = process.out.results.get(0)
            assert outPath.endsWith("proj_3_samples_1f_representatives.results") :
                "unexpected output filename: ${outPath}"
            def rows = path(outPath).readLines().collect {
                it.split("\t", -1)
            }
            // The part_b fixture global-dereplicates to 3 records.
            // (A is shared between S1 and S2; B and C are unique.)
            assert rows.size() == 3 :
                "expected 3 rows, got ${rows.size()}: ${rows}"
            rows.each { cols ->
                assert cols.size() == 5 :
                    "expected 5 columns, got ${cols.size()}: ${cols}"
                // Trailing three columns are the placeholder identity/
                // taxonomy/references — overwritten by Part C.
                assert cols[2] == "0.0"
                assert cols[3] == "NA"
                assert cols[4] == "NA"
                // First column is a 40-char SHA1-shaped string.
                assert cols[0].length() == 40 :
                    "column 1 should be a 40-char SHA1, got: ${cols[0]}"
                // Second column is a positive integer (size).
                assert cols[1].isInteger() && cols[1].toInteger() > 0 :
                    "column 2 should be a positive integer, got: ${cols[1]}"
            }
        }
    }
}
