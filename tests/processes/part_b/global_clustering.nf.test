nextflow_process {

    name "global_clustering"
    script "modules/local/part_b/global_clustering.nf"
    process "global_clustering"

    setup {
        run("global_dereplication") {
            script "modules/local/part_b/global_dereplication.nf"
            process {
                """
                input[0] = [
                    file("\${projectDir}/tests/data/part_b/S1.fas"),
                    file("\${projectDir}/tests/data/part_b/S2.fas"),
                    file("\${projectDir}/tests/data/part_b/E.fas")
                ]
                input[1] = "proj_3_samples"
                """
            }
        }
    }

    test("runs swarm --fastidious and emits the four swarm outputs + log") {
        // COVERAGE: [S32]
        tag "ci"
        when {
            params {
                threads = 1
            }
            process {
                """
                input[0] = global_dereplication.out[0]
                input[1] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success

            // The process emits five paths, in order:
            //   swarms, stats, struct, representatives, log
            def swarmsPath = process.out[0].get(0)
            def statsPath  = process.out[1].get(0)
            def structPath = process.out[2].get(0)
            def repPath    = process.out[3].get(0)
            def logPath    = process.out[4].get(0)

            assert swarmsPath.endsWith("proj_3_samples_1f.swarms")
            assert statsPath.endsWith("proj_3_samples_1f.stats")
            assert structPath.endsWith("proj_3_samples_1f.struct")
            assert repPath.endsWith("proj_3_samples_1f_representatives.fas")
            // [S45]: clustering step log uses the project-wide naming.
            assert logPath.endsWith("proj_3_samples_clustering.log")

            // every artefact is non-empty
            [swarmsPath, statsPath, repPath, logPath].each { p ->
                assert path(p).readLines().size() > 0 :
                    "expected ${p} to be non-empty"
            }
            // .struct can be empty for clusters with no internal structure;
            // just assert the file exists.
            assert file(structPath).exists()
        }
    }

    test("--fastidious false drops the flag and swaps the _1f suffix for _1") {
        // COVERAGE: [S32]
        // [S32] propagation lever: params.fastidious (default true) is
        // honored by global_clustering both in the swarm command line
        // and in the published filenames' swarm-parameters suffix.
        tag "ci"
        when {
            params {
                threads    = 1
                fastidious = false
            }
            process {
                """
                input[0] = global_dereplication.out[0]
                input[1] = "proj_3_samples"
                """
            }
        }
        then {
            assert process.success

            def swarmsPath = process.out[0].get(0)
            def statsPath  = process.out[1].get(0)
            def structPath = process.out[2].get(0)
            def repPath    = process.out[3].get(0)
            def logPath    = process.out[4].get(0)

            // _1f → _1 across every swarm output.
            assert swarmsPath.endsWith("proj_3_samples_1.swarms") :
                "expected _1.swarms with --fastidious=false, got: ${swarmsPath}"
            assert statsPath.endsWith("proj_3_samples_1.stats") :
                "expected _1.stats with --fastidious=false, got: ${statsPath}"
            assert structPath.endsWith("proj_3_samples_1.struct") :
                "expected _1.struct with --fastidious=false, got: ${structPath}"
            assert repPath.endsWith("proj_3_samples_1_representatives.fas") :
                "expected _1_representatives.fas with --fastidious=false, got: ${repPath}"
            // [S45] step-log filename is independent of the suffix.
            assert logPath.endsWith("proj_3_samples_clustering.log") :
                "step log name should be suffix-independent, got: ${logPath}"

            // No _1f artefact must have leaked into the work dir.
            [swarmsPath, statsPath, structPath, repPath].each { p ->
                assert !p.contains("_1f.") && !p.contains("_1f_") :
                    "_1f artefact slipped through with --fastidious=false: ${p}"
            }
        }
    }
}
