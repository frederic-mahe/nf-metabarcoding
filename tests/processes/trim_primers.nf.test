nextflow_process {

    name "trim_primers"
    script "main.nf"
    process "trim_primers"

    setup {
        run("merge_fastq_pairs") {
            script "main.nf"
            process {
                """
                input[0] = tuple(
                    "sample_ok",
                    [
                        file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz"),
                        file("\${projectDir}/tests/data/paired_merge_ok_2.fastq.gz")
                    ]
                )
                """
            }
        }
    }

    test("trims forward and reverse primers from merged reads") {
        // COVERAGE: [S01]
        tag "ci"
        when {
            process {
                """
                input[0] = merge_fastq_pairs.out[0]
                input[1] = merge_fastq_pairs.out[1]
                """
            }
        }
        then {
            assert process.success
            // TODO: assert primers absent from the trimmed output
            // TODO: assert read count preserved (or `--max-n 0` discards expected)
        }
    }
}
