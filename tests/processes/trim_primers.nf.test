nextflow_process {

    name "trim_primers"
    script "main.nf"
    process "trim_primers"

    test("trims forward and reverse primers from merged reads") {
        // COVERAGE: per-process; relies on the fixed merged_fastq
        // produced by merge_fastq_pairs from paired_merge_ok.
        when {
            process {
                """
                // input[0] = sampleId, input[1] = merged fastq path
                input[0] = "sample_ok"
                input[1] = file("\${projectDir}/tests/data/paired_merge_ok_1.fastq.gz")
                // NOTE: using the raw R1 as a placeholder until a true merged
                // fixture is committed or produced by a setup{} block.
                """
            }
        }
        then {
            assert process.success
            // TODO: assert primers absent from the trimmed output
            // TODO: assert read count preserved (or `--max-n 0` discards expected)
        }
    }
}
