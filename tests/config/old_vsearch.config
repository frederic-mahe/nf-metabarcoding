// [S136] tests/main.nf.test: put a fake vsearch reporting version
// 2.31.0 first on every task's PATH. The test's setup block writes the
// fake script into the (git-ignored) nf-test work directory. The
// escaped \$PATH is expanded by the task shell, not by Nextflow.
env {
    PATH = "${projectDir}/.nf-test/fake_old_vsearch:\$PATH"
}
