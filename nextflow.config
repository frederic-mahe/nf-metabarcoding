manifest {
    name            = "Fred's metabarcoding pipeline"
    author          = "Frédéric Mahé"
    homePage        = 'https://github.com/frederic-mahe/fred-metabarcoding-pipeline-nextflow'
    description     = """Metabarcoding: swarm-based ASV inference"""
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version         = '0.0.1'
}

cleanup = true

// [S07]: task.cpus is the single source of truth for the per-process
// thread count (vsearch/swarm/cutadapt `--threads`/`--cores`). Default
// it to params.threads so a plain `nextflow run` keeps the historical
// behaviour (4 threads, or whatever --threads sets); the `slurm`
// profile overrides cpus per process so the scheduler reservation and
// the tool's real thread use agree. The closure is resolved per task,
// after params.threads picks up its main.nf default.
process {
    cpus = { params.threads }
}

profiles {
    test {
        // nf-test reads output files (e.g. `path(out).readLines()`);
        // disable cleanup so the work dir survives until assertions run.
        cleanup = false
    }
    local {
        // [S49]: a single workstation has no scheduler to keep
        // busy, so the stampa scatter has no upside — feed the
        // full representatives fasta into a single vsearch
        // invocation. 0 is the "no split" sentinel read by
        // workflow part_C.
        params.stampa_chunk_size = 0
    }

    // [S07]: HPC deployment. Combine with a dependency profile, e.g.
    //   nextflow run main.nf -profile slurm,conda    ...
    //   nextflow run main.nf -profile slurm,modules  ...
    // Submission/queue knobs are exposed as params so a site can tune
    // them without editing this file (--slurm_queue, --slurm_account,
    // --slurm_queue_size). Per-process resources escalate with
    // task.attempt so an OOM/timeout kill is retried with more memory
    // and wall-time before giving up.
    slurm {
        params.slurm_queue        = null   // sbatch -p / --partition
        params.slurm_account      = null   // sbatch -A / --account
        params.slurm_queue_size   = 100    // max concurrent sbatch jobs
        // Approximate input dataset size in GB. Every memory-bound
        // step scales its request off this: most need ~1x the dataset
        // size in RAM, swarm fastidious global clustering needs ~3x
        // (the single most memory-hungry step). Leave null to use the
        // fixed fallbacks noted on each tier, then escalated on retry.
        params.dataset_size_gb    = null

        process {
            executor       = 'slurm'
            queue          = params.slurm_queue
            clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : null }

            // Default tier: single-threaded glue — bash/awk and the
            // python helpers, the single-threaded mumu binary, and the
            // single-threaded vsearch passes (--fastq_join, --fastq_filter,
            // --fastx_uniques, --fastx_filter) that do not take a thread
            // count. One core, modest memory.
            cpus          = 1
            memory        = { 4.GB * task.attempt }
            time          = { 30.min * task.attempt }
            errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
            maxRetries    = 2

            // Medium tier: multi-threaded vsearch/swarm/cutadapt steps
            // that scale with cores but are not memory hogs. Includes
            // the stampa scatter (assign_taxonomy_stampa): each job
            // processes a fixed-size chunk, so its memory is bounded by
            // the chunk, not the whole dataset.
            withName: 'merge_fastq_pairs|trim_primers|list_local_clusters|search_for_terminal_gaps|assign_taxonomy_stampa' {
                cpus   = { params.threads }
                memory = { 8.GB * task.attempt }
                time   = { 2.h * task.attempt }
            }

            // Top tier: vsearch all-vs-all self-search is fully
            // multi-threaded — give it the whole core allocation. Memory
            // grows with the dataset (~1x), fallback 32 GB.
            withName: 'find_similar_sequences' {
                cpus   = { params.threads }
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * task.attempt) as int} GB"
                           : 32.GB * task.attempt }
                time   = { 8.h * task.attempt }
            }

            // vsearch chimera detection runs as a two-stage pipe
            // (filtering | uchime_denovo), so it tops out at two
            // threads no matter how high params.threads goes — reserve
            // exactly two cores. Memory grows with the dataset (~1x),
            // fallback 32 GB. `chimera_detection` also matches
            // `chimera_detection_post_cleave`.
            withName: 'chimera_detection' {
                cpus   = 2
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * task.attempt) as int} GB"
                           : 32.GB * task.attempt }
                time   = { 8.h * task.attempt }
            }

            // Single-threaded but dataset-bound in memory (~1x), fallback
            // 16 GB: vsearch global dereplication (--fastx_uniques holds
            // the full set in a hash), build_occurrence_table and the
            // single-threaded mumu pass both load a whole-study table.
            withName: 'global_dereplication|build_occurrence_table|run_mumu' {
                cpus   = 1
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * task.attempt) as int} GB"
                           : 16.GB * task.attempt }
                time   = { 4.h * task.attempt }
            }

            // Multi-threaded and dataset-bound in memory (~1x), fallback
            // 16 GB: vsearch --sintax classifies the whole representative
            // set in a single pass.
            withName: 'assign_taxonomy_sintax' {
                cpus   = { params.threads }
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * task.attempt) as int} GB"
                           : 16.GB * task.attempt }
                time   = { 2.h * task.attempt }
            }

            // Memory-bound: swarm fastidious global clustering needs
            // roughly 3x the dataset size in RAM — the single most
            // memory-hungry step. Scale off --dataset_size_gb when
            // provided, otherwise fall back to 64 GB.
            withName: 'global_clustering' {
                cpus   = { params.threads }
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * 3 * task.attempt) as int} GB"
                           : 64.GB * task.attempt }
                time   = { 8.h * task.attempt }
            }
        }

        executor {
            queueSize       = params.slurm_queue_size
            submitRateLimit = '10/1min'
            pollInterval    = '30 sec'
        }
    }

    // [S08]: resolve swarm/vsearch/cutadapt/mumu from bioconda. Pinned
    // versions live in environment.yml. Nextflow builds the env once
    // and caches it under $NXF_CONDA_CACHEDIR (set this to shared
    // storage on the cluster so compute nodes reuse the same prefix).
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    // [S08]: resolve the four tools from the cluster's module system
    // instead. Module names/versions are site-specific, so they are
    // params with empty defaults — set them in a -params-file or on the
    // command line (e.g. --module_vsearch vsearch/2.28.1). An empty
    // value means "already on PATH", so the directive is omitted.
    modules {
        params.module_vsearch  = null
        params.module_swarm    = null
        params.module_cutadapt = null
        params.module_mumu     = null

        process {
            withName: 'merge_fastq_pairs|strip_reads|join_notmerged|filter_and_convert_to_fasta|dereplicate_fasta|global_dereplication|chimera_detection|search_for_terminal_gaps|find_similar_sequences|assign_taxonomy_stampa|assign_taxonomy_sintax' {
                module = { params.module_vsearch ?: null }
            }
            withName: 'list_local_clusters|global_clustering' {
                module = { params.module_swarm ?: null }
            }
            withName: 'trim_primers' {
                module = { params.module_cutadapt ?: null }
            }
            withName: 'run_mumu' {
                module = { params.module_mumu ?: null }
            }
        }
    }
}
