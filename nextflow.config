manifest {
    name            = "Fred's metabarcoding pipeline"
    author          = "Frédéric Mahé"
    homePage        = 'https://github.com/frederic-mahe/fred-metabarcoding-pipeline-nextflow'
    description     = """Metabarcoding: swarm-based ASV inference"""
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version         = '0.1.0'
}

cleanup = true

// Pipeline parameter defaults. Centralised here so every entry point
// — a plain `nextflow run`, a -params-file, and standalone nf-test
// process/subworkflow tests (which load this config but not main.nf) —
// sees the same baseline. CLI flags and -params-file still override.
params {
    // [S57]: --help short-circuits the workflow before any required-param
    // assertion fires, so users can discover the interface without first
    // having to supply a mode-specific flag.
    help = false

    // [S58]: publishDir mode applied to every publishDir directive in the
    // workflow. Default 'link' (fast hard link) preserves prior behaviour
    // on same-filesystem layouts; switch to 'copy' when --fastq_folder or
    // --results_folder is on a different filesystem than the work dir
    // (hard links cannot cross devices).
    publish_mode = 'link'

    // [S70]: primary validated input. A header-keyed samplesheet CSV
    // (fastq profile → Part A, fasta profile → Part B), mutually
    // exclusive with the folder-scan inputs (--fastq_folder /
    // --fasta_folder). Null → fall back to folder scanning.
    input = null

    // optional (project defaults)
    // No leading '/': it was a vestige of the old fromFilePairs path
    // (pattern concatenated onto the folder). discover_fastq.py still
    // strips a leading '/' for back-compat, but the shipped default is
    // a plain basename glob so --help shows a copyable value ([S11]).
    fastq_pattern = "*_1_{1,2}.fastq.gz"
    fastq_encoding = 33
    threads = 4
    no_trimming = false
    // [S78] master switch for the experimental shadow pipeline ([S04]):
    // recovering unmergeable read pairs by A-padded joining. Off by
    // default — when false the not-merged reads are dropped, no
    // `_notmerged` artefacts are produced, and part_B_shadow /
    // part_C_shadow are never invoked. Set true to opt in (the joined
    // reads carry artificial A-padding, not biological sequence — see
    // [S04]). The `stripright` / `join_padding_length` knobs below only
    // take effect when this is true.
    recover_unmerged = false
    // [S24] number of nucleotides stripped from the 3' end of each
    // not-merged R1/R2 read before they are joined (shadow pipeline).
    // Set to 0 to disable.
    stripright = 30
    // [S63] length (in nt) of the run of `A`s that vsearch --fastq_join
    // inserts between R1 and R2 in the shadow Part A path ([S04]). The
    // same length is used for the matching --join_padgapq Phred-40 ('I')
    // quality string. Increase to make the artificial join site more
    // visible to a human reader at the cost of slightly larger fastas.
    join_padding_length = 8

    // [S65] hash vsearch uses to rename amplicons in
    // filter_and_convert_to_fasta (--relabel_sha1 / --relabel_md5).
    // 'sha1' (default) or 'md5'; validated at workflow startup. The .qual
    // dedup steps derive their uniq --check-chars width from this so no
    // step assumes a fixed hash-string length.
    hash_function = 'sha1'

    // Part B parameters — required only when Part B runs.
    // [S25] / [S26] / [S27]: setting --fasta_folder switches the
    // workflow into Part B standalone mode; --project_name and
    // --results_folder become required, and Part A is skipped.
    fasta_folder    = null
    project_name    = null
    // [S71]: --outdir is the single root for all published outputs
    // (<outdir>/{per_sample,occurrence_table,pipeline_info}/). Default
    // null → resolve_outdir() falls back to the deprecated
    // --results_folder alias, then to 'results'.
    outdir          = null
    results_folder  = null
    // [S34]: minimum size threshold for chimera detection
    // (vsearch --fastx_filter --minsize). Records below this size are
    // dropped before uchime_denovo runs.
    chimera_minsize = 2
    // [S22]/[S32]: propagation lever for the swarm --fastidious flag.
    // When true (default), global_clustering's swarm and cleaving's
    // cluster_cleaver.py both run fastidious and every artefact carries
    // the `_1f` suffix; when false, both processes drop the flag and the
    // suffix swaps to `_1`. Exposed for very large datasets where the
    // fastidious pass is too expensive.
    fastidious = true
    // [S22] cleaving threshold (the legacy "keystone" parameter): a
    // sub-seed candidate is kept only if it appears as a per-sample
    // cluster seed in at least this fraction of samples. Default 0.05
    // (5 %, the legacy value). Validated as a real in (0, 1] at startup
    // ([S72]).
    percentage = 0.05

    // Part C parameters — required only when Part C runs.
    // [S47]: path to a reference dataset (fasta, plain / .gz / .bz2).
    // [S48]: occurrence table input (Part C standalone). When Parts B
    // and C run end-to-end the Part C workflow consumes Part B's
    // <basename>_table.tsv directly and this stays null.
    // [S49] / [S50]: 'stampa' (default) drives the primary path,
    // 'sintax' switches to the shadow path.
    // [S49]: identity-definition flag passed to vsearch (iddef).
    // [S49]: chunk size for the stampa scatter-gather. Each chunk of
    // this many sequences runs vsearch + stampa_merge.py as a
    // separate process. The default (1000) is slurm-tuned; the
    // `local` profile in nextflow.config overrides this to 0
    // (sentinel: bypass splitFasta and feed the whole fasta into
    // one task).
    // [S47]/[S64]: two reference flags, one per assignment method.
    // `--reference_dataset` carries the stampa-formatted file (header
    // `>id space-separated lineage`); consumed by the regular path when
    // taxonomy_method='stampa' (default). `--reference_dataset_sintax`
    // carries the sintax-formatted file (header `>id;tax=d:...,p:...;`);
    // consumed by `part_C_shadow` (always sintax) and by the regular
    // path when taxonomy_method='sintax'. The split is a stop-gap until
    // a single multi-format reference loader lands — until then, the
    // two formats differ in incompatible ways and a single file cannot
    // satisfy both methods in production use.
    reference_dataset        = null
    reference_dataset_sintax = null
    occurrence_table  = null
    taxonomy_method   = 'stampa'
    iddef             = 1
    stampa_chunk_size = 1000
    // [S49]: vsearch knobs exposed for the stampa scatter step.
    // stampa_maxrejects=0 is vsearch's "no limit" sentinel — exhaustive
    // search, slower but every reference seq is considered as a potential
    // top hit. stampa_id is the --id threshold below which a hit is
    // dropped (stampa_merge.py then emits "No_hit" for the amplicon).
    stampa_maxrejects = 0
    stampa_id         = 0.5
    // [S50]: --sintax_cutoff threshold for vsearch's sintax classifier.
    // Used by the shadow Part C path (always) and by the regular Part C
    // path when params.taxonomy_method == 'sintax'.
    sintax_cutoff     = 0.9
    // [S66]: opt-in majority-rule taxonomic assignment. When true, the
    // regular Part C path runs `compute_majority_assignment` as a final
    // step on <basename>_table_assigned.tsv ([S51]) and publishes an
    // independent <basename>_table_assigned_majority.tsv. Requires the
    // stampa method — sintax leaves the `references` column at the NA
    // placeholder ([S50]), so the workflow forbids the combination at
    // startup. Never runs on the shadow path.
    majority_assignment = false
}

// [S07]: task.cpus is the single source of truth for the per-process
// thread count (vsearch/swarm/cutadapt `--threads`/`--cores`). Default
// it to params.threads so a plain `nextflow run` keeps the historical
// behaviour (4 threads, or whatever --threads sets); the `slurm`
// profile overrides cpus per process so the scheduler reservation and
// the tool's real thread use agree. The closure is resolved per task,
// after params.threads picks up its default from the params block above.
process {
    cpus = { params.threads }
}

profiles {
    test {
        // nf-test reads output files (e.g. `path(out).readLines()`);
        // disable cleanup so the work dir survives until assertions run.
        cleanup = false
    }
    local {
        // [S49]: a single workstation has no scheduler to keep
        // busy, so the stampa scatter has no upside — feed the
        // full representatives fasta into a single vsearch
        // invocation. 0 is the "no split" sentinel read by
        // workflow part_C.
        params.stampa_chunk_size = 0
    }

    // [S08]/D10: containerised execution. Four engine profiles —
    // docker / podman / singularity / apptainer — each enable their
    // engine plus Seqera Wave, which builds the image on the fly from
    // environment.yml (the single pinned source of truth, [S69]) and
    // caches it. No Dockerfile and no registry to maintain: the same
    // dependency declaration that drives `-profile conda` also drives
    // the container build (D10, "Wave, no freeze"). Combine with the
    // executor, e.g. `-profile slurm,singularity`. Wave needs outbound
    // network from wherever tasks run (login + compute nodes).
    //
    // `wave.enabled` + `conda.enabled` + a container engine is the
    // supported Wave-from-conda combination: Nextflow routes the conda
    // packages into a Wave-built container instead of creating a local
    // conda env (so this does NOT collide with the `conda` profile's
    // env-build path; pick one). These settings live inside the
    // profiles, never at top level, so a plain `nextflow run` stays
    // bare-PATH by default.
    docker {
        docker.enabled = true
        wave.enabled   = true
        conda.enabled  = true
        process.conda  = "${projectDir}/environment.yml"
    }
    podman {
        podman.enabled = true
        wave.enabled   = true
        conda.enabled  = true
        process.conda  = "${projectDir}/environment.yml"
    }
    singularity {
        // autoMounts so the work dir and input paths on the host are
        // visible inside the container without manual --bind flags.
        singularity.enabled    = true
        singularity.autoMounts = true
        wave.enabled           = true
        conda.enabled          = true
        process.conda          = "${projectDir}/environment.yml"
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        wave.enabled         = true
        conda.enabled        = true
        process.conda        = "${projectDir}/environment.yml"
    }

    // [S76]: self-contained smoke test. Points every required parameter
    // at the committed demo dataset (assets/demo/, built by
    // assets/demo/make_demo.sh) so `nextflow run main.nf -profile demo`
    // runs the whole pipeline (Part A -> B -> C) with no fixture
    // generation and no other flags. Combine with an engine to validate
    // a site's container setup in one command, e.g.
    // `nextflow run main.nf -profile demo,singularity`. The synthetic
    // reads are tiny and not biologically meaningful — this checks that
    // the tools, the wiring, and the environment work end to end.
    demo {
        params.fastq_folder      = "${projectDir}/assets/demo"
        params.fastq_pattern     = ''        // use the canonical pattern table
        params.forward_primer    = 'CCAGCASCYGCGGTAATTCC'
        params.reverse_primer    = 'ACTTTCGTTCTTGATYRA'
        params.project_name      = 'demo'    // run Part B
        params.reference_dataset = "${projectDir}/assets/demo/reference.fasta"  // run Part C (stampa)
        params.stampa_chunk_size = 0         // no scatter on a single host ([S49])
        params.threads           = 1
        params.outdir            = 'demo_results'
    }

    // [S07]: HPC deployment. Combine with a dependency profile, e.g.
    //   nextflow run main.nf -profile slurm,conda    ...
    //   nextflow run main.nf -profile slurm,modules  ...
    // Submission/queue knobs are exposed as params so a site can tune
    // them without editing this file (--slurm_queue, --slurm_account,
    // --slurm_queue_size). Per-process resources escalate with
    // task.attempt so an OOM/timeout kill is retried with more memory
    // and wall-time before giving up.
    slurm {
        params.slurm_queue        = null   // sbatch -p / --partition
        params.slurm_account      = null   // sbatch -A / --account
        // [S75]: extra sbatch options appended verbatim to every job's
        // submit line (QoS, constraints, reservations, ...) — combined
        // with --account in the clusterOptions closure below. The single
        // knob a site needs for cluster-specific submission flags it
        // can't express through --slurm_account/--slurm_queue. Set it in
        // a `-c site.config` (see conf/site.config.example) or on the CLI.
        params.slurm_clusterOptions = null
        params.slurm_queue_size   = 100    // max concurrent sbatch jobs
        // Approximate input dataset size in GB. The clustering /
        // chimera / mumu / table steps scale their RAM off this: most
        // need ~1x, swarm fastidious global clustering needs ~3x (the
        // single most memory-hungry step). Leave null to use the fixed
        // fallbacks noted on each tier, then escalated on retry.
        params.dataset_size_gb    = null
        // Approximate reference-database size in GB. The taxonomic
        // assignment steps (vsearch --usearch_global / --sintax) load
        // the reference into RAM and build a k-mer index that inflates
        // it several-fold, so they scale off this rather than the
        // dataset size. The ~4x factor below covers that inflation.
        params.reference_size_gb  = null

        // [S07]: resource ceiling. The per-tier memory/time below
        // escalate with task.attempt on retry (e.g. global_clustering
        // asks 64.GB * attempt). Without a cap, a step on a too-small
        // partition keeps requesting more than any node offers and
        // loops to failure instead of failing fast. resourceLimits
        // (native Nextflow >= 24.04) clamps every request to the
        // largest node a site offers. Override per-site with
        // --max_cpus / --max_memory / --max_time (memory/time as
        // quoted Nextflow units, e.g. --max_memory '256.GB').
        params.max_cpus   = 16
        params.max_memory = 128.GB
        params.max_time   = 240.h

        process {
            executor       = 'slurm'
            queue          = params.slurm_queue
            // [S75]: combine the optional --account with any site-supplied
            // extra options (params.slurm_clusterOptions: QoS, constraints,
            // reservations). Either, both, or neither may be set; the
            // closure yields null when neither is, so the directive is
            // omitted entirely.
            clusterOptions = {
                [ params.slurm_account ? "--account=${params.slurm_account}" : null,
                  params.slurm_clusterOptions ?: null
                ].findAll().join(' ') ?: null
            }
            resourceLimits = [
                cpus  : params.max_cpus,
                memory: params.max_memory,
                time  : params.max_time
            ]

            // Default tier: single-threaded glue — bash/awk and the
            // python helpers, the single-threaded mumu binary, and the
            // single-threaded vsearch passes (--fastq_join, --fastq_filter,
            // --fastx_uniques, --fastx_filter) that do not take a thread
            // count. One core, modest memory.
            cpus          = 1
            memory        = { 4.GB * task.attempt }
            time          = { 30.min * task.attempt }
            errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
            maxRetries    = 2

            // Medium tier: multi-threaded vsearch/swarm/cutadapt steps
            // that scale with cores but are not memory hogs.
            withName: 'merge_fastq_pairs|trim_primers|list_local_clusters|search_for_terminal_gaps' {
                cpus   = { params.threads }
                memory = { 8.GB * task.attempt }
                time   = { 2.h * task.attempt }
            }

            // Top tier: vsearch all-vs-all self-search is fully
            // multi-threaded — give it the whole core allocation. Memory
            // grows with the dataset (~1x), fallback 32 GB.
            withName: 'find_similar_sequences' {
                cpus   = { params.threads }
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * task.attempt) as int} GB"
                           : 32.GB * task.attempt }
                time   = { 8.h * task.attempt }
            }

            // vsearch chimera detection runs as a two-stage pipe
            // (filtering | uchime_denovo), so it tops out at two
            // threads no matter how high params.threads goes — reserve
            // exactly two cores. Memory grows with the dataset (~1x),
            // fallback 32 GB. `chimera_detection` also matches
            // `chimera_detection_post_cleave`.
            withName: 'chimera_detection' {
                cpus   = 2
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * task.attempt) as int} GB"
                           : 32.GB * task.attempt }
                time   = { 8.h * task.attempt }
            }

            // Single-threaded but dataset-bound in memory (~1x), fallback
            // 16 GB: vsearch global dereplication (--fastx_uniques holds
            // the full set in a hash), build_occurrence_table and the
            // single-threaded mumu pass both load a whole-study table.
            withName: 'global_dereplication|build_occurrence_table|run_mumu' {
                cpus   = 1
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * task.attempt) as int} GB"
                           : 16.GB * task.attempt }
                time   = { 4.h * task.attempt }
            }

            // Multi-threaded and reference-database-bound in memory:
            // vsearch loads the reference and builds a k-mer index
            // (~4x the reference size). Both the stampa scatter (each
            // job loads the full reference regardless of chunk size)
            // and the single-pass sintax classifier scale off
            // --reference_size_gb, fallback 8 GB.
            withName: 'assign_taxonomy_stampa|assign_taxonomy_sintax' {
                cpus   = { params.threads }
                memory = { params.reference_size_gb
                           ? "${(params.reference_size_gb * 4 * task.attempt) as int} GB"
                           : 8.GB * task.attempt }
                time   = { 2.h * task.attempt }
            }

            // Memory-bound: swarm fastidious global clustering needs
            // roughly 3x the dataset size in RAM — the single most
            // memory-hungry step. Scale off --dataset_size_gb when
            // provided, otherwise fall back to 64 GB.
            withName: 'global_clustering' {
                cpus   = { params.threads }
                memory = { params.dataset_size_gb
                           ? "${(params.dataset_size_gb * 3 * task.attempt) as int} GB"
                           : 64.GB * task.attempt }
                time   = { 8.h * task.attempt }
            }
        }

        executor {
            queueSize       = params.slurm_queue_size
            submitRateLimit = '10/1min'
            pollInterval    = '30 sec'
        }
    }

    // [S08]: resolve swarm/vsearch/cutadapt/mumu from bioconda. Pinned
    // versions live in environment.yml. Nextflow builds the env once
    // and caches it under $NXF_CONDA_CACHEDIR (set this to shared
    // storage on the cluster so compute nodes reuse the same prefix).
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    // [S08]: resolve the four tools from the cluster's module system
    // instead. Module names/versions are site-specific, so they are
    // params with empty defaults — set them in a -params-file or on the
    // command line (e.g. --module_vsearch vsearch/2.28.1). An empty
    // value means "already on PATH", so the directive is omitted.
    modules {
        params.module_vsearch  = null
        params.module_swarm    = null
        params.module_cutadapt = null
        params.module_mumu     = null

        process {
            withName: 'merge_fastq_pairs|strip_reads|join_notmerged|filter_and_convert_to_fasta|dereplicate_fasta|global_dereplication|chimera_detection|search_for_terminal_gaps|find_similar_sequences|assign_taxonomy_stampa|assign_taxonomy_sintax' {
                module = { params.module_vsearch ?: null }
            }
            withName: 'list_local_clusters|global_clustering' {
                module = { params.module_swarm ?: null }
            }
            withName: 'trim_primers' {
                module = { params.module_cutadapt ?: null }
            }
            withName: 'run_mumu' {
                module = { params.module_mumu ?: null }
            }
        }
    }
}
