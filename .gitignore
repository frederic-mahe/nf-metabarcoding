*~
.nextflow.log*
.nextflow/
.nf-test/
.nf-test-*.nf

# nextflow run outputs: the work directory and the default --outdir
# locations ('results', plus 'demo_results' from `-profile demo`).
# These are generated artefacts of an in-repo run, never committed.
work/
results/
demo_results/
tests/data/*.fastq
tests/data/*.fastq.gz
tests/data/*.fastq.bz2
tests/data/*.fq
tests/data/*.fq.gz
tests/data/**/*.fastq
tests/data/**/*.fastq.gz
tests/data/**/*.fastq.bz2
tests/data/**/*.fq
tests/data/**/*.fq.gz
# pipeline artefacts left in tests/data by workflow-level nf-test runs
tests/data/*.log
tests/data/*.fas
tests/data/*.fas2
tests/data/*.qual
tests/data/*.stats
tests/data/**/*.log
tests/data/**/*.fas
tests/data/**/*.fas2
tests/data/**/*.qual
tests/data/**/*.stats
.nf-test.log

# python
__pycache__/
*.py[cod]
.pytest_cache/
